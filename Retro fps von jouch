    const scope = Math.round(weapon.scopeEase * 20) / 20;
    if (scope !== this._scopeOpacity) {
      this._scopeOpacity = scope;
      this.scope.style.opacity = String(scope);
    }
    const left = grenades.cooldown;
    const text = left <= 0 ? (this.input.overlay ? '' : '[E] ') + 'GRENADE READY' : 'GRENADE ' + Math.ceil(left) + 's';
