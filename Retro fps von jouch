/** Small helpers for building a gun from boxes and cylinders. */
function gunBuilders(root) {
  const box = (mat, w, h, d, x, y, z, rx, parent) => {
    const mesh = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), mat);
    mesh.position.set(x, y, z);
    if (rx) mesh.rotation.x = rx;
    (parent || root).add(mesh);
    return mesh;
  };
  const tube = (mat, radius, length, x, y, z, segments) => {
    const geometry = new THREE.CylinderGeometry(radius, radius, length, segments || 10, 1);
    geometry.rotateX(Math.PI / 2);
    const mesh = new THREE.Mesh(geometry, mat);
    mesh.position.set(x, y, z);
    root.add(mesh);
    return mesh;
  };
  return { box, tube };
}

/** Sight line (model-local height and rear-sight z) per gun; the specs use these to place the aim pose. */
const SMG_SIGHT = { y: 0.055, z: 0.0 };
