    this.materials.dirt = tint(textures.floor, 0xb89a6e);
    this.materials.asphalt = tint(textures.floor, 0x5c5d63);
    this.materials.olive = tint(textures.panel, 0x6c7658);
    this.materials.rust = tint(textures.panel, 0xa56a4a);

    this._geometries = new Map();
    this._barrelGeometry = null;

    this._buildLighting();
    const builders = [
      ['hall', this._buildHall], ['corridor', this._buildCorridor], ['east', this._buildEastRoom],
      ['warehouse', this._buildWarehouse], ['control', this._buildControlRoom], ['pump', this._buildPumpRoom],
      ['dock', this._buildDock], ['boiler', this._buildBoiler], ['garage', this._buildGarage], ['crash', this._buildCrash],
      ['plugs', this._buildPlugs],
    ];
    for (const [name, build] of builders) {
      if (name !== 'plugs') this._begin(name);
      build.call(this);
    }
    this._room = null;
    this.setSize(size || 'middle');
  }

  /** Switch the map: shows the rooms of that size and closes the doorways to the others. */
  setSize(size) {
    if (!ROOMS_BY_SIZE[size]) size = 'middle';
    this.size = size;
    const on = new Set(ROOMS_BY_SIZE[size]);
    this.activeRooms = new Set(ROOMS_BY_SIZE[size].filter((r) => !r.startsWith('plug')));
    const boxes = this.collision.boxes;
    this.barrels.length = 0;
    for (const name of Object.keys(this.rooms)) {
      const room = this.rooms[name];
      const active = on.has(name);
      room.group.visible = active;
      for (const b of room.boxes) {
        const k = boxes.indexOf(b);
        if (active && k < 0) boxes.push(b);
        else if (!active && k >= 0) boxes.splice(k, 1);
      }
      for (const br of room.barrels) {
        const k = boxes.indexOf(br.box);
        if (active) {
          br.alive = true; br.fused = false; br.respawn = 0; br.mesh.visible = true;
          if (k < 0) boxes.push(br.box);
          this.barrels.push(br);
        } else {
          br.alive = false;
          if (k >= 0) boxes.splice(k, 1);
        }
      }
    }
    // Sky and fog: bright outdoors on Crash, dark inside the facility.
    const outdoor = size === 'crash';
    this.outdoor = outdoor;
    this.scene.background = new THREE.Color(outdoor ? 0x9ec3e6 : CLEAR_COLOR);
    this.scene.fog.color.setHex(outdoor ? 0xb9d2ea : CLEAR_COLOR);
    if (this.onFog) this.onFog(outdoor);
    if (this.hemi) {
      this.hemi.intensity = outdoor ? 3.3 : 2.6;
      this.hemi.color.set(outdoor ? 0xcfe0f5 : 0x7a7a82);
      this.hemi.groundColor.set(outdoor ? 0x8a7b62 : 0x3a3a38);
    }
    this.spawnPoints.length = 0;
    for (const sp of ALL_SPAWNS) if (this.activeRooms.has(sp.room)) this.spawnPoints.push({ x: sp.x, y: sp.y, z: sp.z, yaw: sp.yaw });
    this.spawn.x = 0; this.spawn.y = 0; this.spawn.z = 7.5; this.spawn.yaw = 0;
    return size;
  }

  _begin(name) {
    const group = new THREE.Group();
    this.scene.add(group);
    this._room = { group, boxes: [], barrels: [] };
    this.rooms[name] = this._room;
  }

