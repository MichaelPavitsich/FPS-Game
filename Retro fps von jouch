  oneShotHead: { min: 0, max: 1 },
  difficulty: { min: 0, max: 2 },
  viewBob: { min: 0, max: 1 },
  screenShake: { min: 0, max: 1 },
};

function createDefaults() {
  const coarse = typeof matchMedia === 'function' && matchMedia('(pointer: coarse)').matches;
  return {
    sensitivity: 1,
    adsSensitivity: 1,
    wheelAimSens: 0,
    touchSensitivity: 1,
    fov: 80,
    // Touch devices start at a lower internal resolution.
    renderScale: coarse ? 0.75 : 1,
    renderDistance: 55,
    volume: 0.8,
    showFps: 1,
    invertY: 0,
    autoSprint: 0,
    sprintLock: 1,
    holdAim: 0,
    fixedStick: 0,
    leftFire: 1,
    buttonSize: 1,
    buttonOpacity: 0.8,
    crosshairSize: 3,
    enemyCount: 6,
    fillBots: 1,
    oneShotHead: 1,
    difficulty: 1,
    viewBob: 1,
    screenShake: 1,
  };
}

function clamp(key, value) {
  const { min, max } = LIMITS[key];
  return Math.min(max, Math.max(min, value));
}

/** User-adjustable settings, persisted in localStorage. */
class Settings {
  constructor() {
    this.values = createDefaults();
    this._listeners = new Set();
    this._load();
  }

  get(key) {
    return this.values[key];
  }

  set(key, value) {
    if (!(key in LIMITS) || typeof value !== 'number' || Number.isNaN(value)) return;
    const next = clamp(key, value);
    if (next === this.values[key]) return;
    this.values[key] = next;
    this._save();
    for (const listener of this._listeners) listener(key, next);
  }

  /** Back to the defaults; every listener hears about every key. */
  reset() {
    this.values = createDefaults();
    this._save();
    for (const key of Object.keys(LIMITS)) {
      for (const listener of this._listeners) listener(key, this.values[key]);
    }
  }

  /** Subscribe to changes. Returns an unsubscribe function. */
  onChange(listener) {
    this._listeners.add(listener);
    return () => this._listeners.delete(listener);
  }

  _load() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      const saved = JSON.parse(raw);
      for (const key of Object.keys(LIMITS)) {
        if (typeof saved[key] === 'number' && !Number.isNaN(saved[key])) {
          this.values[key] = clamp(key, saved[key]);
        }
      }
    } catch (_) {
      /* storage unavailable or corrupt: keep defaults */
    }
  }

  _save() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(this.values));
    } catch (_) {
      /* ignore */
    }
  }
}

// ===== js/engine/Engine.js =====
const CLEAR_COLOR = 0x101012;

/**
 * Owns the renderer, scene, camera and main loop.
 * No post-processing, no shadows, no custom shaders.
 */
class Engine {
  constructor(canvas, settings) {
    this.settings = settings;

    this.renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: false,
      alpha: false,
      stencil: false,
      powerPreference: 'high-performance',
    });
    this.renderer.setClearColor(CLEAR_COLOR, 1);

    this.scene = new THREE.Scene();
    this.scene.background = new THREE.Color(CLEAR_COLOR);
    this.scene.fog = new THREE.Fog(CLEAR_COLOR, 4, 55);

    this.camera = new THREE.PerspectiveCamera(settings.get('fov'), 1, 0.05, 90);
    this._applyDistance();
    // Yaw first, then pitch: the standard FPS camera rotation order.
    this.camera.rotation.order = 'YXZ';

    // The weapon is drawn in a second pass with its own scene and camera, so
    // it never clips into walls and keeps its look when the FOV changes.
    this.viewScene = new THREE.Scene();
    this.viewCamera = new THREE.PerspectiveCamera(55, 1, 0.01, 5);
    this.viewScene.add(new THREE.HemisphereLight(0xcfd2d8, 0x555555, 2.4));
    const sun = new THREE.DirectionalLight(0xfff2dd, 1.8);
    sun.position.set(0.6, 1, 0.8);
    this.viewScene.add(sun);

    this._update = null;
    this._running = false;
    this._last = 0;
    this._tick = this._tick.bind(this);

    window.addEventListener('resize', () => this.resize());
    settings.onChange((key, value) => {
      if (key === 'fov') {
        this.camera.fov = value;
        this.camera.updateProjectionMatrix();
      } else if (key === 'renderScale') {
        this.resize();
      } else if (key === 'renderDistance') {
        this._applyDistance();
      }
    });

    this.resize();
  }

  /** Render distance: where the fog is fully opaque; the camera sees a bit past it. */
  _applyDistance() {
    // The outdoor map is open: twice the distance there.
    const d = this.settings.get('renderDistance') * (this.outdoor ? 2.2 : 1);
    this.scene.fog.near = Math.min(4 + d * 0.1, d * 0.5);
    this.scene.fog.far = d;
    this.camera.far = d + 35;
    this.camera.updateProjectionMatrix();
  }

  /** Match the canvas to the window, applying the render scale. */
  resize() {
    const width = Math.max(1, window.innerWidth);
    const height = Math.max(1, window.innerHeight);
    // Never render above CSS-pixel resolution: it keeps the look chunky and
    // spares high-DPI phones. The render scale lowers it further.
    const pixelRatio = Math.min(window.devicePixelRatio || 1, 1) * this.settings.get('renderScale');
    this.renderer.setPixelRatio(pixelRatio);
    this.renderer.setSize(width, height, false);
    this.viewCamera.aspect = width / height;
    this.viewCamera.updateProjectionMatrix();
    this.camera.aspect = width / height;
    this.camera.updateProjectionMatrix();
  }

  /** Start the loop. `update(dt)` is called once per frame before rendering. */
  run(update) {
    this._update = update;
    this._running = true;
    this._last = performance.now();
    requestAnimationFrame(this._tick);
  }

  _tick(now) {
    if (!this._running) return;
    requestAnimationFrame(this._tick);
    const dt = Math.min((now - this._last) / 1000, 0.1);
    this._last = now;
    if (this._update) this._update(dt);
    const r = this.renderer;
    r.render(this.scene, this.camera);
    r.autoClear = false;
    r.clearDepth();
    r.render(this.viewScene, this.viewCamera);
    r.autoClear = true;
  }
}

