  tube(steelMat, 0.025, 0.20, 0, 0.008, -0.31, 10); // barrel jacket
  tube(steelMat, 0.015, 0.40, 0, 0.008, -0.45, 10); // barrel
  tube(steelMat, 0.021, 0.05, 0, 0.008, -0.67, 8); // flash hider
  box(steelMat, 0.006, 0.03, 0.006, 0, 0.040, -0.62); // front sight
  box(steelMat, 0.010, 0.010, 0.17, 0.013, -0.032, -0.52); // folded bipod legs
  box(steelMat, 0.010, 0.010, 0.17, -0.013, -0.032, -0.52);
  box(steelMat, 0.016, 0.036, 0.10, 0, 0.068, -0.15); // carry handle
