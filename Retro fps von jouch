  ['hallN', 'corr1'], ['corr1', 'corr2'], ['corr2', 'corr3'], ['corr3', 'corr4'], ['corr4', 'corr5'],
  ['corr5', 'ctrlDoor'], ['ctrlDoor', 'ctrl'], ['ctrl', 'ctrlL'], ['ctrl', 'ctrlR'],
  ['hallW', 'wh1'], ['wh1', 'wh2'], ['wh2', 'wh3'], ['wh3', 'wh4'], ['wh4', 'wh7'], ['wh2', 'wh5'], ['wh2', 'wh6'], ['wh1', 'wh6'],
  ['hallE', 'east1'], ['east1', 'east2'], ['east2', 'pumpDoor'], ['pumpDoor', 'pump1'], ['pump1', 'pump2'],
  ['pump1', 'pump3'], ['pump1', 'pump4'], ['pump2', 'pumpE'],
  ['c_w1', 'c_w2'], ['c_w2', 'c_w3'], ['c_w3', 'c_w4'], ['c_w4', 'c_nw'], ['c_w4', 'c_sw'], ['c_nw', 'c_nm'], ['c_nm', 'c_ne'],
  ['c_sw', 'c_sm'], ['c_sm', 'c_se'], ['c_se', 'c_e1'], ['c_e1', 'c_e2'], ['c_ne', 'c_e2'], ['c_e2', 'c_e3'], ['c_e3', 'c_e4'],
  ['c_nm', 'c_n1'], ['c_n1', 'c_n2'], ['c_n2', 'c_n3'], ['c_n3', 'c_n4'], ['c_sm', 'c_s1'], ['c_s1', 'c_s2'], ['c_s2', 'c_s3'], ['c_s3', 'c_s4'],
  ['c_w3', 'c_g1'], ['c_g1', 'c_g2'], ['c_g2', 'c_g3'], ['c_g3', 'c_g4'], ['c_g4', 'c_g5'],
  ['c_ne', 'c_h1o'], ['c_h1o', 'c_h1i'], ['c_e2', 'c_h2o'], ['c_h2o', 'c_h2i'], ['c_h1i', 'c_hw1'], ['c_hw1', 'c_st0'],
  ['c_hw1', 'c_hp1'], ['c_hw1', 'c_hw2'], ['c_hw2', 'c_hp2'], ['c_hw2', 'c_hwI'], ['c_hwI', 'c_hwD'], ['c_hwD', 'c_n3'],
  ['c_hp1', 'c_he1'], ['c_hp2', 'c_he2'], ['c_he1', 'c_he2'], ['c_he1', 'c_h2i'], ['c_he1', 'c_heE'], ['c_heE', 'c_eD'], ['c_eD', 'c_e3'],
  ['c_st0', 'c_st1'], ['c_st1', 'c_up1'], ['c_up1', 'c_up2'], ['c_up2', 'c_upP1'], ['c_upP1', 'c_up3'], ['c_up3', 'c_up4'],
  ['c_up4', 'c_upP2'], ['c_upP2', 'c_up5'], ['c_up5', 'c_up2'],
  ['c_w3', 'c_s1o'], ['c_w4', 'c_s2o'], ['c_s1o', 'c_s1i'], ['c_s2o', 'c_s2i'], ['c_s1i', 'c_sm1'], ['c_s2i', 'c_sm1'], ['c_s1i', 'c_hsb'],
  ['c_sm1', 'c_sei'], ['c_sei', 'c_seo'], ['c_seo', 'c_s1'], ['c_hsb', 'c_sd'], ['c_sd', 'c_u1'], ['c_u1', 'c_u2'], ['c_u2', 'c_u3'], ['c_u2', 'c_u4'],
  ['c_se', 'c_y1o'], ['c_e1', 'c_y1o'], ['c_y1o', 'c_y1i'], ['c_s2', 'c_y2o'], ['c_y2o', 'c_y2i'], ['c_y1i', 'c_yc'], ['c_y2i', 'c_yc'],
  ['c_yc', 'c_ys1'], ['c_ys1', 'c_ys2'], ['c_yc', 'c_y3'],
  ['pumpE', 'dockDoor'], ['dockDoor', 'dock1'], ['dock1', 'dock2'], ['dock2', 'dock3'], ['dock2', 'dock4'], ['dock2', 'dock5'],
  ['wh4', 'boilDoor'], ['boilDoor', 'boil1'], ['boil1', 'boil2'], ['boil2', 'boil3'], ['boil2', 'boil4'], ['boil2', 'boil5'],
  ['east1', 'gDoor'], ['gDoor', 'gDoor2'], ['gDoor2', 'g1'], ['g1', 'g2'], ['g2', 'g3'], ['g3', 'g4'],
];
/** Bot spawn waypoints per team on the Crash map. */
const CRASH_BOT_SPAWNS = [['c_w1', 'c_w2', 'c_g1', 'c_w3'], ['c_e4', 'c_e3', 'c_eD', 'c_e2']];
const SPAWN_NODES = ['corr3', 'corr5', 'ctrl', 'ctrlL', 'ctrlR', 'wh2', 'wh3', 'wh5', 'wh6', 'wh7', 'east2', 'pump1', 'pump3', 'pump4',
  'dock2', 'dock3', 'dock4', 'dock5', 'boil2', 'boil3', 'boil4', 'boil5', 'g2', 'g3', 'g4'];

const rand = (a, b) => a + Math.random() * (b - a);
const NOT_ENEMY = (b) => !b.enemy && !b.isBase;
const TRACER_TIME = 1.0; // seconds a bullet trail stays visible
const TRACER_POOL = 30;

/**
 * Enemy soldiers: simple waypoint navigation, sight checks against the level,
 * burst fire at the player, damage from bullets and explosions, death and
 * respawn. Single player only: they stand down while a 1v1 match is connected.
 * Damage to the player goes through the shared Health system.
 */
class Enemies {
  constructor({ scene, world, player, input, settings, explosions, audio, health, ui }) {
    this.scene = scene;
    this.world = world;
    this.collision = world.collision;
    this.player = player;
    this.input = input;
    this.settings = settings;
    this.audio = audio;
    this.health = health;
    this.ui = ui;
    this.explosions = explosions;
    this.list = [];
    this.kills = 0;
    this.enabled = true; // false during a multiplayer match
    this._hit = { dist: 0, x: 0, y: 0, z: 0, nx: 0, ny: 0, nz: 0, box: null };

    this._buildNav(world.activeRooms);
    this._buildShared();

    explosions.onExplode.push((x, y, z, radius, owner) => this._explosion(x, y, z, radius, owner));
    settings.onChange((key) => { if (key === 'enemyCount') this._syncCount(); });
    this._syncCount();
    ui.setKills(this.kills);
  }

  /** Turn the enemies on (single player) or off (multiplayer match). */
  setEnabled(on) {
    if (on === this.enabled) return;
    this.enabled = on;
    this._syncCount();
  }

  get difficulty() {
    return EN_DIFFICULTY[Math.round(this.settings.get('difficulty'))] || EN_DIFFICULTY[1];
  }

  // --- Setup ---------------------------------------------------------------

  /** Waypoints of the rooms that exist. Call again when the map changes. */
  _buildNav(rooms) {
    this.nodes = [];
    const index = {};
    for (const name of Object.keys(NAV_NODES)) {
      const [x, z, room, floorY] = NAV_NODES[name];
      if (rooms && !rooms.has(room)) continue;
      index[name] = this.nodes.length;
      this.nodes.push({ name, x, z, y: floorY !== undefined ? floorY : this._groundAt(x, z), links: [] });
    }
    for (const [a, b] of NAV_LINKS) {
      if (index[a] === undefined || index[b] === undefined) continue;
      this.nodes[index[a]].links.push(index[b]);
      this.nodes[index[b]].links.push(index[a]);
    }
    this.spawnNodes = SPAWN_NODES.filter((n) => index[n] !== undefined).map((n) => index[n]);
    this.teamSpawnNodes = CRASH_BOT_SPAWNS.map((list) => list.filter((n) => index[n] !== undefined).map((n) => index[n]));
  }

  /** The map changed: new waypoints, everyone starts over. */
  setMap(rooms) {
    for (const e of this.list) {
      this._removeBox(e);
      this.scene.remove(e.root);
    }
    this.list = [];
    if (this.byId) this.byId.clear();
    this._buildNav(rooms);
    if (this.enabled) this._syncCount();
  }

  _groundAt(x, z) {
    const h = this._hit;
    if (this.collision.raycast(x, 3.2, z, 0, -1, 0, 8, h)) return h.y;
    return 0;
  }

  _buildShared() {
    const box = (w, h, d) => new THREE.BoxGeometry(w, h, d);
    this.geo = {
      leg: box(0.19, 0.9, 0.22),
      torso: box(0.52, 0.66, 0.3),
      vest: box(0.56, 0.42, 0.34),
      head: box(0.26, 0.28, 0.26),
      helmet: box(0.32, 0.13, 0.32),
      visor: box(0.22, 0.06, 0.03),
      arm: box(0.13, 0.5, 0.13),
      gun: box(0.08, 0.11, 0.62),
      mag: box(0.06, 0.16, 0.08),
      flash: box(0.14, 0.14, 0.14),
    };
    this.flashMat = new THREE.MeshBasicMaterial({ color: 0xffd070, fog: false });

    // Tracers: one shared line segment per pooled shot.
    this.tracers = [];
    for (let i = 0; i < TRACER_POOL; i++) {
      const g = new THREE.BufferGeometry();
      g.setAttribute('position', new THREE.BufferAttribute(new Float32Array(6), 3));
      const line = new THREE.Line(g, new THREE.LineBasicMaterial({ color: 0xffe2a0, transparent: true, opacity: 0.85 }));
      line.visible = false;
      line.frustumCulled = false;
      this.scene.add(line);
      this.tracers.push({ line, t: 0 });
    }
    this._nextTracer = 0;

    // Blood puffs.
    this.puffs = [];
    for (let i = 0; i < 14; i++) {
      const sprite = new THREE.Sprite(new THREE.SpriteMaterial({ color: 0x8c1010, transparent: true, depthWrite: false }));
      sprite.visible = false;
      this.scene.add(sprite);
      this.puffs.push({ sprite, t: -1 });
    }
    this._nextPuff = 0;
  }

  _createEnemy() {
    const mat = (color) => new THREE.MeshLambertMaterial({ color, emissive: 0x000000, flatShading: true });
    const m = {
      uniform: mat(0x56603f), vest: mat(0x2e3526), skin: mat(0xa98365),
      helmet: mat(0x3b4430), dark: mat(0x161616), gun: mat(0x262626),
    };
    const g = this.geo;
    const root = new THREE.Group();
    root.rotation.order = 'YXZ';
    const add = (parent, geo, material, x, y, z) => {
      const mesh = new THREE.Mesh(geo, material);
      mesh.position.set(x, y, z);
      parent.add(mesh);
      return mesh;
    };
    // Legs hang from hip pivots so they can swing.
    const legs = [];
    for (const side of [-1, 1]) {
      const hip = new THREE.Group();
      hip.position.set(0.13 * side, 0.9, 0);
      add(hip, g.leg, m.uniform, 0, -0.45, 0);
      root.add(hip);
      legs.push(hip);
    }
    add(root, g.torso, m.uniform, 0, 1.23, 0);
    add(root, g.vest, m.vest, 0, 1.28, 0);
    add(root, g.head, m.skin, 0, 1.7, 0);
    add(root, g.helmet, m.helmet, 0, 1.86, 0);
    add(root, g.visor, m.dark, 0, 1.72, -0.14);
    // Arms reach forward to the rifle.
    const arms = new THREE.Group();
    arms.position.set(0, 1.45, 0);
    for (const side of [-1, 1]) {
      const a = add(arms, g.arm, m.uniform, 0.22 * side, -0.05, -0.2);
      a.rotation.x = -1.25;
      a.rotation.y = -0.35 * side;
    }
    add(arms, g.gun, m.gun, 0.08, -0.13, -0.5);
    add(arms, g.mag, m.dark, 0.08, -0.25, -0.45);
    const flash = add(arms, g.flash, this.flashMat, 0.08, -0.13, -0.86);
    flash.visible = false;
    root.add(arms);
    root.visible = false;
    this.scene.add(root);

    const e = {
      root, legs, arms, flash, mats: Object.values(m),
      x: 0, y: 0, z: 0, vy: 0, yaw: 0, onGround: false,
      hp: 100, alive: false, state: 'patrol', box: null,
      deadT: 0, respawnT: 0, flashT: 0, hurtT: 0, stride: 0, speedNow: 0,
      seeT: 0, lostT: 0, reactT: 0, senseT: Math.random() * 0.2, sees: false,
      lastX: 0, lastZ: 0, searchT: 0,
      goalNode: -1, pathT: 0, nextNode: -1,
      patrolNode: -1, waitT: 0,
      strafe: 1, strafeT: 0, burst: 0, shotT: 0, stuckT: 0, jumpCd: 0,
    };
    e.box = { minX: 0, minY: 0, minZ: 0, maxX: 0, maxY: 0, maxZ: 0, enemy: e };
    e.sys = this;
    return e;
  }

  _syncCount() {
    // No soldier waypoints on this map (e.g. the 5v5 map): no soldiers.
    const want = this.enabled && this.spawnNodes.length ? Math.round(this.settings.get('enemyCount')) : 0;
    while (this.list.length < want) {
      const e = this._createEnemy();
      this.list.push(e);
      this._spawn(e);
    }
    while (this.list.length > want) {
      const e = this.list.pop();
      this._removeBox(e);
      this.scene.remove(e.root);
    }
  }

  // --- Spawning ------------------------------------------------------------

  /** Place an enemy at a spawn point away from the player and out of sight. */
  _spawn(e) {
    const p = this.player;
    const options = this.spawnNodes.slice().sort(() => Math.random() - 0.5);
    let chosen = null;
    for (const i of options) {
      const n = this.nodes[i];
      const d = Math.hypot(n.x - p.x, n.z - p.z);
      if (d < 14) continue;
      if (this._clear(n.x, n.y + EN_EYE, n.z, p.x, p.y + p.eyeHeight, p.z)) continue; // visible: skip
      if (this._occupied(n.x, n.z, e)) continue;
      chosen = n;
      break;
    }
    if (!chosen) {
      // Everything is in view or taken: take the farthest free spawn.
      let best = -1;
      for (const i of options) {
        const n = this.nodes[i];
        const d = Math.hypot(n.x - p.x, n.z - p.z);
        if (d > best && !this._occupied(n.x, n.z, e)) { best = d; chosen = n; }
      }
      if (!chosen) chosen = this.nodes[options[0]];
    }
    e.x = chosen.x + rand(-0.6, 0.6);
    e.z = chosen.z + rand(-0.6, 0.6);
    e.y = chosen.y + 0.05;
    if (this._blocked(e, e.x, e.y, e.z)) { e.x = chosen.x; e.z = chosen.z; }
    e.vy = 0;
    e.yaw = Math.random() * Math.PI * 2;
    e.hp = this.difficulty.hp;
    e.alive = true;
    e.state = 'patrol';
    e.sees = false;
    e.deadT = 0;
    e.patrolNode = this.nodes.indexOf(chosen);
    e.waitT = rand(0.5, 2);
    e.burst = this.difficulty.burst;
    e.shotT = 0;
    e.root.visible = true;
    e.root.rotation.set(0, e.yaw, 0);
    for (const mat of e.mats) mat.emissive.setRGB(0, 0, 0);
    this._addBox(e);
  }

  _occupied(x, z, self) {
    for (const o of this.list) {
      if (o !== self && o.alive && Math.hypot(o.x - x, o.z - z) < 1.2) return true;
    }
    return false;
  }

  _addBox(e) {
    this._syncBox(e);
    if (this.collision.boxes.indexOf(e.box) < 0) this.collision.boxes.push(e.box);
  }

  _removeBox(e) {
    this.collision.removeBox(e.box);
  }

  _syncBox(e) {
    const b = e.box;
    b.minX = e.x - EN_RADIUS; b.maxX = e.x + EN_RADIUS;
    b.minZ = e.z - EN_RADIUS; b.maxZ = e.z + EN_RADIUS;
    b.minY = e.y; b.maxY = e.y + EN_HEIGHT;
  }

  // --- Queries -------------------------------------------------------------

  /** True if nothing solid lies between the two points (enemy bodies count as solid). */
  _clear(ax, ay, az, bx, by, bz) {
    const dx = bx - ax, dy = by - ay, dz = bz - az;
    const d = Math.hypot(dx, dy, dz);
    if (d < 0.01) return true;
    return !this.collision.raycast(ax, ay, az, dx / d, dy / d, dz / d, d, this._hit);
  }

  /** Like _clear, but looks through soldiers and zombies: for finding the way, not for seeing. */
  _clearNav(ax, ay, az, bx, by, bz) {
    const dx = bx - ax, dy = by - ay, dz = bz - az;
    const d = Math.hypot(dx, dy, dz);
    if (d < 0.01) return true;
    return !this.collision.raycast(ax, ay, az, dx / d, dy / d, dz / d, d, this._hit, NOT_ENEMY);
  }

  /** Overlap test against the level and other enemies, ignoring this enemy's own box. Sets this._top. */
  _blocked(e, x, y, z) {
    const boxes = this.collision.boxes;
    const minX = x - EN_RADIUS, maxX = x + EN_RADIUS, minZ = z - EN_RADIUS, maxZ = z + EN_RADIUS;
    const minY = y, maxY = y + EN_HEIGHT;
    let hit = false;
    let top = -Infinity;
    for (let i = 0; i < boxes.length; i++) {
      const b = boxes[i];
      if (b === e.box) continue;
      if (maxX > b.minX && minX < b.maxX && maxY > b.minY && minY < b.maxY && maxZ > b.minZ && minZ < b.maxZ) {
        hit = true;
        if (b.maxY > top) top = b.maxY;
      }
    }
    this._top = top;
    // Keep out of the player's body too (the player is not in the collision world).
    const p = this.player;
    if (Math.hypot(p.x - x, p.z - z) < EN_RADIUS + p.radius + 0.05 && maxY > p.y && minY < p.y + p.height) {
      hit = true;
      this._top = Infinity; // never step onto the player
    }
    return hit;
  }

  _nearestNode(x, y, z, needSight) {
    let best = -1;
    let bestD = Infinity;
    for (let i = 0; i < this.nodes.length; i++) {
      const n = this.nodes[i];
      const d = Math.hypot(n.x - x, n.z - z) + Math.abs(n.y - y) * 2;
      if (d >= bestD) continue;
      if (needSight && !this._clearNav(x, y + 1.0, z, n.x, n.y + 1.0, n.z)) continue;
      best = i;
      bestD = d;
    }
    if (best < 0 && needSight) return this._nearestNode(x, y, z, false);
    return best;
  }

  /** Next node on the shortest (by hops) route from node a to node b. */
  _route(a, b) {
    if (a === b || a < 0 || b < 0) return b;
    const prev = new Array(this.nodes.length).fill(-1);
    prev[a] = a;
    const queue = [a];
    while (queue.length) {
      const c = queue.shift();
      if (c === b) break;
      for (const n of this.nodes[c].links) {
        if (prev[n] < 0) { prev[n] = c; queue.push(n); }
      }
    }
    if (prev[b] < 0) return b;
    let c = b;
    while (prev[c] !== a) c = prev[c];
    return c;
  }

  // --- Per frame -----------------------------------------------------------

  update(dt) {
    const playing = this.input.locked;

    for (const e of this.list) {
      if (!e.alive) {
        this._updateDead(e, dt);
        continue;
      }
      if (playing && !this.health.dead) this._think(e, dt);
      else e.speedNow = 0;
      this._physics(e, dt);
      this._animate(e, dt);
    }

    this._updateTracers(dt);
    for (const p of this.puffs) {
      if (p.t < 0) continue;
      p.t += dt;
      const k = p.t / 0.35;
      if (k >= 1) { p.t = -1; p.sprite.visible = false; continue; }
      p.sprite.scale.setScalar(0.15 + 0.4 * k);
      p.sprite.material.opacity = 0.9 * (1 - k);
    }
  }

  _think(e, dt) {
    const p = this.player;
    const diff = this.difficulty;
    const ex = e.x, ey = e.y, ez = e.z;
    const px = p.x, pz = p.z, peye = p.y + p.eyeHeight;
    const dxp = px - ex, dzp = pz - ez;
    const dist = Math.hypot(dxp, dzp);

    // Senses, a few times per second.
    e.senseT -= dt;
    if (e.senseT <= 0) {
      e.senseT = 0.15;
      let sees = false;
      if (dist < diff.view) {
        const fx = -Math.sin(e.yaw), fz = -Math.cos(e.yaw);
        const facing = dist < 0.01 ? 1 : (fx * dxp + fz * dzp) / dist;
        const aware = e.state !== 'patrol';
        if (aware || facing > 0.42 || dist < 5) {
          sees = this._clear(ex, ey + EN_EYE, ez, px, peye, pz) ||
            this._clear(ex, ey + EN_EYE, ez, px, p.y + p.height * 0.45, pz);
        }
      }
      if (sees && !e.sees) e.reactT = diff.react * rand(0.8, 1.3);
      e.sees = sees;
    }

    if (e.sees) {
      e.state = 'combat';
      e.lastX = px; e.lastZ = pz;
      e.lostT = 0;
    } else if (e.state === 'combat') {
      e.lostT += dt;
      if (e.lostT > 0.5) { e.state = 'search'; e.searchT = 9; }
    }
    if (e.state === 'search') {
      e.searchT -= dt;
      if (e.searchT <= 0 || Math.hypot(e.lastX - ex, e.lastZ - ez) < 1.2) {
        e.state = 'patrol';
        e.patrolNode = this._nearestNode(ex, ey, ez, true);
        e.waitT = rand(1, 2.5);
      }
    }

    // Where to go and how fast.
    let tx = ex, tz = ez, speed = 0, face = null;
    if (e.state === 'combat') {
      face = Math.atan2(-dxp, -dzp);
      e.strafeT -= dt;
      if (e.strafeT <= 0) { e.strafe = Math.random() < 0.5 ? -1 : 1; e.strafeT = rand(0.8, 2); }
      const nx = dist > 0 ? dxp / dist : 0, nz = dist > 0 ? dzp / dist : 0;
      let mx = -nz * e.strafe, mz = nx * e.strafe; // sideways
      if (dist > 14) { mx = nx; mz = nz; } // close in
      else if (dist < 6) { mx = -nx * 0.8 + mx * 0.6; mz = -nz * 0.8 + mz * 0.6; } // back off
      tx = ex + mx; tz = ez + mz;
      speed = diff.speed * (dist > 14 ? 0.95 : 0.6);
      this._shoot(e, dt, dist);
    } else if (e.state === 'search') {
      const goal = this._goalPoint(e, e.lastX, e.lastZ, dt);
      tx = goal.x; tz = goal.z;
      speed = diff.speed * 0.85;
    } else {
      // Patrol: walk between neighbouring waypoints, pausing now and then.
      if (e.patrolNode < 0) e.patrolNode = this._nearestNode(ex, ey, ez, true);
      const n = this.nodes[e.patrolNode];
      if (Math.hypot(n.x - ex, n.z - ez) < 0.8) {
        e.waitT -= dt;
        if (e.waitT <= 0) {
          const links = n.links;
          e.patrolNode = links[Math.floor(Math.random() * links.length)];
          e.waitT = Math.random() < 0.5 ? rand(0.5, 2.5) : 0;
        }
      } else {
        tx = n.x; tz = n.z;
        speed = 1.6;
      }
    }

    // Steering.
    const mx = tx - ex, mz = tz - ez;
    const ml = Math.hypot(mx, mz);
    if (ml > 0.05 && speed > 0) {
      e.moveX = mx / ml; e.moveZ = mz / ml;
      e.speedNow = speed;
      if (face === null) face = Math.atan2(-e.moveX, -e.moveZ);
    } else {
      e.speedNow = 0;
    }
    if (face !== null) {
      let d = face - e.yaw;
      d = Math.atan2(Math.sin(d), Math.cos(d));
      e.yaw += d * Math.min(1, dt * 8);
    }
  }

  /** Head for (gx, gz): straight if the way is clear, otherwise along the waypoints. */
  _goalPoint(e, gx, gz, dt, gy = this.player.y) {
    e.pathT -= dt;
    if (e.pathT <= 0) {
      e.pathT = 0.5;
      if (this._clearNav(e.x, e.y + 1.0, e.z, gx, gy + 1.0, gz) && this._clearNav(e.x, e.y + 0.4, e.z, gx, gy + 0.4, gz)) {
        e.nextNode = -1;
      } else {
        const from = this._nearestNode(e.x, e.y, e.z, true);
        const to = this._nearestNode(gx, gy, gz, true);
        const next = this._route(from, to);
        const n0 = this.nodes[from], n1 = this.nodes[next];
        const dFrom = Math.hypot(n0.x - e.x, n0.z - e.z);
        if (dFrom <= 0.8 || next === from) {
          e.nextNode = dFrom <= 0.8 ? next : from;
        } else {
          // Already past the nearest waypoint on the way to the next one? Then
          // head straight on instead of turning back (stops back-and-forth).
          const ahead = Math.hypot(n1.x - e.x, n1.z - e.z) < Math.hypot(n1.x - n0.x, n1.z - n0.z) &&
            this._clearNav(e.x, e.y + 1.0, e.z, n1.x, n1.y + 1.0, n1.z);
          e.nextNode = ahead ? next : from;
        }
      }
    }
    if (e.nextNode >= 0) {
      const n = this.nodes[e.nextNode];
      if (Math.hypot(n.x - e.x, n.z - e.z) < 0.7) e.pathT = 0; // reached: re-plan now
      return n;
    }
    return { x: gx, z: gz };
  }

  _shoot(e, dt, dist) {
    const diff = this.difficulty;
    e.reactT -= dt;
    if (!e.sees || e.reactT > 0) return;
    e.shotT -= dt;
    if (e.shotT > 0) return;
    if (e.burst <= 0) {
      e.burst = diff.burst;
      e.shotT = rand(diff.pause[0], diff.pause[1]);
      return;
    }
    e.burst--;
    e.shotT = 0.12;

    const p = this.player;
    // Chance to hit: base accuracy, worse with distance and a fast-moving
    // player, slightly worse against a crouching one.
    const pspeed = Math.hypot(p.vx, p.vz);
    let chance = diff.acc * Math.max(0.3, Math.min(1.15, 1.25 - dist / 30));
    if (pspeed > 6) chance *= 0.6; else if (pspeed > 2) chance *= 0.8;
    if (p.sliding) chance *= 0.5;
    if (p.crouching) chance *= 0.85;
    const hit = Math.random() < chance;

    // Muzzle position from the enemy's facing.
    const s = Math.sin(e.yaw), c = Math.cos(e.yaw);
    const mx = e.x - s * 0.86 + c * 0.08, my = e.y + 1.32, mz = e.z - c * 0.86 - s * 0.08;
    let tx = p.x, ty = p.y + p.height * 0.6, tz = p.z;
    if (!hit) {
      tx += rand(-1, 1) * 0.9; ty += rand(-0.6, 0.8); tz += rand(-1, 1) * 0.9;
    }
    this._tracer(mx, my, mz, tx, ty, tz);
    e.flash.visible = true;
    e.flash.rotation.z = Math.random() * 3;
    e.flashT = 0.05;
    this.audio.shot('ak', Math.max(0.12, 0.7 / (1 + dist * 0.12)));
    if (hit) this.damagePlayer(diff.dmg * rand(0.85, 1.15), e.x, e.z);
  }

  _physics(e, dt) {
    // Horizontal, one axis at a time with step-up, like the player.
    if (e.speedNow > 0) {
      const sx = e.moveX * e.speedNow * dt;
      const sz = e.moveZ * e.speedNow * dt;
      const ox = e.x, oz = e.z;
      this._moveAxis(e, sx, 0);
      this._moveAxis(e, 0, sz);
      const moved = Math.hypot(e.x - ox, e.z - oz);
      // Stuck against something: hop, then try another direction.
      if (moved < e.speedNow * dt * 0.25) {
        e.stuckT += dt;
        if (e.stuckT > 0.4 && e.onGround && e.jumpCd <= 0) { e.vy = 6.5; e.onGround = false; e.jumpCd = 1; }
        if (e.stuckT > 1.2) { e.strafe = -e.strafe; e.strafeT = 1; e.pathT = 0; e.stuckT = 0; e.patrolNode = -1; }
      } else e.stuckT = 0;
    }
    e.jumpCd -= dt;

    // Vertical.
    e.vy = Math.max(-40, e.vy - EN_GRAVITY * dt);
    const ny = e.y + e.vy * dt;
    if (this._blocked(e, e.x, ny, e.z)) {
      if (e.vy <= 0) {
        if (this._top !== Infinity) e.y = Math.max(e.y, this._top === -Infinity ? e.y : Math.min(this._top, e.y + EN_STEP));
        e.onGround = true;
      }
      e.vy = 0;
    } else {
      e.y = ny;
      e.onGround = false;
    }
    if (e.y < -20) { this._kill(e, false); return; }
    this._syncBox(e);
  }

  _moveAxis(e, dx, dz) {
    if (dx === 0 && dz === 0) return;
    const nx = e.x + dx, nz = e.z + dz;
    if (!this._blocked(e, nx, e.y, nz)) { e.x = nx; e.z = nz; return; }
    const top = this._top;
    if (e.onGround && top > e.y && top - e.y <= EN_STEP && !this._blocked(e, nx, top + 0.001, nz)) {
      e.x = nx; e.z = nz; e.y = top;
    }
  }

  _animate(e, dt) {
    const r = e.root;
    r.position.set(e.x, e.y, e.z);
    r.rotation.y = e.yaw;
    const moving = e.speedNow > 0.2 && e.onGround;
    e.stride += dt * (moving ? 2.2 + e.speedNow * 1.6 : 0);
    const swing = moving ? Math.sin(e.stride) * Math.min(0.75, 0.25 + e.speedNow * 0.12) : 0;
    e.legs[0].rotation.x += (swing - e.legs[0].rotation.x) * Math.min(1, dt * 12);
    e.legs[1].rotation.x += (-swing - e.legs[1].rotation.x) * Math.min(1, dt * 12);
    // Aim the rifle up / down at the player while fighting.
    let pitch = 0;
    if (e.state === 'combat') {
      const p = this.player;
      const d = Math.hypot(p.x - e.x, p.z - e.z);
      pitch = Math.atan2(p.y + p.height * 0.6 - (e.y + 1.35), Math.max(0.5, d));
    }
    e.arms.rotation.x += (pitch - e.arms.rotation.x) * Math.min(1, dt * 10);
    if (e.flashT > 0) { e.flashT -= dt; if (e.flashT <= 0) e.flash.visible = false; }
    if (e.hurtT > 0) {
      e.hurtT -= dt;
      const k = Math.max(0, e.hurtT / 0.12);
      for (const m of e.mats) m.emissive.setRGB(0.7 * k, 0.05 * k, 0.05 * k);
    }
  }

  /** Bullet trails fade out and are gone after TRACER_TIME. */
  _updateTracers(dt) {
    for (const t of this.tracers) {
      if (t.t <= 0) continue;
      t.t -= dt;
      if (t.t <= 0) t.line.visible = false;
      else t.line.material.opacity = 0.85 * (t.t / TRACER_TIME);
    }
  }

  _updateDead(e, dt) {
    if (!e.root.visible && e.respawnT <= 0) return;
    e.deadT += dt;
    const fall = Math.min(1, e.deadT / 0.45);
    e.root.rotation.x = (Math.PI / 2) * fall * fall;
    if (e.deadT > 3) e.root.position.y = e.y - (e.deadT - 3) * 0.6;
    if (e.deadT > 4.5) e.root.visible = false;
    e.respawnT -= dt;
    if (e.respawnT <= 0 && !this.health.dead) {
      e.root.rotation.x = 0;
      this._spawn(e);
    }
  }

  // --- Damage --------------------------------------------------------------

  /** A bullet hit `box` at `hit`. Returns true if it was an enemy. */
  /** A bullet hit `box` at `hit` with `damage` (already reduced by range). Returns true if it was an enemy. */
  bulletHit(box, hit, damage, headMul) {
    const e = box && box.enemy;
    if (!e || !e.alive) return false;
    const head = enemyHeadHit(e, hit);
    this._puff(hit.x, hit.y, hit.z);
    this._damage(e, damage * (head ? headMul : 1), head, true);
    return true;
  }

  _damage(e, amount, head, byPlayer) {
    e.hp -= amount;
    e.hurtT = 0.12;
    // Getting shot gives the player's position away.
    const p = this.player;
    e.lastX = p.x; e.lastZ = p.z;
    if (e.state !== 'combat') { e.state = 'search'; e.searchT = 9; e.pathT = 0; }
    const killed = e.hp <= 0;
    if (killed) this._kill(e, byPlayer, head);
    if (byPlayer) {
      this.ui.hitMarker(head || killed);
      this.audio.hitmarker(killed);
    }
  }

  _kill(e, byPlayer, head) {
    e.alive = false;
    e.deadT = 0;
    e.respawnT = EN_RESPAWN;
    e.flash.visible = false;
    for (const m of e.mats) m.emissive.setRGB(0, 0, 0);
    this._removeBox(e);
    if (byPlayer) {
      this.kills++;
      this.ui.setKills(this.kills);
      this.ui.feed(head ? 'HEADSHOT' : 'ENEMY DOWN');
    } else {
      e.root.visible = false;
    }
  }

  /** Player's gunfire is loud: enemies within earshot come looking. */
  noise() {
    const p = this.player;
    for (const e of this.list) {
      if (!e.alive || e.state === 'combat') continue;
      if (Math.hypot(e.x - p.x, e.z - p.z) < 26) {
        e.state = 'search';
        e.searchT = 9;
        e.pathT = 0;
        e.lastX = p.x; e.lastZ = p.z;
      }
    }
  }

  _explosion(x, y, z, radius, owner) {
    const r = radius * 0.8;
    for (const e of this.list) {
      if (!e.alive) continue;
      const d = Math.hypot(e.x - x, e.y + 0.9 - y, e.z - z);
      if (d < r) {
        e.vy = Math.max(e.vy, 4 * (1 - d / r));
        this._damage(e, 200 * (1 - d / r), false, owner !== 'other');
      }
    }
  }

  // --- Player --------------------------------------------------------------

  damagePlayer(amount, fromX, fromZ) {
    if (!this.input.locked) return;
    const applied = this.health.damage(amount, 'enemy', 'enemy');
    if (applied <= 0) return;
    const p = this.player;
    // Direction of the shot relative to the view, for the HUD arrow.
    const ang = Math.atan2(fromX - p.x, fromZ - p.z);
    this.ui.damageDir(ang - (p.yaw + Math.PI));
    this.audio.hurt();
  }

  /** After the player respawns: calm everyone down and move anyone camping the spawn. */
  onPlayerRespawn() {
    const p = this.player;
    for (const e of this.list) {
      if (!e.alive) continue;
      e.state = 'patrol';
      e.sees = false;
      e.patrolNode = -1;
      if (Math.hypot(e.x - p.x, e.z - p.z) < 16) {
        this._removeBox(e);
        this._spawn(e);
      }
    }
  }

  /** Living enemies, for picking a safe spawn point. */
  get alive() {
    return this.list.filter((e) => e.alive);
  }

  // --- Effects -------------------------------------------------------------

  _tracer(ax, ay, az, bx, by, bz) {
    const t = this.tracers[this._nextTracer];
    this._nextTracer = (this._nextTracer + 1) % this.tracers.length;
    const pos = t.line.geometry.attributes.position;
    pos.setXYZ(0, ax, ay, az);
    pos.setXYZ(1, bx, by, bz);
    pos.needsUpdate = true;
    t.line.visible = true;
    t.t = TRACER_TIME;
    t.line.material.opacity = 0.85;
  }

  _puff(x, y, z) {
    const p = this.puffs[this._nextPuff];
    this._nextPuff = (this._nextPuff + 1) % this.puffs.length;
    p.sprite.position.set(x, y, z);
    p.sprite.visible = true;
    p.t = 0;
  }
}

// ===== js/game/Zombies.js =====
const Z_BASE_HP = 1500;
const Z_BASE_REACH = 3.2; // zombies this close to the base centre attack it
const Z_BASE_RING = 2.4; // they walk to the nearest point of this circle around the base
const Z_BREAK = 15; // seconds between waves
const Z_FIRST_BREAK = 8;
const Z_OVER_TIME = 10; // seconds on the game-over screen before a new game
const Z_SNAPSHOT = 0.08; // host -> guests, about 12 per second
const Z_PHASES = ['break', 'fight', 'over'];
/** Where players (re)spawn in zombie defense: around the base, facing it. */
const BASE_SPAWNS = [
  { x: 0, y: 0, z: 6, yaw: 0 }, { x: 6.5, y: 0, z: 1.5, yaw: Math.PI / 2 },
  { x: -6.5, y: 0, z: -1.5, yaw: -Math.PI / 2 }, { x: 1.5, y: 0, z: -7, yaw: Math.PI },
];
const zr2 = (v) => Math.round(v * 100) / 100;
const Z_GOLD = { kill: 10, head: 5, wave: 50, turret: 4 };
const MINE_ARM = 1.0; // seconds before a placed mine is live
const MINE_TRIGGER = 1.3; // a zombie this close sets it off
const MINE_RADIUS = 5.5;
const TURRET_STATS = {
  mg: { range: 30, interval: [0.12, 0.09, 0.07], dmg: [12, 15, 19] },
  sentry: { range: 18, interval: [0.26], dmg: [11] },
};
/** The zombie-defense shop. cost: price per level. team: helps everyone. */
const SHOP_ITEMS = [
  { id: 'mg', team: true, name: 'Base machine pistol', desc: 'A machine pistol on top of the base that shoots zombies up to 30 m away. Only one.', cost: [600] },
  { id: 'mgup', team: true, name: 'Machine pistol upgrade', desc: 'The base machine pistol fires faster and hits harder.', cost: [500, 800] },
  { id: 'sentry', team: true, name: 'Sentry tower', desc: 'Built where you are standing. Shoots zombies up to 18 m away. Up to 3.', cost: [350] },
  { id: 'repair', team: true, name: 'Repair base', desc: '+300 base health.', cost: [150] },
  { id: 'dmg', name: 'Damage', desc: '+15% bullet damage per level.', cost: [200, 300, 450, 650, 900] },
  { id: 'hp', name: 'Max health', desc: '+25 max health per level.', cost: [150, 250, 400, 600] },
  { id: 'reload', name: 'Fast reload', desc: 'Reload 15% faster per level.', cost: [150, 250, 400] },
  { id: 'mine', name: 'Extra landmine', desc: '+1 landmine now (G to place).', cost: [100] },
];

/**
 * Zombie defense: waves of zombies come from the edges of the map and go for
 * the base in the middle of the hall, or for any player they notice on the
 * way. Reuses the soldiers' navigation and movement.
 *
 * Multiplayer: the host runs the zombies and sends snapshots; guests show
 * puppets and report their hits ('zhit'). Zombie bites on a guest are sent
 * to that guest ('zdmg'). Wave events go to everyone ('zev').
 */
class Zombies extends Enemies {
  constructor(opts) {
    super(opts);
    this.net = opts.net;
    this.remotes = opts.remotes;
    this.enabled = false;
    this.active = false;
    this.role = 'host';
    this.wave = 0;
    this.phase = 'break';
    this.timer = 0;
    this.baseHp = Z_BASE_HP;
    this.toSpawn = 0;
    this.left = 0;
    this.spawnT = 0;
    this.nextId = 1;
    this.scores = {}; // kills by player id
    this.byId = new Map();
    this.onEvent = null; // (event) for the game: refill on a cleared wave, respawn on a new game
    this._snapT = 0;
    this._players = [];
    this._baseFlash = 0;
    this._hud = {};
    this._buildBase();
    this._buildHud();
    this.explosions = opts.explosions;
    this.gold = {}; // by player id; the host keeps the real numbers
    this.levels = {}; // host: personal upgrade levels by player id
    this.my = { dmg: 0, hp: 0, reload: 0 }; // my own upgrade levels
    this.mines = 0; // my landmines left
    this.turrets = []; // host: real turrets; guests: copies from snapshots
    this.mineList = []; // host: live mines
    this.mgLevel = 0;
    this.onUpgrade = null; // (levels) after my upgrades change
    this.onShopChange = null; // gold, levels or items changed
    this._mineMeshes = [];
    this._mineRows = [];
    this._tSig = '';
  }

  get myId() {
    return this.net.online ? this.net.id : 1;
  }

  // Soldier-only behaviour switched off.
  _syncCount() {}
  noise() {}

  setMap(rooms) {
    super.setMap(rooms);
    if (this.active && this.role === 'host') this._reset();
  }

  // --- Mode ----------------------------------------------------------------

  setActive(on, role) {
    if (on === this.active && role === this.role) return;
    this._clearAll();
    this._removeTurrets();
    this.mineList = [];
    this._mineRows = [];
    this._drawMines([]);
    this.gold = {};
    this.levels = {};
    this.mgLevel = 0;
    this._resetMine();
    document.body.classList.toggle('zmode', on);
    this.active = on;
    this.role = role;
    this.base.visible = on;
    this.baseLight.intensity = on ? 18 : 0;
    const boxes = this.collision.boxes;
    const i = boxes.indexOf(this.baseBox);
    if (on && i < 0) boxes.push(this.baseBox);
    if (!on && i >= 0) boxes.splice(i, 1);
    this._hud.root.classList.toggle('on', on);
    this._hud.over.classList.remove('on');
    if (on && role === 'host') this._reset();
  }

  _reset() {
    this._clearAll();
    this.wave = 0;
    this.phase = 'break';
    this.timer = Z_FIRST_BREAK;
    this.baseHp = Z_BASE_HP;
    this.toSpawn = 0;
    this.scores = {};
    this.gold = {};
    this.levels = {};
    this.mgLevel = 0;
    this._removeTurrets();
    this.mineList = [];
    this._event({ k: 'reset' });
  }

  _clearAll() {
    for (const e of this.list) {
      this._removeBox(e);
      this.scene.remove(e.root);
    }
    this.list = [];
    this.byId.clear();
  }

  // --- Base ----------------------------------------------------------------

  _buildBase() {
    const g = new THREE.Group();
    g.position.set(0, 0.6, 0);
    const metal = new THREE.MeshLambertMaterial({ color: 0x3c4248, flatShading: true });
    const dark = new THREE.MeshLambertMaterial({ color: 0x1e2226 });
    this.baseGlow = new THREE.MeshBasicMaterial({ color: 0x5fd06a, fog: false });
    const add = (geo, mat, x, y, z) => {
      const m = new THREE.Mesh(geo, mat);
      m.position.set(x, y, z);
      g.add(m);
      return m;
    };
    add(new THREE.BoxGeometry(1.2, 1.4, 1.2), metal, 0, 0.7, 0);
    add(new THREE.BoxGeometry(1.26, 0.1, 1.26), this.baseGlow, 0, 0.45, 0);
    add(new THREE.BoxGeometry(1.26, 0.1, 1.26), this.baseGlow, 0, 1.05, 0);
    add(new THREE.BoxGeometry(0.9, 0.12, 0.9), dark, 0, 1.46, 0);
    add(new THREE.BoxGeometry(0.08, 0.8, 0.08), dark, 0.3, 1.9, 0.3);
    add(new THREE.BoxGeometry(0.16, 0.16, 0.16), this.baseGlow, 0.3, 2.34, 0.3);
    g.visible = false;
    this.scene.add(g);
    this.base = g;
    // One permanent light so the light count never changes.
    this.baseLight = new THREE.PointLight(0x7aff8a, 0, 9, 2);
    this.baseLight.position.set(0, 2.2, 0);
    this.scene.add(this.baseLight);
    this.baseBox = { minX: -0.6, minY: 0.6, minZ: -0.6, maxX: 0.6, maxY: 2.0, maxZ: 0.6, isBase: true };
  }

  _buildHud() {
    const root = document.createElement('div');
    root.id = 'zhud';
    root.innerHTML = '<div id="zwave"></div><div id="zbase"><span>BASE</span><div id="zbase-bar"><b></b></div><em></em></div><div id="zinfo"></div>';
    document.body.appendChild(root);
    const banner = document.createElement('div');
    banner.id = 'zbanner';
    document.body.appendChild(banner);
    const over = document.createElement('div');
    over.id = 'zover';
    over.innerHTML = '<h2>BASE DESTROYED</h2><p id="zover-waves"></p><p id="zover-kills"></p><p id="zover-timer"></p>';
    document.body.appendChild(over);
    this._hud = {
      root, banner, over,
      wave: root.querySelector('#zwave'), info: root.querySelector('#zinfo'),
      bar: root.querySelector('#zbase-bar b'), num: root.querySelector('#zbase em'),
      waves: over.querySelector('#zover-waves'), kills: over.querySelector('#zover-kills'), timer: over.querySelector('#zover-timer'),
      last: {},
    };
    this._bannerT = 0;
  }

  _setText(el, key, text) {
    if (this._hud.last[key] === text) return;
    this._hud.last[key] = text;
    el.textContent = text;
  }

  _updateHud(dt) {
    const h = this._hud;
    this._setText(h.wave, 'wave', this.wave > 0 ? 'WAVE ' + this.wave : 'GET READY');
    let info = '';
    if (this.phase === 'break') info = 'NEXT WAVE IN ' + Math.max(0, Math.ceil(this.timer));
    else if (this.phase === 'fight') info = 'ZOMBIES LEFT ' + this.left;
    this._setText(h.info, 'info', info);
    const f = Math.max(0, this.baseHp / Z_BASE_HP);
    const w = Math.round(f * 100) + '%';
    if (h.last.bar !== w) {
      h.last.bar = w;
      h.bar.style.width = w;
      h.bar.classList.toggle('low', f < 0.3);
    }
    this._setText(h.num, 'num', String(Math.ceil(this.baseHp)));
    this._setText(this._goldEl || (this._goldEl = document.getElementById('gold')), 'gold', 'GOLD ' + this.myGold);
    const touch = document.body.classList.contains('touch');
    this._setText(this._mineEl || (this._mineEl = document.getElementById('mine-label')), 'mines',
      (touch ? '' : '[G] ') + (this.mines === 1 ? '1 LANDMINE' : this.mines + ' LANDMINES'));
    if (this.phase === 'over') this._setText(h.timer, 'otimer', 'New game in ' + Math.max(1, Math.ceil(this.timer)));
    if (this._bannerT > 0) {
      this._bannerT -= dt;
      if (this._bannerT <= 0) h.banner.classList.remove('on');
    }
    // Base glow: green, red when hit, flickering when low.
    this._baseFlash = Math.max(0, this._baseFlash - dt * 4);
    const low = f < 0.3 && Math.sin(performance.now() / 90) > 0;
    if (this._baseFlash > 0 || low) this.baseGlow.color.setRGB(1, 0.25, 0.2);
    else this.baseGlow.color.setRGB(0.37, 0.82, 0.42);
  }

  _banner(text, time) {
    const b = this._hud.banner;
    b.textContent = text;
    b.classList.add('on');
    this._bannerT = time || 2.5;
  }

  // --- Events (host decides, everyone shows) --------------------------------

  _event(ev) {
    this.handleEvent(ev);
    if (this.net.online) this.net.send(Object.assign({ t: 'zev' }, ev));
  }

  /** A wave event, from the host's own logic or from the network. */
  handleEvent(ev) {
    const me = this.myId;
    if (ev.k === 'wave') {
      this._banner('WAVE ' + ev.n);
      this.audio.horn();
      // Landmines for this wave: 1, from wave 5 two, from wave 10 three, ...
      this.mines = 1 + Math.floor(ev.n / 5);
      this.ui.feed(this.mines + (this.mines === 1 ? ' LANDMINE' : ' LANDMINES') + ' READY');
      this._shopChanged();
    } else if (ev.k === 'clear') {
      this._banner('WAVE ' + ev.n + ' CLEARED');
      this.ui.feed('BASE REPAIRED +10%');
    } else if (ev.k === 'kill') {
      if (this.role === 'guest' && ev.by === me) {
        this.ui.hitMarker(true);
        this.audio.hitmarker(true);
      }
      if (ev.s) this.scores = ev.s;
      this.ui.setKills(this.scores[me] || 0);
      if (ev.by === me) this.ui.feed(ev.head ? 'HEADSHOT' : 'ZOMBIE DOWN');
    } else if (ev.k === 'over') {
      this.scores = ev.s || this.scores;
      const h = this._hud;
      h.waves.textContent = 'You held out for ' + ev.n + (ev.n === 1 ? ' wave' : ' waves');
      const parts = [];
      for (const id of Object.keys(this.scores).sort()) {
        parts.push((Number(id) === me ? 'YOU' : 'P' + id) + ' ' + this.scores[id]);
      }
      h.kills.textContent = parts.length ? 'Kills: ' + parts.join('  \u00b7  ') : 'Kills: 0';
      h.over.classList.add('on');
      this.audio.horn();
    } else if (ev.k === 'reset') {
      this.scores = {};
      this._hud.over.classList.remove('on');
      this.ui.setKills(0);
      this._resetMine();
      if (this.role === 'guest') { this._removeTurrets(); this.gold = {}; this.mgLevel = 0; }
      this._shopChanged();
    } else if (ev.k === 'built') {
      this.ui.feed((ev.by === me ? 'YOU' : 'P' + ev.by) + ' BOUGHT ' + ev.what);
    } else if (ev.k === 'boom') {
      this.explosions.explode(ev.x, ev.y + 0.3, ev.z, ev.x, ev.y, ev.z, 0, 1, 0, 0.9, 'mine');
    }
    if (this.onEvent) this.onEvent(ev);
  }

  // --- Host: waves ---------------------------------------------------------

  _collectPlayers() {
    const out = this._players;
    out.length = 0;
    const p = this.player;
    if (!this.health.dead && (this.input.locked || this.net.online)) out.push({ id: this.myId, x: p.x, y: p.y, z: p.z });
    for (const [id, r] of this.remotes) {
      if (r.present && !r.dead) out.push({ id, x: r.x, y: r.y, z: r.z });
    }
    return out;
  }

  get playerCount() {
    let n = 1;
    for (const r of this.remotes.values()) if (r.present) n++;
    return n;
  }

  _startWave() {
    this.wave++;
    this.phase = 'fight';
    const n = this.playerCount;
    this.toSpawn = Math.round((6 + 4 * this.wave) * (1 + 0.5 * (n - 1)));
    this.spawnT = 0;
    this._event({ k: 'wave', n: this.wave });
  }

  _spawnZombie() {
    const n = this.playerCount;
    const runner = this.wave >= 3 && Math.random() < Math.min(0.35, 0.05 * this.wave);
    // A spawn point away from every player.
    let node = null;
    for (let tries = 0; tries < 12 && !node; tries++) {
      const cand = this.nodes[this.spawnNodes[Math.floor(Math.random() * this.spawnNodes.length)]];
      let ok = true;
      for (const pl of this._players) if (Math.hypot(pl.x - cand.x, pl.z - cand.z) < 12) ok = false;
      if (ok || tries === 11) node = cand;
    }
    const e = this._createZombie(runner);
    e.x = node.x + rand(-0.8, 0.8);
    e.z = node.z + rand(-0.8, 0.8);
    e.y = node.y + 0.05;
    if (this._blocked(e, e.x, e.y, e.z)) { e.x = node.x; e.z = node.z; }
    if (this._blocked(e, e.x, e.y, e.z)) { this.scene.remove(e.root); return false; } // crowded: try later
    e.id = this.nextId++;
    e.hp = (60 + 15 * this.wave) * (1 + 0.25 * (n - 1)) * (runner ? 0.7 : 1);
    e.speed = runner ? 4.6 : 1.9 + Math.min(1.3, this.wave * 0.1) + rand(-0.2, 0.2);
    e.alive = true;
    e.root.visible = true;
    this._addBox(e);
    this.list.push(e);
    this.byId.set(e.id, e);
    return true;
  }

  // --- Per frame -----------------------------------------------------------

  update(dt) {
    this._updateTracers(dt);
    if (!this.active) return;
    if (this.role === 'host') this._updateHost(dt);
    else this._updateGuest(dt);
    for (const p of this.puffs) {
      if (p.t < 0) continue;
      p.t += dt;
      const k = p.t / 0.35;
      if (k >= 1) { p.t = -1; p.sprite.visible = false; continue; }
      p.sprite.scale.setScalar(0.15 + 0.4 * k);
      p.sprite.material.opacity = 0.9 * (1 - k);
    }
    this._updateHud(dt);
  }

  _updateHost(dt) {
    // Solo: everything waits while the menu is open.
    if (!this.net.online && !this.input.locked) return;
    this._collectPlayers();

    if (this.phase === 'break') {
      this.timer -= dt;
      if (this.timer <= 0) this._startWave();
    } else if (this.phase === 'fight') {
      let alive = 0;
      for (const e of this.list) if (e.alive) alive++;
      const maxAlive = 10 + 4 * this.playerCount;
      if (this.toSpawn > 0) {
        this.spawnT -= dt;
        if (this.spawnT <= 0 && alive < maxAlive) {
          if (this._spawnZombie()) this.toSpawn--;
          this.spawnT = Math.max(0.35, 1.3 - this.wave * 0.06);
        }
      } else if (alive === 0) {
        this.phase = 'break';
        this.timer = Z_BREAK;
        this.baseHp = Math.min(Z_BASE_HP, this.baseHp + Z_BASE_HP * 0.1);
        const ids = [this.myId];
        for (const [id, r] of this.remotes) if (r.present) ids.push(id);
        for (const id of ids) this.gold[id] = (this.gold[id] || 0) + Z_GOLD.wave;
        this._event({ k: 'clear', n: this.wave });
        this._shopChanged();
      }
      this.left = this.toSpawn + alive;
    } else if (this.phase === 'over') {
      this.timer -= dt;
      if (this.timer <= 0) this._reset();
    }

    for (let i = this.list.length - 1; i >= 0; i--) {
      const e = this.list[i];
      if (!e.alive) { this._updateDead(e, dt); continue; }
      if (this.phase !== 'over') this._thinkZombie(e, dt);
      else e.speedNow = 0;
      this._physics(e, dt);
      this._animate(e, dt);
    }
    this._separate(dt);
    if (this.phase !== 'over') {
      this._updateTurrets(dt);
      this._updateMines(dt);
    }
    for (const m of this.mineList) m.armed = m.arm <= 0;
    this._drawMines(this.mineList.map((m) => [m.x, m.y, m.z, m.arm <= 0 ? 1 : 0]));

    if (this.baseHp <= 0 && this.phase !== 'over') {
      this.baseHp = 0;
      this.phase = 'over';
      this.timer = Z_OVER_TIME;
      for (const e of this.list) e.speedNow = 0;
      this._event({ k: 'over', n: Math.max(0, this.wave - 1), s: this.scores });
    }

    if (this.net.online && this.net.peer) {
      this._snapT -= dt;
      if (this._snapT <= 0) {
        this._snapT = Z_SNAPSHOT;
        this.net.send(this._snapshot());
      }
    }
  }

  _thinkZombie(e, dt) {
    // Pick a target: a player it can see nearby, otherwise the base.
    e.retargetT -= dt;
    if (e.retargetT <= 0) {
      e.retargetT = 0.4;
      let best = null, bd = Infinity;
      for (const pl of this._players) {
        const d = Math.hypot(pl.x - e.x, pl.z - e.z);
        if (d >= bd || d > 11) continue;
        if (d < 4 || this._clear(e.x, e.y + 1.5, e.z, pl.x, pl.y + 1.4, pl.z)) { best = pl; bd = d; }
      }
      e.target = best ? best.id : 0;
    }
    let target = null;
    if (e.target) for (const pl of this._players) if (pl.id === e.target) target = pl;

    let attack = null;
    if (target) {
      if (Math.hypot(target.x - e.x, target.z - e.z) < 1.25 && Math.abs(target.y - e.y) < 1.5) attack = 'player';
    } else if (Math.hypot(e.x, e.z) < Z_BASE_REACH) {
      attack = 'base';
    }

    let face = null;
    if (attack) {
      e.state = 'attack';
      e.speedNow = 0;
      face = attack === 'player' ? Math.atan2(-(target.x - e.x), -(target.z - e.z)) : Math.atan2(e.x, e.z);
      e.atkT -= dt;
      if (e.atkT <= 0) {
        e.atkT = 1.1;
        if (attack === 'player') this._bite(target.id, 18 * (1 + this.wave * 0.04), e.x, e.z);
        else {
          this.baseHp -= 9 * (1 + this.wave * 0.03);
          this._baseFlash = 1;
          this.audio.thud(this._volumeAt(e.x, e.z));
        }
      }
    } else {
      e.state = 'walk';
      e.atkT = Math.min(e.atkT, 0.45);
      // Go for the player, or for the near side of the base (never through it).
      let gx = 0, gz = 0;
      if (target) { gx = target.x; gz = target.z; } else {
        const d = Math.hypot(e.x, e.z) || 1;
        gx = (e.x / d) * Z_BASE_RING;
        gz = (e.z / d) * Z_BASE_RING;
      }
      const goal = this._goalPoint(e, gx, gz, dt, target ? target.y : 0);
      const mx = goal.x - e.x, mz = goal.z - e.z;
      const ml = Math.hypot(mx, mz);
      if (ml > 0.05) {
        e.moveX = mx / ml;
        e.moveZ = mz / ml;
        e.speedNow = e.speed;
        face = Math.atan2(-e.moveX, -e.moveZ);
      } else e.speedNow = 0;
    }
    if (face !== null) {
      let d = face - e.yaw;
      d = Math.atan2(Math.sin(d), Math.cos(d));
      e.yaw += d * Math.min(1, dt * 6);
    }
    e.groanT -= dt;
    if (e.groanT <= 0) {
      e.groanT = rand(4, 11);
      const v = this._volumeAt(e.x, e.z);
      if (v > 0.05) this.audio.groan(v);
    }
  }

  _volumeAt(x, z) {
    const p = this.player;
    return Math.max(0, 0.9 / (1 + Math.hypot(p.x - x, p.z - z) * 0.18));
  }

  _bite(id, dmg, x, z) {
    if (id === this.myId) this.hurtMe(dmg, x, z);
    else this.net.send({ t: 'zdmg', to: id, dmg: Math.round(dmg), x: zr2(x), z: zr2(z) });
  }

  /** A zombie bit this player (locally or reported by the host). */
  hurtMe(dmg, x, z) {
    if (!this.input.locked && !this.net.online) return;
    const applied = this.health.damage(dmg, 'zombie', 'zombie');
    if (applied <= 0) return;
    const p = this.player;
    this.ui.damageDir(Math.atan2(x - p.x, z - p.z) - (p.yaw + Math.PI));
    this.audio.hurt();
  }

  _snapshot() {
    const z = [];
    for (const e of this.list) {
      z.push([e.id, zr2(e.x), zr2(e.y), zr2(e.z), zr2(e.yaw), e.alive ? (e.state === 'attack' ? 1 : 0) : 2, e.runner ? 1 : 0]);
    }
    return {
      t: 'zs', w: this.wave, ph: Z_PHASES.indexOf(this.phase), tm: Math.ceil(this.timer),
      bh: Math.round(this.baseHp), left: this.left, z,
      g: this.gold, ml: this.mgLevel,
      tu: this.turrets.map((t) => [t.type === 'mg' ? 0 : 1, zr2(t.x), zr2(t.y), zr2(t.z), zr2(t.yaw), zr2(t.pitch), t.fireT > 0 ? 1 : 0]),
      mi: this.mineList.map((m) => [zr2(m.x), zr2(m.y), zr2(m.z), m.arm <= 0 ? 1 : 0]),
    };
  }

  // --- Guest: puppets from snapshots ---------------------------------------

  applySnapshot(m) {
    if (!this.active || this.role !== 'guest') return;
    this.wave = m.w | 0;
    this.phase = Z_PHASES[m.ph] || 'break';
    this.timer = m.tm;
    if (m.bh < this.baseHp - 0.5) this._baseFlash = 1;
    this.baseHp = m.bh;
    this.left = m.left | 0;
    const before = this.myGold + ':' + this.mgLevel + ':' + this.turrets.length;
    this.gold = m.g || {};
    this.mgLevel = m.ml | 0;
    this._mirrorTurrets(Array.isArray(m.tu) ? m.tu : []);
    this._mineRows = Array.isArray(m.mi) ? m.mi : [];
    if (before !== this.myGold + ':' + this.mgLevel + ':' + this.turrets.length) this._shopChanged();
    const seen = new Set();
    for (const row of m.z || []) {
      const [id, x, y, z, yaw, st, runner] = row;
      seen.add(id);
      let e = this.byId.get(id);
      if (!e) {
        if (st === 2) continue; // never saw it alive
        e = this._createZombie(!!runner);
        e.id = id;
        e.x = e.tx = x; e.y = e.ty = y; e.z = e.tz = z; e.yaw = e.tyaw = yaw;
        e.alive = true;
        e.root.visible = true;
        this._addBox(e);
        this.list.push(e);
        this.byId.set(id, e);
      }
      e.tx = x; e.ty = y; e.tz = z; e.tyaw = yaw;
      e.state = st === 1 ? 'attack' : 'walk';
      if (st === 2 && e.alive) {
        e.alive = false;
        e.deadT = 0;
        this._removeBox(e);
      }
    }
    for (let i = this.list.length - 1; i >= 0; i--) {
      const e = this.list[i];
      if (!seen.has(e.id)) this._removeZombie(e, i);
    }
  }

  _updateGuest(dt) {
    this._updateTurretMirrors(dt);
    this._drawMines(this._mineRows);
    const k = Math.min(1, dt * 12);
    for (let i = this.list.length - 1; i >= 0; i--) {
      const e = this.list[i];
      if (!e.alive) { this._updateDead(e, dt); continue; }
      const ox = e.x, oz = e.z;
      e.x += (e.tx - e.x) * k;
      e.y += (e.ty - e.y) * k;
      e.z += (e.tz - e.z) * k;
      let d = e.tyaw - e.yaw;
      d = Math.atan2(Math.sin(d), Math.cos(d));
      e.yaw += d * k;
      e.speedNow = dt > 0 ? Math.hypot(e.x - ox, e.z - oz) / dt : 0;
      e.onGround = true;
      this._syncBox(e);
      this._animate(e, dt);
    }
  }

  // --- Damage --------------------------------------------------------------

  bulletHit(box, hit, damage, headMul) {
    const e = box && box.enemy;
    if (!e || !e.alive) return false;
    const head = enemyHeadHit(e, hit);
    const dmg = damage * (head ? headMul : 1);
    this._puff(hit.x, hit.y, hit.z);
    if (this.role === 'host') {
      this._damage(e, dmg, head, this.myId);
    } else {
      this.net.send({ t: 'zhit', z: e.id, dmg: Math.round(dmg), head: head ? 1 : 0 });
      this.ui.hitMarker(head);
      this.audio.hitmarker(false);
    }
    return true;
  }

  /** Host: a guest hit a zombie. */
  onNetHit(m) {
    if (this.role !== 'host') return;
    const e = this.byId.get(m.z);
    if (e && e.alive && typeof m.dmg === 'number') this._damage(e, m.head ? HEAD_ONE_SHOT * 100 : Math.min(300, Math.max(0, m.dmg)), !!m.head, m.from | 0);
  }

  _damage(e, amount, head, byId, turretOwner) {
    if (!e.alive) return;
    e.hp -= amount;
    e.hurtT = 0.12;
    if (byId && e.target === 0) { e.target = byId; e.retargetT = 1.5; } // turn on whoever shoots it
    const killed = e.hp <= 0;
    if (killed) this._kill(e, byId, head, turretOwner);
    if (byId && byId === this.myId) {
      this.ui.hitMarker(head || killed);
      this.audio.hitmarker(killed);
    }
  }

  _kill(e, byId, head, turretOwner) {
    if (!e.alive) return;
    e.alive = false;
    e.deadT = 0;
    this._removeBox(e);
    for (const m of e.mats) m.emissive.setRGB(0, 0, 0);
    if (turretOwner) this.gold[turretOwner] = (this.gold[turretOwner] || 0) + Z_GOLD.turret;
    if (byId) {
      this.gold[byId] = (this.gold[byId] || 0) + Z_GOLD.kill + (head ? Z_GOLD.head : 0);
      this._shopChanged();
      this.scores[byId] = (this.scores[byId] || 0) + 1;
      this._event({ k: 'kill', by: byId, head: head ? 1 : 0, s: this.scores });
    }
  }

  _explosion(x, y, z, radius, owner) {
    if (!this.active || this.role !== 'host' || owner === 'mine') return; // mines deal their own damage
    const r = radius * 0.8;
    for (const e of this.list) {
      if (!e.alive) continue;
      const d = Math.hypot(e.x - x, e.y + 0.9 - y, e.z - z);
      if (d < r) {
        e.vy = Math.max(e.vy, 4 * (1 - d / r));
        this._damage(e, 220 * (1 - d / r), false, owner === 'me' ? this.myId : this.explosions.ownerId || 0);
      }
    }
  }

  _updateDead(e, dt) {
    e.deadT += dt;
    const fall = Math.min(1, e.deadT / 0.45);
    e.root.rotation.x = (Math.PI / 2) * fall * fall;
    e.root.position.set(e.x, e.deadT > 2.5 ? e.y - (e.deadT - 2.5) * 0.6 : e.y, e.z);
    if (e.deadT > 4 && this.role === 'host') this._removeZombie(e, this.list.indexOf(e));
  }

  _removeZombie(e, index) {
    this._removeBox(e);
    this.scene.remove(e.root);
    this.byId.delete(e.id);
    if (index >= 0) this.list.splice(index, 1);
  }

  _animate(e, dt) {
    super._animate(e, dt);
    // Arms reach out; claw when attacking.
    e.clawT = (e.clawT || 0) + dt;
    const target = e.state === 'attack' ? Math.sin(e.clawT * 9) * 0.55 - 0.15 : Math.sin(e.clawT * 2.3 + e.id) * 0.08;
    e.arms.rotation.x += (target - e.arms.rotation.x) * Math.min(1, dt * 14);
    e.root.rotation.z = Math.sin(e.stride * 0.5) * 0.06; // shambling sway
  }

  // --- Economy: gold, shop, turrets, landmines -------------------------------

  get myGold() {
    return Math.floor(this.gold[this.myId] || 0);
  }

  _shopChanged() {
    if (this.onShopChange) this.onShopChange();
  }

  /** What an item costs for a buyer with `gold` and personal levels `lv`, and whether it can be bought. */
  _itemState(it, gold, lv) {
    const hasMg = this.turrets.some((t) => t.type === 'mg');
    const sentries = this.turrets.filter((t) => t.type === 'sentry').length;
    let cost = it.cost[0], level = 0, max = it.cost.length, blocked = '';
    if (it.id === 'mg') {
      level = hasMg ? 1 : 0; max = 1;
      if (hasMg) blocked = 'BUILT';
    } else if (it.id === 'mgup') {
      level = this.mgLevel; max = it.cost.length;
      cost = it.cost[Math.min(level, max - 1)];
      if (!hasMg) blocked = 'BUILD IT FIRST';
      else if (level >= max) blocked = 'MAX';
    } else if (it.id === 'sentry') {
      level = sentries; max = 3;
      if (sentries >= 3) blocked = 'MAX 3';
    } else if (it.id === 'repair') {
      max = 0;
      if (this.baseHp >= Z_BASE_HP - 1) blocked = 'BASE FULL';
    } else if (it.id === 'mine') {
      max = 0;
    } else {
      level = lv[it.id] || 0;
      cost = it.cost[Math.min(level, max - 1)];
      if (level >= max) blocked = 'MAX';
    }
    if (!blocked && this.phase === 'over') blocked = 'GAME OVER';
    return { cost, level, max, blocked, afford: gold >= cost };
  }

  /** The shop as shown to this player. */
  shopItems() {
    const gold = this.myGold;
    return SHOP_ITEMS.map((it) => {
      const st = this._itemState(it, gold, this.my);
      return Object.assign({ id: it.id, name: it.name, desc: it.desc, team: !!it.team }, st, { can: !st.blocked && st.afford });
    });
  }

  buy(itemId) {
    if (!this.active) return;
    const p = this.player;
    if (this.role === 'host') this._handleBuy(this.myId, itemId, p.x, p.y, p.z);
    else this.net.send({ t: 'zbuy', item: itemId, x: zr2(p.x), y: zr2(p.y), z: zr2(p.z) });
  }

  /** Host: a guest wants to buy something. */
  onNetBuy(m) {
    if (this.role === 'host' && m.from) this._handleBuy(m.from | 0, String(m.item), +m.x || 0, +m.y || 0, +m.z || 0);
  }

  _handleBuy(id, itemId, x, y, z) {
    const it = SHOP_ITEMS.find((i) => i.id === itemId);
    if (!it) return;
    const lv = this.levels[id] || (this.levels[id] = {});
    const st = this._itemState(it, this.gold[id] || 0, lv);
    if (st.blocked || !st.afford) return;
    if (itemId === 'sentry') {
      // Not on the base itself, and on solid ground.
      if (Math.hypot(x, z) < 1.4) { const d = Math.hypot(x, z) || 1; x = (x / d) * 1.4; z = (z / d) * 1.4; }
      y = this._groundAt(x, z);
    }
    this.gold[id] = (this.gold[id] || 0) - st.cost;
    if (itemId === 'mg') {
      this._addTurret('mg', 0, 0, 0, id);
      this._event({ k: 'built', by: id, what: 'THE BASE MACHINE PISTOL' });
    } else if (itemId === 'mgup') {
      this.mgLevel++;
      this._event({ k: 'built', by: id, what: 'MACHINE PISTOL LEVEL ' + (this.mgLevel + 1) });
    } else if (itemId === 'sentry') {
      this._addTurret('sentry', x, y, z, id);
      this._event({ k: 'built', by: id, what: 'A SENTRY TOWER' });
    } else if (itemId === 'repair') {
      this.baseHp = Math.min(Z_BASE_HP, this.baseHp + 300);
      this._event({ k: 'built', by: id, what: 'A BASE REPAIR' });
    } else if (itemId === 'mine') {
      this._grant(id, 'mine', 1);
    } else {
      lv[itemId] = (lv[itemId] || 0) + 1;
      this._grant(id, itemId, lv[itemId]);
    }
    this._shopChanged();
  }

  _grant(id, item, level) {
    if (id === this.myId) this.applyGrant(item, level);
    else this.net.send({ t: 'zbought', to: id, item, level });
  }

  /** A purchase of mine went through (personal upgrade or extra landmine). */
  applyGrant(item, level) {
    if (!this.active) return;
    if (item === 'mine') {
      this.mines++;
      this.ui.feed('+1 LANDMINE');
    } else if (item in this.my) {
      this.my[item] = level | 0;
      const it = SHOP_ITEMS.find((i) => i.id === item);
      this.ui.feed((it ? it.name.toUpperCase() : item) + ' LEVEL ' + level);
      if (this.onUpgrade) this.onUpgrade(this.my);
    }
    this.audio.pickup();
    this._shopChanged();
  }

  _resetMine() {
    this.my = { dmg: 0, hp: 0, reload: 0 };
    this.mines = 0;
    if (this.onUpgrade) this.onUpgrade(this.my);
  }

  // --- Turrets -------------------------------------------------------------

  _turretMesh(type) {
    if (!this._tMetal) {
      this._tMetal = new THREE.MeshLambertMaterial({ color: 0x4a4f55, flatShading: true });
      this._tDark = new THREE.MeshLambertMaterial({ color: 0x1c1f22 });
    }
    const g = new THREE.Group();
    if (type === 'sentry') {
      const post = new THREE.Mesh(new THREE.BoxGeometry(0.22, 1.3, 0.22), this._tMetal);
      post.position.y = 0.65;
      g.add(post);
      const foot = new THREE.Mesh(new THREE.BoxGeometry(0.7, 0.08, 0.7), this._tDark);
      foot.position.y = 0.04;
      g.add(foot);
    }
    const pivot = new THREE.Group();
    pivot.rotation.order = 'YXZ';
    pivot.position.y = type === 'sentry' ? 1.42 : 0;
    g.add(pivot);
    pivot.add(new THREE.Mesh(new THREE.BoxGeometry(0.28, 0.2, 0.38), this._tMetal));
    const len = type === 'mg' ? 0.34 : 0.5;
    const barrel = new THREE.Mesh(new THREE.BoxGeometry(0.05, 0.05, len), this._tDark);
    barrel.position.set(0, 0, -0.19 - len / 2);
    pivot.add(barrel);
    if (type === 'mg') {
      // Machine pistol: a long stick magazine under the body and a front grip.
      const mag = new THREE.Mesh(new THREE.BoxGeometry(0.07, 0.3, 0.08), this._tDark);
      mag.position.set(0, -0.23, -0.04);
      pivot.add(mag);
      const grip = new THREE.Mesh(new THREE.BoxGeometry(0.06, 0.16, 0.07), this._tMetal);
      grip.position.set(0, -0.16, 0.12);
      pivot.add(grip);
    }
    const flash = new THREE.Mesh(this.geo.flash, this.flashMat);
    flash.position.z = -0.24 - len;
    flash.visible = false;
    pivot.add(flash);
    this.scene.add(g);
    return { g, pivot, flash };
  }

  _addTurret(type, x, y, z, owner) {
    const m = this._turretMesh(type);
    const gy = type === 'mg' ? 2.18 : y; // the base gun sits on top of the base
    m.g.position.set(x, gy, z);
    const t = Object.assign({
      type, x, y: gy, z, py: type === 'mg' ? gy : gy + 1.42, owner,
      yaw: 0, pitch: 0, tyaw: 0, tpitch: 0, cd: 0, seekT: 0, target: null, fireT: 0, flashT: 0, firing: 0, soundT: 0,
    }, m);
    this.turrets.push(t);
    return t;
  }

  _removeTurrets() {
    for (const t of this.turrets) this.scene.remove(t.g);
    this.turrets = [];
    this._tSig = '';
  }

  _turretTarget(t, range) {
    let best = null, bd = range;
    for (const e of this.list) {
      if (!e.alive) continue;
      const d = Math.hypot(e.x - t.x, e.z - t.z);
      if (d >= bd) continue;
      if (!this._clearNav(t.x, t.py, t.z, e.x, e.y + 1.2, e.z)) continue;
      best = e;
      bd = d;
    }
    return best;
  }

  _updateTurrets(dt) {
    for (const t of this.turrets) {
      const st = TURRET_STATS[t.type];
      const lv = t.type === 'mg' ? this.mgLevel : 0;
      t.cd -= dt;
      t.seekT -= dt;
      t.fireT -= dt;
      if (t.flashT > 0) { t.flashT -= dt; if (t.flashT <= 0) t.flash.visible = false; }
      if (t.seekT <= 0) { t.seekT = 0.2; t.target = this._turretTarget(t, st.range); }
      const e = t.target && t.target.alive ? t.target : null;
      if (!e) { t.target = null; continue; }
      const dx = e.x - t.x, dz = e.z - t.z, dy = e.y + 1.2 - t.py;
      const yaw = Math.atan2(-dx, -dz);
      const pitch = Math.atan2(dy, Math.hypot(dx, dz));
      const turn = Math.atan2(Math.sin(yaw - t.yaw), Math.cos(yaw - t.yaw));
      t.yaw += turn * Math.min(1, dt * 10);
      t.pitch += (pitch - t.pitch) * Math.min(1, dt * 10);
      t.pivot.rotation.set(t.pitch, t.yaw, 0);
      if (t.cd > 0 || Math.abs(turn) > 0.25) continue;
      t.cd = st.interval[Math.min(lv, st.interval.length - 1)];
      const dmg = st.dmg[Math.min(lv, st.dmg.length - 1)];
      const hit = Math.random() < 0.85;
      const c = Math.cos(t.pitch);
      const mx = t.x - Math.sin(t.yaw) * c * 0.8, my = t.py + Math.sin(t.pitch) * 0.8, mz = t.z - Math.cos(t.yaw) * c * 0.8;
      const off = hit ? 0 : 1;
      this._tracer(mx, my, mz, e.x + rand(-0.6, 0.6) * off, e.y + 1.2 + rand(-0.4, 0.6) * off, e.z + rand(-0.6, 0.6) * off);
      t.flash.visible = true;
      t.flash.rotation.z = Math.random() * 3;
      t.flashT = 0.04;
      t.fireT = 0.2;
      if (hit) this._damage(e, dmg, false, 0, t.owner);
      this.audio.shot('smg', Math.max(0.04, 0.45 * this._volumeAt(t.x, t.z)));
    }
  }

  /** Guests: turrets mirrored from the host's snapshot. */
  _mirrorTurrets(rows) {
    const sig = rows.map((a) => a[0] + ':' + a[1] + ':' + a[3]).join('|');
    if (sig !== this._tSig) {
      this._removeTurrets();
      for (const a of rows) {
        const t = this._addTurret(a[0] ? 'sentry' : 'mg', a[1], a[2], a[3], 0);
        t.yaw = a[4]; t.pitch = a[5];
      }
      this._tSig = sig;
    }
    rows.forEach((a, i) => {
      const t = this.turrets[i];
      t.tyaw = a[4];
      t.tpitch = a[5];
      t.firing = a[6];
    });
  }

  _updateTurretMirrors(dt) {
    const k = Math.min(1, dt * 12);
    for (const t of this.turrets) {
      t.yaw += Math.atan2(Math.sin(t.tyaw - t.yaw), Math.cos(t.tyaw - t.yaw)) * k;
      t.pitch += (t.tpitch - t.pitch) * k;
      t.pivot.rotation.set(t.pitch, t.yaw, 0);
      t.flash.visible = !!t.firing && Math.random() < 0.5;
      if (t.firing) {
        t.soundT -= dt;
        if (t.soundT <= 0) {
          t.soundT = TURRET_STATS[t.type].interval[t.type === 'mg' ? Math.min(this.mgLevel, 2) : 0];
          this.audio.shot('smg', Math.max(0.04, 0.45 * this._volumeAt(t.x, t.z)));
        }
      }
    }
  }

  // --- Landmines -----------------------------------------------------------

  /** Put one of my landmines down in front of me. */
  placeMine() {
    if (!this.active || this.health.dead) return;
    if (this.mines <= 0) { this.ui.feed('NO LANDMINES LEFT'); return; }
    const p = this.player;
    if (!p.onGround) return;
    let x = p.x - Math.sin(p.yaw) * 0.9, z = p.z - Math.cos(p.yaw) * 0.9;
    if (this.collision.intersects(x - 0.25, p.y + 0.05, z - 0.25, x + 0.25, p.y + 0.6, z + 0.25)) { x = p.x; z = p.z; }
    this.mines--;
    if (this.role === 'host') this._addMine(x, p.y, z, this.myId);
    else this.net.send({ t: 'zmine', x: zr2(x), y: zr2(p.y), z: zr2(z) });
    this.audio.shell();
    this._shopChanged();
  }

  onNetMine(m) {
    if (this.role === 'host' && m.from && this.active) this._addMine(+m.x || 0, +m.y || 0, +m.z || 0, m.from | 0);
  }

  _addMine(x, y, z, owner) {
    if (this.mineList.length >= 40) return;
    this.mineList.push({ x, y, z, owner, arm: MINE_ARM });
  }

  _updateMines(dt) {
    for (let i = this.mineList.length - 1; i >= 0; i--) {
      const m = this.mineList[i];
      if (m.arm > 0) { m.arm -= dt; continue; }
      let trip = false;
      for (const e of this.list) {
        if (e.alive && Math.hypot(e.x - m.x, e.z - m.z) < MINE_TRIGGER && Math.abs(e.y - m.y) < 1) { trip = true; break; }
      }
      if (!trip) continue;
      this.mineList.splice(i, 1);
      for (const e of this.list) {
        if (!e.alive) continue;
        const d = Math.hypot(e.x - m.x, e.y + 0.9 - (m.y + 0.3), e.z - m.z);
        if (d < MINE_RADIUS) {
          e.vy = Math.max(e.vy, 5 * (1 - d / MINE_RADIUS));
          this._damage(e, 260 * (1 - d / MINE_RADIUS), false, m.owner);
        }
      }
      this._event({ k: 'boom', x: zr2(m.x), y: zr2(m.y), z: zr2(m.z) });
    }
  }

  /** Draw mines: the host's own list, or a guest's copy from the snapshot ([x, y, z, armed]). */
  _drawMines(rows) {
    if (!this._mineGeo) {
      this._mineGeo = new THREE.CylinderGeometry(0.22, 0.26, 0.07, 10);
      this._mineMat = new THREE.MeshLambertMaterial({ color: 0x3e4630, flatShading: true });
      this._mineLed = new THREE.MeshBasicMaterial({ color: 0xff3020, fog: false });
      this._ledGeo = new THREE.BoxGeometry(0.05, 0.03, 0.05);
    }
    const pool = this._mineMeshes;
    const blink = Math.sin(performance.now() / 160) > 0;
    for (let i = 0; i < rows.length; i++) {
      let m = pool[i];
      if (!m) {
        m = new THREE.Group();
        m.add(new THREE.Mesh(this._mineGeo, this._mineMat));
        const led = new THREE.Mesh(this._ledGeo, this._mineLed);
        led.position.y = 0.05;
        m.add(led);
        m.led = led;
        this.scene.add(m);
        pool.push(m);
      }
      const r = rows[i];
      m.visible = true;
      m.position.set(r[0], r[1] + 0.035, r[2]);
      m.led.visible = !r[3] || blink;
    }
    for (let i = rows.length; i < pool.length; i++) pool[i].visible = false;
  }

  /** Like the soldiers' test, but other zombies do not block: crowds would jam in doorways. */
  _blocked(e, x, y, z) {
    const boxes = this.collision.boxes;
    const minX = x - EN_RADIUS, maxX = x + EN_RADIUS, minZ = z - EN_RADIUS, maxZ = z + EN_RADIUS;
    const minY = y, maxY = y + EN_HEIGHT;
    let hit = false;
    let top = -Infinity;
    for (let i = 0; i < boxes.length; i++) {
      const b = boxes[i];
      if (b === e.box || (b.enemy && b.enemy.sys === this)) continue;
      if (maxX > b.minX && minX < b.maxX && maxY > b.minY && minY < b.maxY && maxZ > b.minZ && minZ < b.maxZ) {
        hit = true;
        if (b.maxY > top) top = b.maxY;
      }
    }
    this._top = top;
    const p = this.player;
    if (Math.hypot(p.x - x, p.z - z) < EN_RADIUS + p.radius + 0.05 && maxY > p.y && minY < p.y + p.height) {
      hit = true;
      this._top = Infinity;
    }
    return hit;
  }

  /** Nudge overlapping zombies apart so a crowd spreads out instead of stacking. */
  _separate(dt) {
    const list = this.list;
    const push = Math.min(1, dt * 6);
    for (let i = 0; i < list.length; i++) {
      const a = list[i];
      if (!a.alive) continue;
      for (let j = i + 1; j < list.length; j++) {
        const b = list[j];
        if (!b.alive || Math.abs(a.y - b.y) > 1) continue;
        let dx = b.x - a.x, dz = b.z - a.z;
        let d = Math.hypot(dx, dz);
        const min = EN_RADIUS * 2;
        if (d >= min) continue;
        if (d < 1e-3) { dx = Math.random() - 0.5; dz = Math.random() - 0.5; d = Math.hypot(dx, dz); }
        const k = ((min - d) / d) * 0.5 * push;
        const ax = a.x - dx * k, az = a.z - dz * k, bx = b.x + dx * k, bz = b.z + dz * k;
        if (!this._blocked(a, ax, a.y + 0.01, az)) { a.x = ax; a.z = az; this._syncBox(a); }
        if (!this._blocked(b, bx, b.y + 0.01, bz)) { b.x = bx; b.z = bz; this._syncBox(b); }
      }
    }
  }

  // --- Model ---------------------------------------------------------------

  _createZombie(runner) {
    const mat = (color) => new THREE.MeshLambertMaterial({ color, emissive: 0x000000, flatShading: true });
    const m = {
      pants: mat(0x3b3a30), shirt: mat(runner ? 0x6e2f28 : 0x56604a), skin: mat(0x7d9a6a), hair: mat(0x2a2620),
    };
    const g = this.geo;
    const root = new THREE.Group();
    root.rotation.order = 'YXZ';
    const add = (parent, geo, material, x, y, z) => {
      const mesh = new THREE.Mesh(geo, material);
      mesh.position.set(x, y, z);
      parent.add(mesh);
      return mesh;
    };
    const legs = [];
    for (const side of [-1, 1]) {
      const hip = new THREE.Group();
      hip.position.set(0.13 * side, 0.9, 0);
      add(hip, g.leg, m.pants, 0, -0.45, 0);
      root.add(hip);
      legs.push(hip);
    }
    const torso = add(root, g.torso, m.shirt, 0, 1.22, -0.04);
    torso.rotation.x = 0.18; // hunched
    const head = add(root, g.head, m.skin, 0, 1.66, -0.1);
    head.rotation.z = 0.2;
    add(root, g.visor, this.eyeMat, 0, 1.69, -0.24);
    add(root, g.helmet, m.hair, 0, 1.82, -0.1).scale.set(0.85, 0.6, 0.85);
    const arms = new THREE.Group();
    arms.position.set(0, 1.45, -0.05);
    for (const side of [-1, 1]) {
      const a = add(arms, g.arm, m.skin, 0.24 * side, -0.02, -0.28);
      a.rotation.x = -1.5;
    }
    root.add(arms);
    root.visible = false;
    this.scene.add(root);

    const e = {
      root, legs, arms, flash: null, mats: Object.values(m), runner,
      id: 0, x: 0, y: 0, z: 0, vy: 0, yaw: 0, onGround: false,
      tx: 0, ty: 0, tz: 0, tyaw: 0,
      hp: 100, speed: 2, alive: false, state: 'walk', box: null,
      deadT: 0, flashT: 0, hurtT: 0, stride: Math.random() * 6, speedNow: 0,
      target: 0, retargetT: 0, atkT: 0.5, groanT: rand(1, 8),
      goalNode: -1, pathT: 0, nextNode: -1, patrolNode: -1,
      strafe: 1, strafeT: 0, stuckT: 0, jumpCd: 0, moveX: 0, moveZ: 0,
      sys: this,
    };
    e.box = { minX: 0, minY: 0, minZ: 0, maxX: 0, maxY: 0, maxZ: 0, enemy: e };
    return e;
  }

  _buildShared() {
    super._buildShared();
    this.eyeMat = new THREE.MeshBasicMaterial({ color: 0xff3a22, fog: false });
  }
}

// ===== js/game/TeamMatch.js =====
const TDM_LIMIT = 50;     // kills to win
const TDM_TIME = 600;     // seconds per match
const TDM_OVER = 10;      // seconds the result stays up
const TDM_SIDE = 5;       // players per team
const TEAM_HEX = [0x3e6fb0, 0xb04a34];
const TEAM_NAME = ['BLUE', 'RED'];
const TM_SNAPSHOT = 0.08; // host -> guests, about 12 per second
const tr2 = (v) => Math.round(v * 100) / 100;

/**
 * 5v5 team deathmatch on the Crash map. Empty places are filled with bots.
 * The host runs the bots and the match (score, timer); guests show the bots as
 * puppets from snapshots and report their own hits.
 *
 * Players: id 1 is the host, 2..10 are guests, bots are 101 and up.
 * team 0 = BLUE, team 1 = RED.
 */
class TeamMatch extends Enemies {
  constructor(opts) {
    super(opts);
    this.net = opts.net;
    this.remotes = opts.remotes;
    this.enabled = false;
    this.active = false;
    this.role = 'host';
    this.myTeam = 0;
    this.scores = [0, 0];
    this.timeLeft = TDM_TIME;
    this.phase = 'play'; // 'play' | 'over'
    this.overT = 0;
    this.winner = -1;
    this.stats = new Map(); // id -> { name, team, k, d }
    this.byId = new Map();
    this.nextBotId = 101;
    this.lastAttacker = null;
    this.lastAttackerT = 0;
    this.onEvent = null;
    this._tl = [];
    this._snapT = 0;
    this._statT = 0;
    this._fillT = 0;
    this._boardT = 0;
    this._buildHud();
  }

  // The soldiers' own spawning does not apply here.
  _syncCount() {}
  noise() {}

  get myId() {
    return this.net.online ? this.net.id : 1;
  }

  teamOf(id) {
    if (id === this.myId) return this.myTeam;
    if (id >= 100) { const e = this.byId.get(id); return e ? e.team : -1; }
    const r = this.remotes.get(id);
    if (r && r.team !== undefined) return r.team;
    return this.net.teams[id] !== undefined ? this.net.teams[id] : -1;
  }

  label(id) {
    if (id >= 100) return 'BOT ' + (id - 100);
    return 'P' + id;
  }

  // --- Mode ----------------------------------------------------------------

  setActive(on, role) {
    if (on === this.active && role === this.role) return;
    this._clearBots();
    this.active = on;
    this.role = role;
    this._hud.root.classList.toggle('on', on);
    this._hud.over.classList.remove('on');
    this._board.classList.remove('on');
    if (on && role === 'host') this._reset(true);
  }

  _clearBots() {
    for (const e of this.list) {
      this._removeBox(e);
      this.scene.remove(e.root);
    }
    this.list = [];
    this.byId.clear();
  }

  _reset(silent) {
    this._clearBots();
    this.scores = [0, 0];
    this.timeLeft = TDM_TIME;
    this.phase = 'play';
    this.winner = -1;
    this.stats.clear();
    this._fillT = 0;
    this._event({ k: 'reset' });
    this._ensureStat(this.myId);
  }

  // --- Roster --------------------------------------------------------------

  _ensureStat(id) {
    let s = this.stats.get(id);
    if (!s) {
      s = { name: this.label(id), team: this.teamOf(id), k: 0, d: 0 };
      this.stats.set(id, s);
    }
    s.team = this.teamOf(id);
    return s;
  }

  _humanIds() {
    const ids = [this.myId];
    for (const [id, r] of this.remotes) if (r.present) ids.push(id);
    return ids;
  }

  /** Host: keep both teams at five by adding or removing bots. */
  _fillTeams() {
    const want = [0, 0];
    if (this.settings.get('fillBots')) {
      const humans = [0, 0];
      for (const id of this._humanIds()) { const t = this.teamOf(id); if (t >= 0) humans[t]++; }
      want[0] = Math.max(0, TDM_SIDE - humans[0]);
      want[1] = Math.max(0, TDM_SIDE - humans[1]);
    }
    for (let t = 0; t < 2; t++) {
      const mine = this.list.filter((e) => e.team === t);
      while (mine.length < want[t]) mine.push(this._addBot(t));
      while (mine.length > want[t]) {
        // Prefer sending a dead bot home.
        let idx = mine.findIndex((e) => !e.alive);
        if (idx < 0) idx = mine.length - 1;
        const e = mine.splice(idx, 1)[0];
        this._removeBot(e);
      }
    }
  }

  _createBot(team) {
    const e = this._createEnemy();
    e.team = team;
    e.mats[0].color.setHex(TEAM_HEX[team]);
    e.mats[1].color.setHex(team === 0 ? 0x24405f : 0x5f2a1f);
    e.goalNode = -1;
    e.target = null;
    e.lastY = 0;
    e.tx = 0; e.ty = 0; e.tz = 0; e.tyaw = 0;
    return e;
  }

  _addBot(team) {
    const e = this._createBot(team);
    e.id = this.nextBotId++;
    this.list.push(e);
    this.byId.set(e.id, e);
    this.stats.set(e.id, { name: this.label(e.id), team, k: 0, d: 0 });
    this._respawnBot(e);
    return e;
  }

  _removeBot(e) {
    this._removeBox(e);
    this.scene.remove(e.root);
    this.byId.delete(e.id);
    this.stats.delete(e.id);
    const i = this.list.indexOf(e);
    if (i >= 0) this.list.splice(i, 1);
  }

  /** Put a bot at its team's spawn waypoint that is farthest from the enemy. */
  _respawnBot(e) {
    const nodes = this.teamSpawnNodes && this.teamSpawnNodes[e.team] ? this.teamSpawnNodes[e.team] : this.spawnNodes;
    this._collectTargets();
    let best = nodes[0], bd = -1;
    for (const i of nodes) {
      const n = this.nodes[i];
      let near = 99;
      for (const t of this._tl) if (t.team !== e.team) near = Math.min(near, Math.hypot(t.x - n.x, t.z - n.z));
      if (this._occupied(n.x, n.z, e)) near -= 20;
      if (near > bd) { bd = near; best = i; }
    }
    const n = this.nodes[best];
    e.x = n.x + rand(-1.5, 1.5);
    e.z = n.z + rand(-1.5, 1.5);
    e.y = n.y + 0.05;
    if (this._blocked(e, e.x, e.y, e.z)) { e.x = n.x; e.z = n.z; }
    e.vy = 0;
    e.yaw = e.team === 0 ? -Math.PI / 2 : Math.PI / 2;
    e.hp = this.difficulty.hp;
    e.alive = true;
    e.state = 'patrol';
    e.sees = false;
    e.target = null;
    e.goalNode = -1;
    e.pathT = 0;
    e.deadT = 0;
    e.burst = this.difficulty.burst;
    e.shotT = 0;
    e.root.visible = true;
    e.root.rotation.set(0, e.yaw, 0);
    for (const mat of e.mats) mat.emissive.setRGB(0, 0, 0);
    this._addBox(e);
  }

  // --- HUD -----------------------------------------------------------------

  _buildHud() {
    const root = document.createElement('div');
    root.id = 'tdmhud';
    root.innerHTML = '<span id="tdm-a"></span><b id="tdm-time"></b><span id="tdm-b"></span><div id="tdm-you"></div>';
    document.body.appendChild(root);
    const over = document.createElement('div');
    over.id = 'tdmover';
    over.innerHTML = '<h2></h2><p id="tdm-over-score"></p><p id="tdm-over-timer"></p>';
    document.body.appendChild(over);
    const board = document.createElement('div');
    board.id = 'tdmboard';
    document.body.appendChild(board);
    this._board = board;
    this._hud = {
      root, over, a: root.querySelector('#tdm-a'), b: root.querySelector('#tdm-b'), time: root.querySelector('#tdm-time'),
      you: root.querySelector('#tdm-you'), overTitle: over.querySelector('h2'), overScore: over.querySelector('#tdm-over-score'),
      overTimer: over.querySelector('#tdm-over-timer'), last: {},
    };
  }

  _setText(el, key, text) {
    if (this._hud.last[key] === text) return;
    this._hud.last[key] = text;
    el.textContent = text;
  }

  _updateHud(dt) {
    const h = this._hud;
    this._setText(h.a, 'a', TEAM_NAME[0] + ' ' + this.scores[0]);
    this._setText(h.b, 'b', TEAM_NAME[1] + ' ' + this.scores[1]);
    const t = Math.max(0, Math.ceil(this.timeLeft));
    this._setText(h.time, 'time', Math.floor(t / 60) + ':' + String(t % 60).padStart(2, '0'));
    this._setText(h.you, 'you', 'YOU: ' + TEAM_NAME[this.myTeam]);
    h.you.style.color = '#' + TEAM_HEX[this.myTeam].toString(16).padStart(6, '0');
    if (this.phase === 'over') {
      this._setText(h.overTitle, 'ot', this.winner < 0 ? 'DRAW' : TEAM_NAME[this.winner] + ' TEAM WINS');
      this._setText(h.overScore, 'os', TEAM_NAME[0] + ' ' + this.scores[0] + '  :  ' + this.scores[1] + ' ' + TEAM_NAME[1]);
      this._setText(h.overTimer, 'ox', 'New match in ' + Math.max(1, Math.ceil(this.overT)));
      h.over.classList.add('on');
    } else {
      h.over.classList.remove('on');
    }
    const show = this.input.scoreHeld || this.phase === 'over' || this.health.dead;
    this._board.classList.toggle('on', show);
    this._boardT -= dt;
    if (show && this._boardT <= 0) {
      this._boardT = 0.4;
      this._renderBoard();
    }
  }

  _renderBoard() {
    const me = this.myId;
    const rows = [[], []];
    for (const [id, s] of this.stats) if (s.team === 0 || s.team === 1) rows[s.team].push([id, s]);
    const col = (team) => {
      rows[team].sort((p, q) => q[1].k - p[1].k || p[1].d - q[1].d);
      let html = '<div class="tb-col"><h3 style="color:#' + TEAM_HEX[team].toString(16).padStart(6, '0') + '">' + TEAM_NAME[team] + ' &middot; ' + this.scores[team] + '</h3>';
      html += '<table><tr><th></th><th>K</th><th>D</th></tr>';
      for (const [id, s] of rows[team]) {
        html += '<tr' + (id === me ? ' class="me"' : '') + '><td>' + (id === me ? 'YOU' : s.name) + '</td><td>' + s.k + '</td><td>' + s.d + '</td></tr>';
      }
      return html + '</table></div>';
    };
    this._board.innerHTML = '<div class="tb-wrap">' + col(0) + col(1) + '</div>';
  }

  // --- Events (host decides, everyone shows) --------------------------------

  _event(ev) {
    ev.sc = this.scores.slice();
    this.handleEvent(ev);
    if (this.net.online) this.net.send(Object.assign({ t: 'tev' }, ev));
  }

  handleEvent(ev) {
    if (ev.sc) this.scores = ev.sc.slice();
    if (ev.k === 'kill') {
      this.ui.feed(ev.a + ' > ' + ev.v);
    } else if (ev.k === 'over') {
      this.phase = 'over';
      this.winner = ev.w;
      this.overT = TDM_OVER;
    } else if (ev.k === 'reset') {
      this.phase = 'play';
      this.winner = -1;
      this.timeLeft = TDM_TIME;
      this._hud.over.classList.remove('on');
      if (this.role === 'guest') { this._clearBots(); this.stats.clear(); }
    }
    if (this.onEvent) this.onEvent(ev);
  }

  // --- Targets and AI (host) ------------------------------------------------

  _collectTargets() {
    const L = this._tl;
    L.length = 0;
    const p = this.player;
    if (!this.health.dead) L.push({ kind: 'h', id: this.myId, team: this.myTeam, x: p.x, y: p.y, z: p.z });
    for (const [id, r] of this.remotes) {
      if (r.present && !r.dead && r.team !== undefined) L.push({ kind: 'h', id, team: r.team, x: r.x, y: r.y, z: r.z });
    }
    for (const e of this.list) if (e.alive) L.push({ kind: 'b', id: e.id, team: e.team, x: e.x, y: e.y, z: e.z, bot: e });
  }

  update(dt) {
    this._updateTracers(dt);
    if (!this.active) return;
    if (this.role === 'host') this._updateHost(dt);
    else this._updateGuest(dt);
    for (const p of this.puffs) {
      if (p.t < 0) continue;
      p.t += dt;
      const k = p.t / 0.35;
      if (k >= 1) { p.t = -1; p.sprite.visible = false; continue; }
      p.sprite.scale.setScalar(0.15 + 0.4 * k);
      p.sprite.material.opacity = 0.9 * (1 - k);
    }
    this._updateHud(dt);
  }

  _updateHost(dt) {
    if (!this.net.online && !this.input.locked) return; // solo: everything waits while the menu is open
    this._collectTargets();
    this._fillT -= dt;
    if (this._fillT <= 0) { this._fillT = 1.5; this._fillTeams(); }

    if (this.phase === 'play') {
      this.timeLeft -= dt;
      if (this.scores[0] >= TDM_LIMIT || this.scores[1] >= TDM_LIMIT || this.timeLeft <= 0) {
        const w = this.scores[0] === this.scores[1] ? -1 : this.scores[0] > this.scores[1] ? 0 : 1;
        this._event({ k: 'over', w });
      }
    } else {
      this.overT -= dt;
      if (this.overT <= 0) this._reset(false);
    }

    for (let i = this.list.length - 1; i >= 0; i--) {
      const e = this.list[i];
      if (!e.alive) { this._updateDeadBot(e, dt); continue; }
      if (this.phase === 'play') this._thinkBot(e, dt);
      else e.speedNow = 0;
      this._physics(e, dt);
      this._animate(e, dt);
    }

    if (this.net.online && this.net.peer) {
      this._snapT -= dt;
      if (this._snapT <= 0) {
        this._snapT = TM_SNAPSHOT;
        this.net.send({
          t: 'tm', sc: this.scores.slice(), tl: Math.ceil(this.timeLeft), ph: this.phase === 'play' ? 0 : 1, w: this.winner,
          b: this.list.map((e) => [e.id, e.team, tr2(e.x), tr2(e.y), tr2(e.z), tr2(e.yaw), e.alive ? (e.flashT > 0 ? 1 : 0) : 2]),
        });
      }
      this._statT -= dt;
      if (this._statT <= 0) {
        this._statT = 1.2;
        for (const id of this._humanIds()) this._ensureStat(id);
        const s = [];
        for (const [id, v] of this.stats) s.push([id, v.name, v.team, v.k, v.d]);
        this.net.send({ t: 'tms', s });
      }
    }
  }

  _pickGoal(e) {
    const goals = [];
    for (let i = 0; i < this.nodes.length; i++) {
      const n = this.nodes[i];
      if (Math.random() < 0.25 || (e.team === 0 ? n.x > 8 : n.x < -8)) goals.push(i);
    }
    return goals.length ? goals[Math.floor(Math.random() * goals.length)] : 0;
  }

  _thinkBot(e, dt) {
    const diff = this.difficulty;
    const ex = e.x, ey = e.y, ez = e.z;

    e.senseT -= dt;
    if (e.senseT <= 0) {
      e.senseT = 0.2;
      let best = null, bd = Infinity;
      for (const t of this._tl) {
        if (t.team === e.team) continue;
        const d = Math.hypot(t.x - ex, t.z - ez);
        if (d >= bd || d > diff.view) continue;
        if (!this._clearNav(ex, ey + EN_EYE, ez, t.x, t.y + 1.45, t.z) && !this._clearNav(ex, ey + EN_EYE, ez, t.x, t.y + 0.7, t.z)) continue;
        best = t;
        bd = d;
      }
      if (best && (!e.target || e.target.id !== best.id)) e.reactT = diff.react * rand(0.8, 1.3);
      e.target = best;
      e.sees = !!best;
      if (best) { e.lastX = best.x; e.lastZ = best.z; e.lastY = best.y; e.lostT = 0; e.state = 'combat'; }
    }
    if (!e.sees && e.state === 'combat') {
      e.lostT += dt;
      if (e.lostT > 0.6) { e.state = 'search'; e.searchT = 8; }
    }
    if (e.state === 'search') {
      e.searchT -= dt;
      if (e.searchT <= 0 || Math.hypot(e.lastX - ex, e.lastZ - ez) < 1.5) { e.state = 'patrol'; e.goalNode = -1; }
    }

    let tx = ex, tz = ez, speed = 0, face = null;
    const t = e.target;
    if (e.state === 'combat' && t) {
      const dxp = t.x - ex, dzp = t.z - ez;
      const dist = Math.hypot(dxp, dzp);
      face = Math.atan2(-dxp, -dzp);
      e.strafeT -= dt;
      if (e.strafeT <= 0) { e.strafe = Math.random() < 0.5 ? -1 : 1; e.strafeT = rand(0.8, 2); }
      const nx = dist > 0 ? dxp / dist : 0, nz = dist > 0 ? dzp / dist : 0;
      let mx = -nz * e.strafe, mz = nx * e.strafe;
      if (dist > 16) { mx = nx; mz = nz; }
      else if (dist < 5) { mx = -nx * 0.8 + mx * 0.6; mz = -nz * 0.8 + mz * 0.6; }
      tx = ex + mx; tz = ez + mz;
      speed = diff.speed * (dist > 16 ? 0.95 : 0.6);
      this._shootBot(e, dt, t, dist);
    } else if (e.state === 'search') {
      const goal = this._goalPoint(e, e.lastX, e.lastZ, dt, e.lastY || 0);
      tx = goal.x; tz = goal.z;
      speed = diff.speed * 0.9;
    } else {
      if (e.goalNode < 0 || Math.hypot(this.nodes[e.goalNode].x - ex, this.nodes[e.goalNode].z - ez) < 1.8) e.goalNode = this._pickGoal(e);
      const n = this.nodes[e.goalNode];
      const goal = this._goalPoint(e, n.x, n.z, dt, n.y);
      tx = goal.x; tz = goal.z;
      speed = diff.speed * 0.85;
    }

    const mx = tx - ex, mz = tz - ez;
    const ml = Math.hypot(mx, mz);
    if (ml > 0.05 && speed > 0) {
      e.moveX = mx / ml; e.moveZ = mz / ml;
      e.speedNow = speed;
      if (face === null) face = Math.atan2(-e.moveX, -e.moveZ);
    } else {
      e.speedNow = 0;
    }
    if (face !== null) {
      let d = face - e.yaw;
      d = Math.atan2(Math.sin(d), Math.cos(d));
      e.yaw += d * Math.min(1, dt * 8);
    }
  }

  _shootBot(e, dt, t, dist) {
    const diff = this.difficulty;
    e.reactT -= dt;
    if (e.reactT > 0) return;
    e.shotT -= dt;
    if (e.shotT > 0) return;
    if (e.burst <= 0) {
      e.burst = diff.burst;
      e.shotT = rand(diff.pause[0], diff.pause[1]);
      return;
    }
    e.burst--;
    e.shotT = 0.12;
    const chance = diff.acc * Math.max(0.3, Math.min(1.15, 1.25 - dist / 32));
    const hit = Math.random() < chance;
    const s = Math.sin(e.yaw), c = Math.cos(e.yaw);
    const mx = e.x - s * 0.86 + c * 0.08, my = e.y + 1.32, mz = e.z - c * 0.86 - s * 0.08;
    let ax = t.x, ay = t.y + 1.0, az = t.z;
    if (!hit) { ax += rand(-1, 1) * 0.9; ay += rand(-0.6, 0.8); az += rand(-1, 1) * 0.9; }
    this._tracer(mx, my, mz, ax, ay, az);
    e.flash.visible = true;
    e.flash.rotation.z = Math.random() * 3;
    e.flashT = 0.05;
    const p = this.player;
    const vol = Math.max(0.1, 0.7 / (1 + Math.hypot(p.x - e.x, p.z - e.z) * 0.12));
    this.audio.shot('ak', vol);
    if (hit) this._hurt(t, diff.dmg * rand(0.85, 1.15), e);
  }

  /** A bot's bullet hit target t. */
  _hurt(t, dmg, bot) {
    if (t.kind === 'b') {
      this._damageBot(t.bot, dmg, { k: 'b', id: bot.id, team: bot.team });
    } else if (t.id === this.myId) {
      this.noteAttacker({ k: 'b', id: bot.id, team: bot.team });
      this.hurtLocal(dmg, bot.x, bot.z);
    } else {
      this.net.send({ t: 'bdmg', to: t.id, dmg: Math.round(dmg), x: tr2(bot.x), z: tr2(bot.z), b: bot.id, bt: bot.team });
    }
  }

  noteAttacker(info) {
    this.lastAttacker = info;
    this.lastAttackerT = performance.now();
  }

  /** A bullet hit me (host: from a bot; guests: told by the host). */
  hurtLocal(dmg, x, z) {
    if (!this.input.locked && !this.net.online) return;
    const applied = this.health.damage(dmg, 'bot', 'bot');
    if (applied <= 0) return;
    const p = this.player;
    this.ui.damageDir(Math.atan2(x - p.x, z - p.z) - (p.yaw + Math.PI));
    this.audio.hurt();
  }

  /** My own death: tell the host who did it so the score is right. */
  reportDeath() {
    const recent = this.lastAttacker && performance.now() - this.lastAttackerT < 8000;
    const by = recent ? this.lastAttacker : null;
    this.lastAttacker = null;
    this.ui.killedBy = by ? 'KILLED BY ' + this.label(by.id) : '';
    if (this.net.online) this.net.send({ t: 'died', by });
    else this.onDied({ from: 1, by });
  }

  /** Host: a human died. m: { from, by: { k: 'h' | 'b', id, team } | null }. */
  onDied(m) {
    if (!this.active || this.role !== 'host' || this.phase !== 'play') return;
    const v = m.from | 0;
    this._ensureStat(v).d++;
    let team = -1;
    let a = 'THE MAP';
    const by = m.by;
    if (by && by.k === 'h' && by.id !== v) {
      team = this.teamOf(by.id);
      a = this.label(by.id);
      this._ensureStat(by.id).k++;
    } else if (by && by.k === 'b') {
      team = by.team | 0;
      a = this.label(by.id);
      const s = this.stats.get(by.id);
      if (s) s.k++;
    }
    if (team === 0 || team === 1) this.scores[team]++;
    this._event({ k: 'kill', a, v: this.label(v), t: team });
  }

  _updateDeadBot(e, dt) {
    e.deadT += dt;
    const fall = Math.min(1, e.deadT / 0.45);
    e.root.rotation.x = (Math.PI / 2) * fall * fall;
    e.root.position.set(e.x, e.deadT > 3 ? e.y - (e.deadT - 3) * 0.6 : e.y, e.z);
    if (e.deadT > 4.5) e.root.visible = false;
    e.respawnT -= dt;
    if (e.respawnT <= 0 && this.phase === 'play') {
      e.root.rotation.x = 0;
      this._respawnBot(e);
    }
  }

  // --- Damage --------------------------------------------------------------

  /** The local player's bullet hit a bot (the weapon lets shots pass through allies). */
  bulletHit(box, hit, damage, headMul) {
    const e = box && box.enemy;
    if (!e || !e.alive || e.team === this.myTeam) return false;
    const head = enemyHeadHit(e, hit);
    const dmg = damage * (head ? headMul : 1);
    this._puff(hit.x, hit.y, hit.z);
    if (this.role === 'host') {
      this._damageBot(e, dmg, { k: 'h', id: this.myId, team: this.myTeam }, head);
      this.ui.hitMarker(head || e.hp <= 0);
      this.audio.hitmarker(e.hp <= 0);
    } else {
      this.net.send({ t: 'bhit', b: e.id, dmg: Math.round(dmg), head: head ? 1 : 0 });
      this.ui.hitMarker(head);
      this.audio.hitmarker(false);
    }
    return true;
  }

  /** Host: a guest's bullet hit a bot. */
  onNetHit(m) {
    if (this.role !== 'host' || !this.active) return;
    const e = this.byId.get(m.b);
    const from = m.from | 0;
    if (!e || !e.alive || typeof m.dmg !== 'number' || e.team === this.teamOf(from)) return;
    this._damageBot(e, m.head ? HEAD_ONE_SHOT * 100 : Math.min(300, Math.max(0, m.dmg)), { k: 'h', id: from, team: this.teamOf(from) }, !!m.head);
  }

  _damageBot(e, dmg, by, head) {
    if (!e.alive || this.phase !== 'play') return;
    e.hp -= dmg;
    e.hurtT = 0.12;
    // Being shot gives the shooter away.
    if (by.k === 'h') {
      const pos = by.id === this.myId ? this.player : this.remotes.get(by.id);
      if (pos && e.state !== 'combat') { e.lastX = pos.x; e.lastZ = pos.z; e.lastY = pos.y; e.state = 'search'; e.searchT = 8; e.pathT = 0; }
    }
    if (e.hp <= 0) this._killBot(e, by, head);
  }

  _killBot(e, by, head) {
    e.alive = false;
    e.deadT = 0;
    e.respawnT = 5;
    e.flash.visible = false;
    for (const m of e.mats) m.emissive.setRGB(0, 0, 0);
    this._removeBox(e);
    const vs = this.stats.get(e.id);
    if (vs) vs.d++;
    const ks = by.k === 'h' ? this._ensureStat(by.id) : this.stats.get(by.id);
    if (ks) ks.k++;
    const team = by.k === 'h' ? this.teamOf(by.id) : by.team;
    if (team === 0 || team === 1) this.scores[team]++;
    this._event({ k: 'kill', a: this.label(by.id), v: this.label(e.id), t: team });
  }

  _explosion(x, y, z, radius, owner) {
    if (!this.active || this.role !== 'host' || owner === 'mine') return;
    const r = radius * 0.8;
    const id = owner === 'me' ? this.myId : this.explosions.ownerId || 0;
    const team = id ? this.teamOf(id) : -1;
    for (const e of this.list) {
      if (!e.alive || (team >= 0 && e.team === team)) continue;
      const d = Math.hypot(e.x - x, e.y + 0.9 - y, e.z - z);
      if (d < r) {
        e.vy = Math.max(e.vy, 4 * (1 - d / r));
        this._damageBot(e, 200 * (1 - d / r), id ? { k: 'h', id, team } : { k: 'b', id: 0, team: -1 });
      }
    }
  }

  // --- Guest: puppets from snapshots ---------------------------------------

  applySnapshot(m) {
    if (!this.active || this.role !== 'guest') return;
    this.scores = m.sc.slice();
    this.timeLeft = m.tl;
    this.phase = m.ph === 0 ? 'play' : 'over';
    this.winner = m.w;
    const seen = new Set();
    for (const row of m.b || []) {
      const [id, team, x, y, z, yaw, st] = row;
      seen.add(id);
      let e = this.byId.get(id);
      if (!e) {
        if (st === 2) continue;
        e = this._createBot(team);
        e.id = id;
        e.x = e.tx = x; e.y = e.ty = y; e.z = e.tz = z; e.yaw = e.tyaw = yaw;
        e.alive = true;
        e.root.visible = true;
        this._addBox(e);
        this.list.push(e);
        this.byId.set(id, e);
      }
      e.tx = x; e.ty = y; e.tz = z; e.tyaw = yaw;
      if (st === 1) { e.flash.visible = true; e.flashT = 0.05; e.flash.rotation.z = Math.random() * 3; }
      if (st === 2 && e.alive) { e.alive = false; e.deadT = 0; this._removeBox(e); }
      if (st !== 2 && !e.alive) {
        // Respawned: stand up again.
        e.alive = true; e.deadT = 0; e.root.rotation.x = 0; e.root.visible = true;
        e.x = x; e.y = y; e.z = z;
        this._addBox(e);
      }
    }
    for (let i = this.list.length - 1; i >= 0; i--) {
      const e = this.list[i];
      if (!seen.has(e.id)) this._removeBot(e);
    }
  }

  applyStats(m) {
    if (this.role !== 'guest') return;
    this.stats = new Map((m.s || []).map((r) => [r[0], { name: r[1], team: r[2], k: r[3], d: r[4] }]));
    const mine = this.stats.get(this.myId);
    if (mine) this.ui.setKills(mine.k);
  }

  _updateGuest(dt) {
    const k = Math.min(1, dt * 12);
    for (let i = this.list.length - 1; i >= 0; i--) {
      const e = this.list[i];
      if (!e.alive) { this._updateDeadBot(e, dt); continue; }
      const ox = e.x, oz = e.z;
      e.x += (e.tx - e.x) * k;
      e.y += (e.ty - e.y) * k;
      e.z += (e.tz - e.z) * k;
      let d = e.tyaw - e.yaw;
      d = Math.atan2(Math.sin(d), Math.cos(d));
      e.yaw += d * k;
      e.speedNow = dt > 0 ? Math.hypot(e.x - ox, e.z - oz) / dt : 0;
      e.onGround = true;
      e.state = 'combat';
      this._syncBox(e);
      this._animate(e, dt);
    }
  }

  _animate(e, dt) {
    super._animate(e, dt);
    // Aim the rifle at the bot's own target, not at the local player.
    const t = e.target;
    let pitch = 0;
    if (t && e.state === 'combat') {
      const d = Math.hypot(t.x - e.x, t.z - e.z);
      pitch = Math.atan2(t.y + 1.0 - (e.y + 1.35), Math.max(0.5, d));
    }
    e.arms.rotation.x = pitch;
  }

  /** Called every frame while playing: my kills on the HUD (host: from the stats). */
  syncKills() {
    const s = this.stats.get(this.myId);
    this.ui.setKills(s ? s.k : 0);
  }
}

// ===== js/input/TouchControls.js =====
const TOUCH_LOOK_SCALE = 1.4;
const TOUCH_LAYOUT_KEY = 'retrofps.touchLayout';  // finger pixels -> look pixels at touch sensitivity 1
const STICK_RADIUS = 56;       // px at button size 100%
const STICK_DEADZONE = 0.15;

/**
 * On-screen controls in the style of mobile shooters: move stick with sprint
 * lock (left), drag-to-look (right), fire / aim / jump / duck / reload / grenade
 * buttons and an optional left fire button. Drives the same Input hooks as a
 * keyboard and mouse. Pointer events, so a mouse works too when pointer lock
 * is unavailable.
 */
class TouchControls {
  constructor(input, settings, player) {
    this.input = input;
    this.settings = settings;
    this.player = player;
    this._aim = false;
    this._fireCount = 0;
    this._sprintLocked = false;
    this._lockArmed = false;
    this._radius = STICK_RADIUS;

    const root = document.createElement('div');
    root.id = 'touch';
    root.innerHTML = [
      '<div class="tc-zone" id="tc-move"></div>',
      '<div class="tc-zone" id="tc-look"></div>',
      '<div id="tc-stick" class="idle"><i></i></div>',
      '<div id="tc-lock">LOCK</div>',
      '<div id="tc-rotate">Rotate your device to landscape</div>',
      '<div id="tc-pause" role="button">II</div>',
      '<div id="tc-shop" class="zonly" role="button">SHOP</div>',
      '<div id="tc-editbar"><span>Drag the buttons, the joystick, the health bar and the ammo display where you want them.</span>' +
        '<button type="button" id="tc-reset">RESET</button><button type="button" id="tc-done">DONE</button></div>',
      '<div class="tc-btn tc-lfire" role="button">FIRE</div>',
      '<div id="tc-btns">',
      '<div class="tc-btn tc-fire" role="button">FIRE</div>',
      '<div class="tc-btn tc-aim" role="button">AIM</div>',
      '<div class="tc-btn tc-jump" role="button">JUMP</div>',
      '<div class="tc-btn tc-crouch" role="button">DUCK</div>',
      '<div class="tc-btn tc-reload" role="button">RELOAD</div>',
      '<div class="tc-btn tc-grenade" role="button">NADE</div>',
      '<div class="tc-btn tc-mine zonly" role="button">MINE</div>',
      '</div>',
    ].join('');
    document.body.appendChild(root);
    this.root = root;

    this.stick = root.querySelector('#tc-stick');
    this.knob = this.stick.querySelector('i');
    this.lockEl = root.querySelector('#tc-lock');
    this.aimEl = root.querySelector('.tc-aim');
    this.duckEl = root.querySelector('.tc-crouch');
    this.lfireEl = root.querySelector('.tc-lfire');

    this.btns = root.querySelector('#tc-btns');
    // Buttons that can be moved in the layout editor (settings > touch).
    this.movable = {
      fire: root.querySelector('.tc-fire'), aim: this.aimEl, jump: root.querySelector('.tc-jump'),
      crouch: this.duckEl, reload: root.querySelector('.tc-reload'), grenade: root.querySelector('.tc-grenade'),
      mine: root.querySelector('.tc-mine'), lfire: this.lfireEl, pause: root.querySelector('#tc-pause'),
      shop: root.querySelector('#tc-shop'),
      hud: document.getElementById('hud'),
      health: document.getElementById('health'),
    };
    for (const [key, el] of Object.entries(this.movable)) {
      el.dataset.key = key;
      el.dataset.home = key === 'hud' || key === 'health' ? 'body' : el.parentNode === this.btns ? 'btns' : 'root';
      const w = parseFloat(getComputedStyle(el).width);
      if (w && key !== 'pause' && key !== 'shop') el.dataset.base = String(w);
    }
    this.layout = TouchControls.loadLayout();
    this.editing = false;
    this._drag = null;
    this._bindEditor();

    this._bindMove(root.querySelector('#tc-move'));
    this._bindLook(root.querySelector('#tc-look'));

    const look = (dx, dy) => this._look(dx, dy);
    const fireDown = () => {
      this._unlockSprint(); // shooting ends a locked sprint
      this._fireCount++;
      input.setFire(true);
    };
    const fireUp = () => {
      this._fireCount = Math.max(0, this._fireCount - 1);
      if (this._fireCount === 0) input.setFire(false);
    };
    // Holding fire and sliding the same finger also turns the view.
    this._button(root.querySelector('.tc-fire'), fireDown, fireUp, look);
    this._button(this.lfireEl, fireDown, fireUp, look);
    this._button(root.querySelector('.tc-jump'), () => input.pressJump());
    this._button(root.querySelector('.tc-reload'), () => input.pressReload());
    this._button(root.querySelector('.tc-grenade'), () => input.pressGrenade());
    this._button(this.duckEl, () => input.toggleCrouch());
    this._button(this.aimEl, () => {
      this._unlockSprint();
      if (settings.get('holdAim')) {
        this._aim = true;
      } else {
        this._aim = !this._aim;
      }
      input.setAim(this._aim);
    }, () => {
      if (settings.get('holdAim')) {
        this._aim = false;
        input.setAim(false);
      }
    }, look);
    this._button(root.querySelector('#tc-pause'), () => input.pause(), null, null, true);
    this._button(root.querySelector('#tc-shop'), () => input.pressShop(), null, null, true);
    this._button(root.querySelector('.tc-mine'), () => input.pressMine());

    // iOS Safari ignores user-scalable=no; stop pinch-zoom gestures.
    document.addEventListener('gesturestart', (e) => e.preventDefault());
    window.addEventListener('resize', () => {
      this._applyLayout();
      if (this.stick.classList.contains('idle')) this._idleStick();
    });
    settings.onChange(() => this._apply());
    this._apply();
  }

  // --- Layout editor ---------------------------------------------------------

  static loadLayout() {
    try {
      const v = JSON.parse(localStorage.getItem(TOUCH_LAYOUT_KEY) || '{}');
      return v && typeof v === 'object' ? v : {};
    } catch (_) {
      return {};
    }
  }

  _saveLayout() {
    try { localStorage.setItem(TOUCH_LAYOUT_KEY, JSON.stringify(this.layout)); } catch (_) { /* ignore */ }
  }

  /** The cluster's own scale on small screens (matches the CSS media queries). */
  _clusterScale() {
    const h = window.innerHeight;
    return h <= 340 ? 0.7 : h <= 420 ? 0.85 : 1;
  }

  /** Put every button at its saved spot, or back in its default place. */
  _applyLayout() {
    const bs = this.settings.get('buttonSize');
    const k = this._clusterScale();
    for (const [key, el] of Object.entries(this.movable)) {
      const pos = this.layout[key];
      const base = Number(el.dataset.base) || 0;
      if (el.dataset.home === 'body') {
        // HUD blocks stay where they are in the page; only their position changes.
        el.classList.toggle('hud-custom', !!pos);
        el.style.left = pos ? (pos.x * 100).toFixed(2) + '%' : '';
        el.style.top = pos ? (pos.y * 100).toFixed(2) + '%' : '';
        continue;
      }
      if (pos) {
        if (el.parentNode !== this.root) this.root.appendChild(el); // out of the scaled cluster
        el.classList.add('custom');
        el.style.left = (pos.x * 100).toFixed(2) + '%';
        el.style.top = (pos.y * 100).toFixed(2) + '%';
        if (base) el.style.width = el.style.height = Math.round(base * bs * (el.dataset.home === 'btns' ? k : 1)) + 'px';
      } else {
        el.classList.remove('custom');
        el.style.left = el.style.top = '';
        if (el.dataset.home === 'btns') {
          if (el.parentNode !== this.btns) this.btns.appendChild(el);
          el.style.width = el.style.height = '';
        } else if (base) {
          el.style.width = el.style.height = Math.round(base * bs) + 'px';
        }
      }
    }
  }

  /** Show the controls with drag handles; `onDone` runs when the player presses DONE. */
  startEdit(onDone) {
    this.editing = true;
    this._onEditDone = onDone;
    this.root.classList.add('on', 'editing');
    document.body.classList.add('tc-editing', 'touch'); // touch layout: the HUD clears the buttons
    this._applyLayout();
    this._idleStick();
  }

  _finishEdit() {
    this.editing = false;
    this._drag = null;
    this.root.classList.remove('editing');
    document.body.classList.remove('tc-editing');
    this.sync();
    const cb = this._onEditDone;
    this._onEditDone = null;
    if (cb) cb();
  }

  _bindEditor() {
    const root = this.root;
    root.querySelector('#tc-done').addEventListener('click', () => this._finishEdit());
    root.querySelector('#tc-reset').addEventListener('click', () => {
      this.layout = {};
      this._saveLayout();
      this._applyLayout();
      this._idleStick();
    });
    // Pick whatever is under the finger / cursor, by position: the HUD sits outside the controls.
    window.addEventListener('pointerdown', (e) => {
      if (!this.editing || this._drag) return;
      if (e.target.closest && e.target.closest('#tc-editbar')) return;
      e.preventDefault();
      e.stopPropagation();
      let key = null, bestArea = Infinity;
      for (const [k, el] of Object.entries(this.movable)) {
        const r = el.getBoundingClientRect();
        if (!r.width || !r.height) continue;
        const pad = 6;
        if (e.clientX < r.left - pad || e.clientX > r.right + pad || e.clientY < r.top - pad || e.clientY > r.bottom + pad) continue;
        const area = r.width * r.height;
        if (area < bestArea) { bestArea = area; key = k; }
      }
      if (!key) {
        const h = this._home();
        if (Math.hypot(e.clientX - h.x, e.clientY - h.y) < this._radius * 1.2) key = 'stick';
      }
      if (!key) return;
      this._drag = { id: e.pointerId, key };
      this._dragTo(e);
    }, true);
    window.addEventListener('pointermove', (e) => {
      if (this._drag && e.pointerId === this._drag.id) this._dragTo(e);
    });
    const end = (e) => {
      if (!this._drag || e.pointerId !== this._drag.id) return;
      this._drag = null;
      this._saveLayout();
    };
    window.addEventListener('pointerup', end);
    window.addEventListener('pointercancel', end);
  }

  _dragTo(e) {
    const x = Math.min(0.97, Math.max(0.03, e.clientX / window.innerWidth));
    const y = Math.min(0.97, Math.max(0.03, e.clientY / window.innerHeight));
    this.layout[this._drag.key] = { x, y };
    if (this._drag.key === 'stick') this._idleStick();
    else this._applyLayout();
  }

  /** Call whenever the playing state changes. */
  sync() {
    if (this.editing) return;
    const on = this.input.overlay;
    this.root.classList.toggle('on', on);
    document.body.classList.toggle('touch', on);
    this._aim = false;
    this._fireCount = 0;
    this._sprintLocked = false;
    this._lockArmed = false;
    this.input.setVirtualMove(0, 0);
    this.input.setVirtualSprint(false);
    if (on) this._idleStick();
  }

  /** Per frame: keep button highlights in step with the game state. */
  update() {
    if (!this.input.overlay) return;
    this.duckEl.classList.toggle('on', this.input.crouchToggled || this.player.sliding);
    this.aimEl.classList.toggle('on', this.input.aimHeld);
  }

  _apply() {
    const st = this.settings;
    const bs = st.get('buttonSize');
    this.root.style.setProperty('--bs', String(bs));
    this.root.style.setProperty('--bo', String(st.get('buttonOpacity')));
    this._radius = STICK_RADIUS * bs;
    const ring = Math.round(112 * bs) + 'px';
    const knob = Math.round(48 * bs) + 'px';
    const lock = Math.round(56 * bs) + 'px';
    const lfire = Math.round(72 * bs) + 'px';
    this.stick.style.width = this.stick.style.height = ring;
    this.knob.style.width = this.knob.style.height = knob;
    this.lockEl.style.width = this.lockEl.style.height = lock;
    this.lfireEl.style.display = st.get('leftFire') || this.editing ? '' : 'none';
    if (this.movable) this._applyLayout();
    else this.lfireEl.style.width = this.lfireEl.style.height = lfire;
    if (!st.get('sprintLock')) this._unlockSprint();
    if (!st.get('holdAim')) this._aim = this.input._aimTouch;
    if (this.stick.classList.contains('idle')) this._idleStick();
  }

  _look(dx, dy) {
    const k = TOUCH_LOOK_SCALE * this.settings.get('touchSensitivity') / this.settings.get('sensitivity');
    this.input.addLook(dx * k, dy * k);
  }

  _home() {
    const s = this.layout && this.layout.stick;
    if (s) return { x: s.x * window.innerWidth, y: s.y * window.innerHeight };
    const r = this._radius;
    return { x: 30 + r * 1.15, y: window.innerHeight - 30 - r * 1.15 };
  }

  _lockPos(ox, oy) {
    return { x: ox, y: oy - this._radius * 2.6 };
  }

  _setKnob(dx, dy) {
    this.knob.style.transform =
      'translate(calc(-50% + ' + dx.toFixed(1) + 'px), calc(-50% + ' + dy.toFixed(1) + 'px))';
  }

  _placeLock(x, y, show) {
    this.lockEl.style.left = x + 'px';
    this.lockEl.style.top = y + 'px';
    this.lockEl.classList.toggle('show', show);
  }

  /** Stick at rest (or showing a locked sprint). */
  _idleStick() {
    const h = this._home();
    this.stick.classList.add('idle');
    this.stick.style.left = h.x + 'px';
    this.stick.style.top = h.y + 'px';
    this._setKnob(0, this._sprintLocked ? -this._radius : 0);
    const l = this._lockPos(h.x, h.y);
    this.lockEl.classList.remove('armed');
    this.lockEl.classList.toggle('locked', this._sprintLocked);
    this.lockEl.textContent = this._sprintLocked ? 'RUN' : 'LOCK';
    this._placeLock(l.x, l.y, this._sprintLocked);
  }

  _unlockSprint() {
    if (!this._sprintLocked) return;
    this._sprintLocked = false;
    this.input.setVirtualMove(0, 0);
    this.input.setVirtualSprint(false);
    if (this.stick.classList.contains('idle')) this._idleStick();
  }

  _bindMove(zone) {
    const input = this.input;
    let id = null, ox = 0, oy = 0;

    const moveTo = (x, y) => {
      const r = this._radius;
      const dx = x - ox;
      const dy = y - oy;
      const len = Math.hypot(dx, dy);
      const clamped = Math.min(len, r);
      const nx = len > 0 ? dx / len : 0;
      const ny = len > 0 ? dy / len : 0;
      this._setKnob(nx * clamped, ny * clamped);
      const mag = Math.max(0, (clamped / r - STICK_DEADZONE) / (1 - STICK_DEADZONE));
      input.setVirtualMove(nx * mag, -ny * mag);
      // Pull the finger past the ring while pushing forward to sprint.
      const sprinting = len > r * 1.2 && -ny > 0.5;
      input.setVirtualSprint(sprinting);

      if (this.settings.get('sprintLock')) {
        const l = this._lockPos(ox, oy);
        this._lockArmed = Math.hypot(x - l.x, y - l.y) < r * 0.75;
        this.lockEl.classList.toggle('armed', this._lockArmed);
        this.lockEl.textContent = 'LOCK';
        this._placeLock(l.x, l.y, sprinting || this._lockArmed);
      }
    };

    const end = (e) => {
      if (e.pointerId !== id) return;
      id = null;
      if (this._lockArmed && this.settings.get('sprintLock')) {
        // Let go on the lock: keep sprinting forward hands-free.
        this._sprintLocked = true;
        input.setVirtualMove(0, 1);
        input.setVirtualSprint(true);
      } else {
        input.setVirtualMove(0, 0);
        input.setVirtualSprint(false);
      }
      this._lockArmed = false;
      this._idleStick();
    };

    zone.addEventListener('pointerdown', (e) => {
      if (id !== null || e.pointerType === 'mouse') return;
      id = e.pointerId;
      try { zone.setPointerCapture(id); } catch (_) { /* ignore */ }
      // Touching the stick again cancels a locked sprint.
      this._sprintLocked = false;
      this.lockEl.classList.remove('locked');
      if (this.settings.get('fixedStick')) {
        const h = this._home();
        ox = h.x;
        oy = h.y;
      } else {
        ox = e.clientX;
        oy = e.clientY;
      }
      this.stick.classList.remove('idle');
      this.stick.style.left = ox + 'px';
      this.stick.style.top = oy + 'px';
      moveTo(e.clientX, e.clientY);
      e.preventDefault();
    });
    zone.addEventListener('pointermove', (e) => {
      if (e.pointerId !== id) return;
      moveTo(e.clientX, e.clientY);
    });
    zone.addEventListener('pointerup', end);
    zone.addEventListener('pointercancel', end);
    zone.addEventListener('lostpointercapture', end);
  }

  _bindLook(zone) {
    let id = null, lx = 0, ly = 0;
    const end = (e) => { if (e.pointerId === id) id = null; };
    zone.addEventListener('pointerdown', (e) => {
      if (id !== null || e.pointerType === 'mouse') return;
      id = e.pointerId;
      lx = e.clientX;
      ly = e.clientY;
      try { zone.setPointerCapture(id); } catch (_) { /* ignore */ }
      e.preventDefault();
    });
    zone.addEventListener('pointermove', (e) => {
      if (e.pointerId !== id) return;
      this._look(e.clientX - lx, e.clientY - ly);
      lx = e.clientX;
      ly = e.clientY;
    });
    zone.addEventListener('pointerup', end);
    zone.addEventListener('pointercancel', end);
    zone.addEventListener('lostpointercapture', end);
  }

  _button(el, down, up, move, allowMouse) {
    let id = null, lx = 0, ly = 0;
    const end = (e) => {
      if (e.pointerId !== id) return;
      id = null;
      el.classList.remove('down');
      if (up) up();
    };
    el.addEventListener('pointerdown', (e) => {
      if (id !== null) return;
      if (e.pointerType === 'mouse' && !allowMouse) return;
      id = e.pointerId;
      lx = e.clientX;
      ly = e.clientY;
      try { el.setPointerCapture(id); } catch (_) { /* ignore */ }
      el.classList.add('down');
      down();
      e.preventDefault();
    });
    el.addEventListener('pointermove', (e) => {
      if (e.pointerId !== id || !move) return;
      move(e.clientX - lx, e.clientY - ly);
      lx = e.clientX;
      ly = e.clientY;
    });
    el.addEventListener('pointerup', end);
    el.addEventListener('pointercancel', end);
    el.addEventListener('lostpointercapture', end);
  }
}

// ===== js/main.js =====
const SEND_INTERVAL = 0.05; // 20 state messages per second
const r2 = (v) => Math.round(v * 100) / 100;
const REMOTE_COLORS = { 1: 0x6b3a2a, 2: 0x2a4f6b, 3: 0x6b5f2a };
const MODE_KEY = 'retrofps.mode';
const MAP_KEY = 'retrofps.map';
const LOADOUT_KEY = 'retrofps.loadout';

function boot() {
  const canvas = document.getElementById('game');

  const settings = new Settings();
  const engine = new Engine(canvas, settings);
  const input = new Input(canvas);
  input.settings = settings;
  input.onAimSens = (v) => { if (ui) ui.feed('AIM SENSITIVITY ' + v.toFixed(2) + 'x'); };
  let mapSize = (() => { try { return localStorage.getItem(MAP_KEY); } catch (_) { return null; } })();
  engine.outdoor = false;
  if (!MAP_SIZES.includes(mapSize)) mapSize = 'middle';
  const world = new World(engine.scene, mapSize);
  world.onFog = (outdoor) => { engine.outdoor = outdoor; engine._applyDistance(); };
  const player = new Player({
    camera: engine.camera,
    input,
    collision: world.collision,
    settings,
    spawn: world.spawn,
  });
  let barrels = null; // created below; weapons only call them at runtime
  let ui = null;
  let enemies = null;
  let zombies = null;
  let tdm = null;
  const net = new Net();

  // Other players, by id. Created on demand.
  const remotes = new Map();
  const remoteFor = (id) => {
    let r = remotes.get(id);
    if (!r) {
      r = new RemotePlayer(engine.scene, null, REMOTE_COLORS[id]);
      remotes.set(id, r);
    }
    return r;
  };
  // Shooting targets: every other player in a 1v1 (no friendly fire in co-op).
  const targets = {
    head: false,
    lastId: 0,
    get active() {
      if (zombies && zombies.active) return false;
      for (const r of remotes.values()) if (r.active && !(tdm && tdm.active && r.team === tdm.myTeam)) return true;
      return false;
    },
    raycast(ox, oy, oz, dx, dy, dz, max) {
      let best = -1;
      for (const [id, r] of remotes) {
        if (!r.active) continue;
        if (tdm && tdm.active && r.team === tdm.myTeam) continue; // no friendly fire
        const d = r.raycast(ox, oy, oz, dx, dy, dz, best < 0 ? max : best);
        if (d >= 0 && (best < 0 || d < best)) { best = d; this.head = r.head; this.lastId = id; }
      }
      return best;
    },
  };

  let projectiles = null;
  let stepDist = 0;
  const weapons = new WeaponManager({
    engine, input, player, collision: world.collision, settings,
    onHit: (box, chance) => barrels.hit(box, chance),
    targets,
    onShoot: (slot, impact) => {
      net.send({ t: 'shot', w: slot, i: impact ? impact.map(r2) : null });
      if (enemies) enemies.noise();
    },
    onTargetHit: (dmg, head) => {
      net.send({ t: 'hit', to: targets.lastId, dmg, head: head ? 1 : 0 });
      ui.hitMarker(head);
      weapons.audio.pickup();
    },
    // Soldiers and zombies are both boxes in the collision world.
    onEnemyHit: (box, hit, damage, headMul) => box.enemy.sys.bulletHit(box, hit, damage, headMul),
    onProjectile: (spec, x, y, z, dx, dy, dz) => {
      if (!projectiles) return;
      projectiles.launch('me', spec.projectile, x, y, z, dx, dy, dz);
      net.send({ t: 'proj', w: weapons.active.slot, x: r2(x), y: r2(y), z: r2(z), dx: r2(dx), dy: r2(dy), dz: r2(dz) });
    },
  });
  const explosions = new Explosions({
    scene: engine.scene, player, collision: world.collision, effects: weapons.effects, audio: weapons.audio, settings,
  });
  projectiles = new Projectiles({ scene: engine.scene, collision: world.collision, explosions, audio: weapons.audio, targets });
  const grenades = new GrenadeSystem({ engine, input, player, collision: world.collision, weapons, explosions });
  barrels = new Barrels({ world, explosions });

  const health = new Health({ player, spots: world.pickupSpots });
  health.setRooms(world.activeRooms);
  const pickups = new Pickups(engine.scene, health);
  explosions.onPlayerBlast = (damage, owner) => {
    if (owner === 'mine') return; // landmines only hurt zombies
    // A teammate's grenade does not hurt me.
    if (tdm && tdm.active && owner === 'other' && tdm.teamOf(explosions.ownerId) === tdm.myTeam) return;
    if (zombies.active && owner === 'other') return; // no friendly fire in co-op
    health.damage(damage, 'explosion', owner);
  };
  health.onPickup.push(() => weapons.audio.pickup());
  { const prevLand = player.onLand; player.onLand = (s) => { if (prevLand) prevLand(s); weapons.audio.land(Math.min(1, s / 12)); }; }
  ui = new Ui(settings, input);
  ui.setSlotCount(3);
  // Loadout: saved choice, three weapon ids.
  try {
    const saved = JSON.parse(localStorage.getItem(LOADOUT_KEY) || 'null');
    if (Array.isArray(saved)) weapons.setLoadout(saved);
  } catch (_) { /* keep the default */ }
  ui.setLoadoutProvider({
    get: () => weapons.loadout.slice(),
    equip: (slot, id) => {
      const next = weapons.loadout.slice();
      const other = next.indexOf(id);
      if (other >= 0 && other !== slot) next[other] = next[slot]; // swap when it is already in another slot
      next[slot] = id;
      weapons.setLoadout(next);
      try { localStorage.setItem(LOADOUT_KEY, JSON.stringify(weapons.loadout)); } catch (_) { /* ignore */ }
    },
  });

  const common = { scene: engine.scene, world, player, input, settings, explosions, audio: weapons.audio, health, ui };
  enemies = new Enemies(common);
  zombies = new Zombies(Object.assign({ net, remotes }, common));
  tdm = new TeamMatch(Object.assign({ net, remotes }, common));
  tdm.onEvent = (ev) => {
    // A new match: everybody starts over at their team's spawn.
    if (ev.k === 'reset' && (input.locked || net.online)) health.respawn();
  };
  health.onRespawn.push(() => {
    weapons.refill();
    grenades.cooldown = 0;
    enemies.onPlayerRespawn();
  });
  // Personal upgrades from the shop.
  zombies.onUpgrade = (lv) => {
    player.damageMul = 1 + 0.15 * lv.dmg;
    player.reloadMul = 1 / (1 - 0.15 * lv.reload);
    const max = 100 + 25 * lv.hp;
    if (health.max !== max) {
      const diff = max - health.max;
      health.max = max;
      if (diff > 0) health.heal(diff);
      else health.value = Math.min(health.value, max);
    }
  };
  ui.setShop({ items: () => zombies.shopItems(), gold: () => zombies.myGold, buy: (id) => zombies.buy(id) });
  zombies.onShopChange = () => ui.refreshShop();
  zombies.onEvent = (ev) => {
    if (ev.k === 'clear') {
      // Between waves: fresh ammo and a patch-up for everyone.
      weapons.refill();
      health.heal(50);
    } else if (ev.k === 'reset') {
      if (input.locked || net.online) health.respawn();
    }
  };

  const touch = new TouchControls(input, settings, player);
  ui.onEditLayout = (from) => {
    ui.menu.classList.add('hidden');
    touch.startEdit(() => {
      ui.menu.classList.remove('hidden');
      ui._showView(from || 'settings');
    });
  };
  weapons.audio.setVolume(settings.get('volume'));
  settings.onChange((key, value) => { if (key === 'volume') weapons.audio.setVolume(value); });
  const baseLockChange = input.onLockChange;
  input.onLockChange = (playing) => {
    baseLockChange(playing);
    touch.sync();
    document.body.classList.toggle('free-mouse', input.freeMouse);
  };

  // ---- map size ----
  const mapTabs = Array.from(document.querySelectorAll('#map-tabs button'));
  const mapNote = document.getElementById('map-note');
  const applyMap = (size) => {
    if (!MAP_SIZES.includes(size) && size !== 'crash') size = 'middle';
    const changed = size !== world.size;
    if (size !== 'crash') mapSize = size; // the facility size the player picked
    if (changed) {
      world.setSize(size);
      health.setRooms(world.activeRooms);
      enemies.setMap(world.activeRooms);
      zombies.setMap(world.activeRooms);
      tdm.setMap(world.activeRooms);
      barrels.fuses.length = 0;
      health.respawn(); // new spawn point on the new map
    }
    for (const b of mapTabs) b.classList.toggle('on', size !== 'crash' && b.dataset.map === size);
  };
  for (const b of mapTabs) {
    b.addEventListener('click', () => {
      if (b.disabled) return;
      try { localStorage.setItem(MAP_KEY, b.dataset.map); } catch (_) { /* ignore */ }
      applyMap(b.dataset.map);
    });
  }

  // ---- game mode: soldiers (solo / 1v1 online) or zombie defense (solo / co-op) ----
  const savedMode = (() => { try { return localStorage.getItem(MODE_KEY); } catch (_) { return null; } })();
  let gameMode = savedMode === 'zombies' || savedMode === 'tdm' ? savedMode : 'soldiers';
  const modeTabs = Array.from(document.querySelectorAll('#mode-tabs button'));
  const modeNote = document.getElementById('mode-note');
  const applyMode = () => {
    const online = net.online;
    const shown = online ? (net.roomMode === 'coop' ? 'zombies' : net.roomMode === 'tdm' ? 'tdm' : 'soldiers') : gameMode;
    const coop = shown === 'zombies';
    const team = shown === 'tdm';
    const locked = net.status === 'connected' || net.status === 'connecting';
    for (const b of modeTabs) {
      b.classList.toggle('on', b.dataset.mode === shown);
      b.disabled = locked;
    }
    for (const b of mapTabs) b.disabled = locked || team;
    mapNote.textContent = team ? '(Crash)' : locked ? (net.mode === 'guest' ? '(set by the host)' : '') : '';
    modeNote.textContent = coop
      ? 'Defend the base in the middle of the map against waves of zombies. Solo, or co-op with up to 2 friends.'
      : team
        ? '5v5 team deathmatch on Crash. Bots fill empty places. Up to 10 players online. Hold Tab for the scoreboard.'
        : (online ? '1v1 against your friend.' : 'Fight enemy soldiers. Online: 1v1 against a friend.');
    const wasActive = zombies.active || tdm.active;
    enemies.setEnabled(!online && shown === 'soldiers');
    // The map follows the mode: Crash for team matches, the facility otherwise.
    applyMap(team ? 'crash' : online && net.mapSize !== 'crash' ? net.mapSize : mapSize);
    const role = online && net.id !== 1 ? 'guest' : 'host';
    tdm.myTeam = online ? net.team : 0;
    zombies.setActive(coop, role);
    tdm.setActive(team, role);
    weapons.setShotFilter(team ? (b) => !(b.enemy && b.enemy.team === tdm.myTeam) : null);
    if ((zombies.active || tdm.active) !== wasActive) health.respawn(); // to the base / team spawn, or away from it
    ui.setKills(coop ? (zombies.scores[zombies.myId] || 0) : team ? 0 : online ? null : enemies.kills);
    showNet();
  };
  for (const b of modeTabs) {
    b.addEventListener('click', () => {
      if (b.disabled || gameMode === b.dataset.mode) return;
      gameMode = b.dataset.mode;
      try { localStorage.setItem(MODE_KEY, gameMode); } catch (_) { /* ignore */ }
      applyMode();
    });
  }

  // ---- respawn points ----
  health.chooseSpawn = () => {
    const pts = world.spawnPoints;
    if (zombies.active) return BASE_SPAWNS[Math.floor(Math.random() * BASE_SPAWNS.length)];
    if (tdm.active) {
      // Team match: the team spawn farthest from the enemy.
      const list = CRASH_SPAWNS[tdm.myTeam];
      const foes = [];
      for (const [, r] of remotes) if (r.present && !r.dead && r.team !== tdm.myTeam) foes.push(r);
      for (const e of tdm.list) if (e.alive && e.team !== tdm.myTeam) foes.push(e);
      let best = list[0], bd = -1;
      for (const q of list) {
        let near = 99;
        for (const f of foes) near = Math.min(near, Math.hypot(q.x - f.x, q.z - f.z));
        near += Math.random() * 3;
        if (near > bd) { bd = near; best = q; }
      }
      return best;
    }
    // Against a player: the spawn farthest from them.
    const others = Array.from(remotes.values()).filter((r) => r.present);
    if (net.online && others.length) {
      let best = pts[0], bestD = -1;
      for (const q of pts) {
        let near = Infinity;
        for (const r of others) near = Math.min(near, Math.hypot(q.x - r.x, q.z - r.z));
        if (near > bestD) { bestD = near; best = q; }
      }
      return best;
    }
    // Against enemies: the spawn whose nearest enemy is farthest away.
    const alive = enemies.alive;
    if (alive.length) {
      let best = pts[0], bestD = -1;
      for (const q of pts) {
        let near = Infinity;
        for (const e of alive) near = Math.min(near, Math.hypot(q.x - e.x, q.z - e.z));
        if (near > bestD) { bestD = near; best = q; }
      }
      return best;
    }
    return pts[Math.floor(Math.random() * pts.length)];
  };

  // ---- multiplayer ----
  const nameOf = (id) => (id === net.id ? 'YOU' : 'P' + id);
  health.onDeath.push(() => {
    if (tdm.active) { tdm.reportDeath(); return; }
    ui.killedBy = health.lastOwner === 'other' ? 'KILLED BY YOUR OPPONENT' : '';
    net.send({ t: 'died', self: health.lastOwner === 'other' ? 0 : 1 });
  });
  grenades.onThrow = (x, y, z, vx, vy, vz) => net.send({ t: 'grenade', x: r2(x), y: r2(y), z: r2(z), vx: r2(vx), vy: r2(vy), vz: r2(vz) });
  barrels.onIgnite = (i) => net.send({ t: 'barrel', i });

  net.on('welcome', (m) => {
    for (const r of remotes.values()) r.setPresent(false);
    for (const id of net.players) {
      const r = remoteFor(id);
      r.setPresent(true);
      if (net.roomMode === 'tdm') { r.setTeam(net.teams[id]); r.setLabel('P' + id, net.teams[id] === 0 ? '#8fb8f0' : '#f0907a'); }
    }
    // The host's map counts online.
    if (net.mode === 'guest' || net.mode === 'host') applyMap(net.mapSize);
    if (net.roomMode === 'pvp') {
      // Player 1 starts at the first spawn point, player 2 at the one farthest from it.
      const pts = world.spawnPoints;
      let far = pts[pts.length - 1], best = -1;
      for (const q of pts) {
        const d = Math.hypot(q.x - pts[0].x, q.z - pts[0].z);
        if (d > best) { best = d; far = q; }
      }
      player.spawn = m.id === 1 ? pts[0] : far;
      player.respawn();
    }
    ui.setScore(0, 0);
    applyMode();
  });
  net.on('clear', () => {
    for (const r of remotes.values()) {
      r.setPresent(false);
      r.tx = r.ty = r.tz = 0;
    }
  });
  net.on('peer', (m) => {
    const r = remoteFor(m.id);
    r.setPresent(!!m.present);
    if (!m.present) r.tx = r.ty = r.tz = 0;
    if (m.present && net.roomMode === 'tdm') { r.setTeam(m.team); r.setLabel('P' + m.id, m.team === 0 ? '#8fb8f0' : '#f0907a'); }
    showNet();
    if (net.online) {
      if (net.roomMode === 'coop' || net.roomMode === 'tdm') ui.feed('P' + m.id + (m.present ? ' JOINED' : ' LEFT'));
      else ui.feed(m.present ? 'OPPONENT JOINED' : 'OPPONENT LEFT');
    }
  });
  net.on('s', (m) => { if (m.from) remoteFor(m.from).setState(m); });
  net.on('dmg', (m) => {
    if (typeof m.dmg === 'number' && !zombies.active) {
      if (tdm.active) tdm.noteAttacker({ k: 'h', id: m.from });
      health.damage(m.dmg, 'bullet', 'other');
    }
  });
  net.on('shot', (m) => {
    const r = remoteFor(m.from || 2);
    r.shotFx();
    if (Array.isArray(m.i) && m.i.length === 6) weapons.effects.spawn(m.i[0], m.i[1], m.i[2], m.i[3], m.i[4], m.i[5]);
    const spec = WEAPON_SPECS[(m.w | 0) - 1];
    if (spec) {
      const d = Math.hypot(r.x - player.x, r.z - player.z);
      weapons.audio.shot(spec.sound, Math.max(0.12, 1 / (1 + d * 0.07)));
    }
  });
  net.on('barrel', (m) => barrels.remoteIgnite(m.i | 0));
  net.on('grenade', (m) => grenades.spawnRemote(m));
  net.on('proj', (m) => {
    const spec = WEAPON_SPECS[(m.w | 0) - 1];
    if (spec && spec.projectile && projectiles) projectiles.launch('other', spec.projectile, m.x, m.y, m.z, m.dx, m.dy, m.dz, m.from || 0);
  });
  net.on('score', (m) => {
    const mine = net.id - 1;
    ui.setScore(m.s[mine], m.s[1 - mine]);
    if (m.victim === net.id) ui.feed(m.killer ? 'FRAGGED BY OPPONENT' : 'YOU DIED');
    else ui.feed(m.killer ? 'YOU FRAGGED OPPONENT' : 'OPPONENT DIED');
  });
  net.on('pdied', (m) => { if (m.id !== net.id) ui.feed(nameOf(m.id) + ' WENT DOWN'); });
  // 5v5 team deathmatch traffic.
  net.on('tm', (m) => tdm.applySnapshot(m));
  net.on('tms', (m) => tdm.applyStats(m));
  net.on('tev', (m) => { if (tdm.role === 'guest') tdm.handleEvent(m); });
  net.on('bhit', (m) => tdm.onNetHit(m));
  net.on('died', (m) => tdm.onDied(m));
  net.on('bdmg', (m) => {
    if (typeof m.dmg !== 'number') return;
    tdm.noteAttacker({ k: 'b', id: m.b, team: m.bt });
    tdm.hurtLocal(Math.min(100, m.dmg), m.x, m.z);
  });
  // Zombie defense traffic.
  net.on('zs', (m) => zombies.applySnapshot(m));
  net.on('zhit', (m) => zombies.onNetHit(m));
  net.on('zdmg', (m) => { if (typeof m.dmg === 'number') zombies.hurtMe(Math.min(100, m.dmg), m.x, m.z); });
  net.on('zev', (m) => { if (zombies.role === 'guest') zombies.handleEvent(m); });
  net.on('zbuy', (m) => zombies.onNetBuy(m));
  net.on('zbought', (m) => zombies.applyGrant(m.item, m.level));
  net.on('zmine', (m) => zombies.onNetMine(m));

  const netCode = document.getElementById('net-code');
  const netHost = document.getElementById('net-host');
  const netJoin = document.getElementById('net-join');
  const ERRORS = {
    lib: 'Could not load the multiplayer library. Check your internet connection.',
    code: 'Enter the code your friend sees after pressing HOST.',
    'peer-unavailable': 'No game with this code. Check the code and that your friend is still hosting.',
    timeout: 'No answer from that game. Try again, or let someone else host.',
    network: 'Could not reach the matchmaking server. Check your internet connection.',
    'server-error': 'The matchmaking server is not responding. Try again in a minute.',
    'browser-incompatible': 'This browser does not support peer-to-peer connections.',
    lost: 'Connection to the host was lost.',
  };
  function showNet() {
    const st = net.status;
    const p2p = net.mode === 'host' || net.mode === 'guest';
    const busy = st === 'connecting' || st === 'connected';
    const coop = net.roomMode === 'coop';
    const count = net.players.size + 1;
    let html = '';
    if (net.mode === 'host' && st === 'connecting') html = 'Creating a game\u2026';
    else if (net.mode === 'host' && st === 'connected') {
      html = 'Your code: <b>' + net.code + '</b><br>';
      if (net.roomMode === 'tdm') html += count + '/10 players. Friends type the code in and press JOIN; bots fill the rest.';
      else if (coop) html += count + '/3 players. Friends type the code in and press JOIN.';
      else html += net.peer ? 'Opponent joined.' : 'Send it to your friend. They type it in and press JOIN.';
    } else if (net.mode === 'guest' && st === 'connecting') html = 'Joining <b>' + net.code + '</b>\u2026';
    else if (net.mode === 'guest' && st === 'connected') {
      html = 'Connected to <b>' + net.code + '</b>' + (net.roomMode === 'tdm' ? ' \u00b7 5v5, ' + count + '/10 players' : coop ? ' \u00b7 zombie co-op, ' + count + '/3 players' : ' \u00b7 1v1');
    } else if (st === 'full') html = 'That game is full.';
    else if (st === 'error' && ERRORS[net.error]) html = ERRORS[net.error];
    if (html) {
      ui.netStatus.innerHTML = html;
      ui.netStatus.className = st === 'connected' ? 'ok' : st === 'error' || st === 'full' ? 'bad' : '';
    }
    netHost.textContent = p2p && busy ? 'LEAVE GAME' : gameMode === 'zombies' ? 'HOST CO-OP (UP TO 3)' : gameMode === 'tdm' ? 'HOST 5V5 (UP TO 10)' : 'HOST 1V1';
    netHost.disabled = busy && net.mode === 'ws';
    netJoin.disabled = busy;
    netCode.disabled = busy;
    ui.netConnect.disabled = busy && p2p;
    ui.netConnect.textContent = net.mode === 'ws' && busy ? 'DISCONNECT' : 'CONNECT';
  }
  netHost.addEventListener('click', () => {
    if ((net.mode === 'host' || net.mode === 'guest') && (net.status === 'connected' || net.status === 'connecting')) {
      net.disconnect();
      return;
    }
    net.host(gameMode === 'zombies' ? 'coop' : gameMode === 'tdm' ? 'tdm' : 'pvp', gameMode === 'tdm' ? 'crash' : mapSize);
  });
  const join = () => { if (!netJoin.disabled) net.join(netCode.value); };
  netJoin.addEventListener('click', join);
  netCode.addEventListener('keydown', (e) => { if (e.key === 'Enter') join(); e.stopPropagation(); });
  // A shared link like page.html#join=ABCDE fills in the code.
  const linkCode = /join=([A-Za-z0-9]+)/.exec(location.hash);
  if (linkCode) netCode.value = linkCode[1].toUpperCase();
  net.on('scoreReset', (m) => ui.setScore(m.s[net.id - 1], m.s[2 - net.id]));

  net.onStatus = (st) => {
    ui.setNetStatus(st);
    if (st !== 'connected') ui.setMatch(false, false);
    applyMode();
  };

  const saved = (() => { try { return localStorage.getItem('retrofps.url'); } catch (_) { return null; } })();
  ui.netUrl.value = saved || (location.protocol === 'http:' || location.protocol === 'https:'
    ? (location.protocol === 'https:' ? 'wss://' : 'ws://') + location.host + '/ws'
    : 'ws://raspberrypi.local:8080/ws');
  ui.netConnect.addEventListener('click', () => {
    if (net.mode === 'ws' && (net.status === 'connected' || net.status === 'connecting')) {
      net.disconnect();
      return;
    }
    const url = ui.netUrl.value.trim();
    try { localStorage.setItem('retrofps.url', url); } catch (_) { /* ignore */ }
    net.connect(url);
  });
  ui.setNetStatus('offline');
  applyMap(mapSize);
  applyMode();
  let sendTimer = 0;

  engine.run((dt) => {
    ui.updateFps(dt);
    input.update(dt);
    input.blocked = health.dead; // no shooting or grenades while dead
    if (input.consumeShop() && zombies.active) {
      ui.pendingView = 'shop';
      input.pause();
    }
    if (input.consumeMine() && zombies.active) zombies.placeMine();
    // The world keeps rendering behind the menu, but the player only
    // simulates while playing.
    if (input.locked) player.update(dt);
    weapons.update(dt);
    grenades.update(dt);
    projectiles.update(dt);
    // Footsteps: one step per stride.
    if (input.locked && player.onGround && !health.dead) {
      const sp = Math.hypot(player.vx, player.vz);
      if (sp > 1) {
        stepDist += sp * dt;
        const stride = sp > player.sprintSpeed * 0.8 ? 2.6 : 2.0;
        if (stepDist >= stride) { stepDist = 0; weapons.audio.step(player.crouching ? 0.25 : sp > player.sprintSpeed * 0.8 ? 1 : 0.6); }
      }
    }
    barrels.update(dt, player);
    explosions.update(dt);
    if (input.locked || health.dead) health.update(dt);
    pickups.update(dt);
    for (const r of remotes.values()) {
      r.update(dt);
      if (r.tag) r.tag.visible = tdm.active && r.team === tdm.myTeam && r.active;
    }
    enemies.update(dt);
    zombies.update(dt);
    tdm.update(dt);
    if (tdm.active) tdm.syncKills();
    net.flush(dt);
    if (net.online) {
      ui.setMatch(net.roomMode === 'pvp', net.roomMode === 'pvp' && !net.peer);
      sendTimer -= dt;
      if (sendTimer <= 0 && net.peer) {
        sendTimer = SEND_INTERVAL;
        net.send({
          t: 's', x: r2(player.x), y: r2(player.y), z: r2(player.z),
          yaw: r2(player.yaw), pitch: r2(player.pitch),
          c: player.crouching ? 1 : 0, w: weapons.active.slot, d: health.dead ? 1 : 0,
        });
      }
    }
    ui.updateHud(weapons.active, grenades, health);
    touch.update();
  });
}

try {
  boot();
} catch (err) {
  console.error(err);
  const msg = document.createElement('pre');
  msg.style.cssText = 'position:fixed;inset:0;margin:0;padding:24px;color:#d0a84a;background:#101012;white-space:pre-wrap;z-index:10';
  msg.textContent = 'Failed to start.\n\n' + (err && err.message ? err.message : err) +
    '\n\nCheck that WebGL is available in your browser.';
  document.body.appendChild(msg);
}
})();
  </script>
</body>
</html>
