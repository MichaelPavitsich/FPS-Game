    slotBox.textContent = '';
    classBox.textContent = '';
    list.textContent = '';
    LOADOUT_SLOTS.forEach((label, k) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.classList.toggle('on', k === this._loSlot);
      const spec = WEAPON_SPECS[ids[k] - 1];
      b.append(document.createTextNode(label));
      const small = document.createElement('small');
      small.textContent = spec ? spec.name : '';
      b.appendChild(small);
      b.addEventListener('click', () => {
        this._loSlot = k;
        this._loClass = 0;
        this._renderLoadout();
      });
      slotBox.appendChild(b);
    });
    // Slots 1 and 2: the five weapon classes. Slot 3: sidearms.
    const classes = this._loSlot === 2 ? WEAPON_CLASSES.filter((c) => c.id === 'pistol') : WEAPON_CLASSES.filter((c) => c.id !== 'pistol');
    if (this._loClass >= classes.length) this._loClass = 0;
    if (this._loSlot < 2 && this._loClassTouched !== true) {
      // Open on the class of the weapon that is equipped.
      const cur = classes.findIndex((c) => c.ids.includes(ids[this._loSlot]));
      if (cur >= 0) this._loClass = cur;
    }
    classBox.className = 'tabs small';
    classes.forEach((c, k) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = c.short;
      b.classList.toggle('on', k === this._loClass);
      b.addEventListener('click', () => {
        this._loClass = k;
        this._loClassTouched = true;
        this._renderLoadout();
      });
      classBox.appendChild(b);
    });
    const cls = classes[this._loClass];
    for (const id of cls.ids) {
      const spec = WEAPON_SPECS[id - 1];
      const row = document.createElement('div');
      row.className = 'lo-item';
      const name = document.createElement('b');
      name.textContent = spec.name;
      const dmg = Math.round((spec.damage || 0) * (spec.pellets || 1));
      const stats = document.createElement('small');
      stats.textContent = spec.projectile ? 'EXPLOSIVE  \u00b7  ' + Math.round(60 / spec.interval) + ' RPM  \u00b7  MAG ' + spec.magSize : 'DMG ' + dmg + (spec.pellets ? ' (x' + spec.pellets + ' pellets)' : '') +
        '  \u00b7  ' + Math.round(60 / spec.interval) + ' RPM  \u00b7  MAG ' + spec.magSize + '  \u00b7  ' + spec.range + ' m';
      const btn = document.createElement('button');
      btn.type = 'button';
      const equipped = ids[this._loSlot] === id;
      btn.textContent = equipped ? 'EQUIPPED' : 'EQUIP';
      btn.disabled = equipped;
      btn.addEventListener('click', () => {
        api.equip(this._loSlot, id);
        this._renderLoadout();
      });
      row.append(name, btn, stats);
      if (spec.desc) { const d = document.createElement('small'); d.className = 'lo-desc'; d.textContent = spec.desc; row.appendChild(d); }
      list.appendChild(row);
    }
  }

  /** Shop data source: { items(), gold(), buy(id) }. */
  setShop(provider) {
    this.shop = provider;
  }

  /** Re-draw the shop if it is open (gold or prices changed). */
  refreshShop() {
    if (!this.viewShop.hidden && !this.menu.classList.contains('hidden')) this._renderShop();
  }

  _renderShop() {
    if (!this.shop) return;
    document.getElementById('shop-gold').textContent = 'GOLD ' + this.shop.gold();
    const list = document.getElementById('shop-list');
    list.textContent = '';
    let lastTeam = null;
    for (const it of this.shop.items()) {
      if (it.team !== lastTeam) {
        lastTeam = it.team;
        const head = document.createElement('div');
        head.className = 'shop-head';
        head.textContent = it.team ? 'FOR THE TEAM' : 'FOR YOU';
        list.appendChild(head);
      }
      const row = document.createElement('div');
      row.className = 'shop-item';
      const name = document.createElement('b');
      name.textContent = it.name;
      const desc = document.createElement('small');
      desc.textContent = it.desc;
      const lvl = document.createElement('em');
      lvl.textContent = it.max > 1 ? 'Level ' + it.level + ' / ' + it.max : '';
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = it.blocked || it.cost + ' GOLD';
      btn.disabled = !it.can;
      btn.addEventListener('click', () => {
        this.shop.buy(it.id);
        btn.disabled = true;
        setTimeout(() => this.refreshShop(), 250); // guests wait for the host
      });
      row.append(name, btn, desc, lvl);
      list.appendChild(row);
    }
  }

  _buildSettings() {
    document.getElementById('open-settings').addEventListener('click', () => this._showSettings(true));
    document.getElementById('close-settings').addEventListener('click', () => this._showSettings(false));
    document.getElementById('reset-settings').addEventListener('click', () => {
      this.settings.reset();
      this._renderTab();
    });
    this._tabButtons = Array.from(document.querySelectorAll('#settings-tabs button'));
    for (const btn of this._tabButtons) {
      btn.addEventListener('click', () => {
        this._tab = btn.dataset.tab;
        this._renderTab();
      });
    }
    this._list = document.getElementById('settings-list');
  }

  _renderTab() {
    for (const btn of this._tabButtons) btn.classList.toggle('on', btn.dataset.tab === this._tab);
    const list = this._list;
    list.textContent = '';
    for (const item of SETTINGS_SCHEMA) {
      if (item.tab !== this._tab) continue;
      const label = document.createElement('label');
      const name = document.createElement('span');
      name.textContent = item.label;
      label.appendChild(name);

      if (item.toggle) {
        label.className = 'toggle';
        const box = document.createElement('input');
        box.type = 'checkbox';
        box.checked = !!this.settings.get(item.key);
        box.addEventListener('change', () => this.settings.set(item.key, box.checked ? 1 : 0));
        label.appendChild(box);
      } else {
        const output = document.createElement('output');
        const slider = document.createElement('input');
        slider.type = 'range';
        slider.min = String(LIMITS[item.key].min);
        slider.max = String(LIMITS[item.key].max);
        slider.step = String(item.step);
        const refresh = () => {
          const value = this.settings.get(item.key);
          slider.value = String(value);
          output.textContent = item.format(value);
        };
        slider.addEventListener('input', () => {
          this.settings.set(item.key, Number(slider.value));
          refresh();
        });
        refresh();
        label.appendChild(output);
        label.appendChild(slider);
      }
      const group = document.createElement('div');
      group.className = 'setting';
      group.appendChild(label);
      if (item.note) {
        const note = document.createElement('p');
        note.className = 'setting-note';
        note.textContent = item.note;
        group.appendChild(note);
      }
      list.appendChild(group);
    }
    if (this._tab === 'touch' && this.onEditLayout) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'secondary';
      btn.textContent = 'MOVE BUTTONS & HUD';
      btn.addEventListener('click', () => this.onEditLayout('settings'));
      list.insertBefore(btn, list.firstChild);
      const note = document.createElement('p');
      note.className = 'setting-note';
      note.textContent = 'Drag every on-screen button, the joystick, the health bar and the ammo display to where you want them.';
      list.insertBefore(note, btn.nextSibling);
    }
  }
}

// ===== js/input/Input.js =====
const FORWARD = ['KeyW', 'ArrowUp'];
const BACKWARD = ['KeyS', 'ArrowDown'];
const LEFT = ['KeyA', 'ArrowLeft'];
const RIGHT = ['KeyD', 'ArrowRight'];
const SPRINT = ['ShiftLeft', 'ShiftRight'];
const JUMP = 'Space';
const RELOAD = 'KeyR';
const CROUCH = 'KeyC';
const GRENADE = 'KeyE';
const AIM_KEY = 'KeyZ'; // hold to aim down sights (alternative to right click)
const SHOP_KEY = 'KeyB';
const MINE_KEY = 'KeyG';
const SLOT_KEYS = {
  Digit1: 1, Digit2: 2, Digit3: 3, Digit4: 4, Digit5: 5, Digit6: 6, Digit7: 7, Digit8: 8, Digit9: 9,
  KeyQ: -1, // -1 = swap back to the previous weapon
};

// Keys whose default browser action (scrolling) must be suppressed in play.
const BLOCKED_DEFAULTS = new Set(['Space', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight']);

// Some browsers emit a huge bogus movement delta right after pointer lock.
const MAX_LOOK_DELTA = 200;

/**
 * Keyboard + mouse input with Pointer Lock.
 *
 * Gameplay code reads abstract values (move axes, look delta, sprint, jump)
 * and never touches DOM events. A touch layer can later drive the same state
 * through setVirtualMove / setVirtualSprint / addLook / pressJump.
 */
class Input {
  constructor(element) {
    this.element = element;
    this.locked = false;
    /** Called with `true` / `false` when pointer lock is gained / lost. */
    this.onLockChange = null;

    this._keys = new Set();
    this._lookX = 0;
    this._lookY = 0;
    this._jumpQueued = false;
    this._virtualMove = { x: 0, y: 0 };
    this._virtualSprint = false;

    // Fire sources: left mouse button, touch FIRE buttons.
    this._fireMouse = false;
    this._fireTouch = false;
    /** While true (e.g. the player is dead) fire, aim and grenades are ignored. */
    this.blocked = false;
    this.scoreHeld = false; // Tab: scoreboard in team matches
    // Aim sources: right mouse button, Z key, touch AIM button.
    this._aimMouse = false;
    this._aimTouch = false;
    this._reloadQueued = false;
    this._grenadeQueued = false;
    this._slotQueued = 0;
    this._virtualCrouch = false;
    this._crouchPressed = false; // crouch was pressed since the last read (starts a slide when sprinting)
    this._wheel = 0;
    this._firePressed = false; // a press happened since the last read (even a very short tap)

    /** 'none' | 'lock' (pointer lock) | 'touch' | 'fallback' (no pointer lock available). */
    this._mode = 'none';
    this._lockErrTimer = 0;
    this._lastUnlock = -1e9;
    /** Called with a short message for the menu (or '' to clear it). */
    this.onHint = null;
    /** Called when play starts without mouse capture because the browser refused it. */
    this.onNoCapture = null;
    this._lockFails = 0;
    // Free-mouse mode (no pointer lock): where the cursor is, for edge turning.
    this._mouseX = -1;
    this._mouseY = -1;
    this._mouseInside = false;

    this._onKeyDown = this._onKeyDown.bind(this);
    this._onKeyUp = this._onKeyUp.bind(this);
    this._onLockChange = this._onLockChange.bind(this);

    document.addEventListener('keydown', this._onKeyDown);
    document.addEventListener('keyup', this._onKeyUp);
    // Mouse: pointer events in the capture phase, so the on-screen controls
    // cannot swallow them. Works with and without pointer lock.
    document.addEventListener('pointerdown', (e) => {
      if (!this.locked) return;
      if (e.pointerType === 'mouse') {
        // Try to capture the mouse again; harmless if the browser refuses.
        if (this._mode !== 'lock') this._tryRelock();
        this._mouseButtons(e);
        e.preventDefault();
      } else if (e.pointerType === 'touch' && this._mode === 'fallback') {
        // A finger on a laptop / tablet: bring up the on-screen controls.
        this._start('touch');
      }
    }, true);
    document.addEventListener('pointerup', (e) => {
      if (e.pointerType === 'mouse') this._mouseButtons(e);
    }, true);
    document.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      this._mouseInside = true;
      this._mouseX = e.clientX;
      this._mouseY = e.clientY;
      if (!this.locked) return;
      this._mouseButtons(e); // a second button pressed while one is held arrives as a move
      this.addLook(e.movementX || 0, e.movementY || 0);
    }, true);
    document.documentElement.addEventListener('mouseleave', () => { this._mouseInside = false; });
    // Middle click (with the wheel option on) puts aim sensitivity back to its default.
    document.addEventListener('mousedown', (e) => {
      if (e.button !== 1 || !this.locked) return;
      e.preventDefault();
      const s = this.settings;
      if (s && s.get('wheelAimSens')) {
        s.set('adsSensitivity', 1);
        if (this.onAimSens) this.onAimSens(1);
      }
    });
    document.addEventListener('wheel', (e) => {
      if (!this.locked || e.deltaY === 0) return;
      // Optional: while aiming, the wheel tunes aim sensitivity instead of switching weapons.
      const s = this.settings;
      if (s && s.get('wheelAimSens') && this.aimHeld) {
        const next = s.set('adsSensitivity', Math.round((s.get('adsSensitivity') - Math.sign(e.deltaY) * 0.05) * 100) / 100);
        if (this.onAimSens) this.onAimSens(s.get('adsSensitivity'));
        return;
      }
      this._wheel = Math.sign(e.deltaY);
    }, { passive: true });
    document.addEventListener('contextmenu', (e) => {
      if (this.locked) e.preventDefault();
    });
    document.addEventListener('pointerlockchange', this._onLockChange);
    document.addEventListener('pointerlockerror', () => {
      if (this.locked) {
        this._lockFails++; // a re-capture attempt during play failed; play on without it
        return;
      }
      // Give a pending retry (without unadjustedMovement) a moment to succeed.
      this._scheduleFallback(700);
    });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden && this.overlay) this.pause();
    });
    window.addEventListener('blur', () => {
      this._keys.clear();
      this._fireMouse = false;
      this._aimMouse = false;
    });
    element.addEventListener('contextmenu', (e) => e.preventDefault());
  }

  /** True while playing without pointer lock (touch or on-screen fallback). */
  get overlay() {
    return this.locked && this._mode === 'touch';
  }

  /** Playing with a mouse but without pointer lock (the cursor is hidden instead). */
  get freeMouse() {
    return this.locked && this._mode === 'fallback';
  }

  /**
   * Start playing. Must be called from a user gesture.
   * Touch devices skip pointer lock. If pointer lock is not available or is
   * refused (iframes, some browsers), the game falls back to on-screen controls.
   */
  requestLock(pointerType) {
    const el = this.element;
    const coarse = typeof matchMedia === 'function' &&
      matchMedia('(pointer: coarse)').matches && !matchMedia('(any-pointer: fine)').matches;
    const touch = pointerType === 'touch' || pointerType === 'pen' || coarse;
    if (this.onHint) this.onHint('');
    if (touch) {
      this._tryFullscreen();
      this._start('touch');
      return;
    }
    if (!el.requestPointerLock) {
      this._start('fallback');
      return;
    }
    try {
      // Raw (unaccelerated) mouse input where supported.
      const result = el.requestPointerLock({ unadjustedMovement: true });
      if (result && typeof result.catch === 'function') {
        result.catch(() => {
          try {
            const again = el.requestPointerLock();
            if (again && typeof again.catch === 'function') again.catch(() => this._scheduleFallback(0));
          } catch (_) { this._scheduleFallback(0); }
        });
      }
    } catch (_) {
      try {
        const again = el.requestPointerLock();
        if (again && typeof again.catch === 'function') again.catch(() => this._scheduleFallback(0));
      } catch (__) { this._scheduleFallback(0); return; }
    }
    this._scheduleFallback(1500);
  }

  /** Go fullscreen, then capture the mouse (one click does both). */
  requestFullscreenPlay() {
    const de = document.documentElement;
    const go = () => this.requestLock('mouse');
    if (document.fullscreenElement || !de.requestFullscreen || document.fullscreenEnabled === false) {
      go();
      return;
    }
    let p = null;
    try { p = de.requestFullscreen({ navigationUI: 'hide' }); } catch (_) { p = null; }
    try {
      // Keeps Esc from leaving fullscreen while playing (Chrome / Edge; hold Esc to leave).
      if (navigator.keyboard && navigator.keyboard.lock) navigator.keyboard.lock(['Escape']).catch(() => {});
    } catch (_) { /* optional */ }
    if (p && p.then) p.then(go, go); else go();
  }

  /** Back to the menu. */
  pause() {
    if (!this.locked) return;
    if (this._mode === 'lock') {
      if (document.exitPointerLock) document.exitPointerLock();
    } else {
      this._setPlaying(false);
    }
  }

  _scheduleFallback(delay) {
    clearTimeout(this._lockErrTimer);
    this._lockErrTimer = setTimeout(() => {
      if (this.locked) return;
      // Browsers refuse a new lock for about a second after Esc.
      if (performance.now() - this._lastUnlock < 1600) {
        if (this.onHint) this.onHint('Please wait a second, then click again.');
        return;
      }
      this._start('fallback');
    }, delay);
  }

  _tryFullscreen() {
    try {
      const de = document.documentElement;
      if (document.fullscreenElement || !de.requestFullscreen) return;
      const lockOrientation = () => {
        const o = screen.orientation;
        if (o && o.lock) {
          const p = o.lock('landscape');
          if (p && p.catch) p.catch(() => {});
        }
      };
      const p = de.requestFullscreen({ navigationUI: 'hide' });
      if (p && p.then) p.then(lockOrientation).catch(() => {});
    } catch (_) { /* fullscreen is optional */ }
  }

  _start(mode) {
    clearTimeout(this._lockErrTimer);
    if (mode === 'fallback') {
      if (this.onNoCapture) this.onNoCapture();
      this._tryFullscreen(); // keeps the (hidden) cursor from leaving the screen
    }
    const changed = this._mode !== mode;
    this._mode = mode;
    if (!this.locked) {
      try { window.focus(); } catch (_) { /* keyboard focus inside frames */ }
      this._setPlaying(true);
    } else if (changed && this.onLockChange) {
      this.onLockChange(true);
    }
  }

  /** Writes strafe (x, right positive) and forward (y, forward positive), each -1..1. */
  getMove(out) {
    let x = (this._down(RIGHT) ? 1 : 0) - (this._down(LEFT) ? 1 : 0) + this._virtualMove.x;
    let y = (this._down(FORWARD) ? 1 : 0) - (this._down(BACKWARD) ? 1 : 0) + this._virtualMove.y;
    out.x = Math.max(-1, Math.min(1, x));
    out.y = Math.max(-1, Math.min(1, y));
    return out;
  }

  /** Writes accumulated look delta in pixels since the last call, then resets it. */
  consumeLook(out) {
    out.x = this._lookX;
    out.y = this._lookY;
    this._lookX = 0;
    this._lookY = 0;
    return out;
  }

  /** True once per jump key press. */
  consumeJump() {
    const queued = this._jumpQueued;
    this._jumpQueued = false;
    return queued;
  }

  get jumpHeld() {
    return this._keys.has(JUMP);
  }

  get sprint() {
    return this._virtualSprint || this._down(SPRINT);
  }

  // --- Hooks for a future touch / gamepad layer ---------------------------

  setVirtualMove(x, y) {
    this._virtualMove.x = x;
    this._virtualMove.y = y;
  }

  setVirtualSprint(active) {
    this._virtualSprint = !!active;
  }

  addLook(dx, dy) {
    this._lookX += Math.max(-MAX_LOOK_DELTA, Math.min(MAX_LOOK_DELTA, dx));
    this._lookY += Math.max(-MAX_LOOK_DELTA, Math.min(MAX_LOOK_DELTA, dy));
  }

  pressJump() {
    this._jumpQueued = true;
  }

  /** True once per reload key press. */
  consumeReload() {
    const queued = this._reloadQueued;
    this._reloadQueued = false;
    return queued;
  }

  // Touch hooks for the weapon.
  setFire(active) {
    if (active && !this._fireTouch) this._firePressed = true;
    this._fireTouch = !!active;
  }

  /** True while the trigger is held (left mouse button or touch FIRE). */
  get fireHeld() {
    return !this.blocked && (this._fireMouse || this._fireTouch);
  }

  /**
   * Per frame. Without pointer lock the cursor stops at the window edge, so
   * holding it near the edge keeps turning the view.
   */
  update(dt) {
    if (!this.locked || this._mode === 'lock' || !this._mouseInside || this._mouseX < 0) return;
    const w = window.innerWidth;
    const h = window.innerHeight;
    const band = Math.max(24, w * 0.06);
    const vband = Math.max(20, h * 0.06);
    let lx = 0, ly = 0;
    if (this._mouseX < band) lx = -(1 - this._mouseX / band);
    else if (this._mouseX > w - band) lx = 1 - (w - this._mouseX) / band;
    if (this._mouseY < vband) ly = -(1 - this._mouseY / vband);
    else if (this._mouseY > h - vband) ly = 1 - (h - this._mouseY) / vband;
    if (lx || ly) {
      this._lookX += lx * 900 * dt;
      this._lookY += ly * 450 * dt;
    }
  }

  _mouseButtons(e) {
    const b = e.buttons;
    const fire = (b & 1) !== 0;
    if (fire && !this._fireMouse) this._firePressed = true;
    this._fireMouse = fire;
    this._aimMouse = (b & 2) !== 0;
  }

  _tryRelock() {
    const el = this.element;
    if (this._lockFails >= 2 || !el.requestPointerLock || document.pointerLockElement === el) return;
    try {
      const r = el.requestPointerLock();
      if (r && typeof r.catch === 'function') r.catch(() => { this._lockFails++; });
    } catch (_) {
      this._lockFails++;
    }
  }

  /** True once per trigger press (used by semi-auto weapons). */
  consumeFirePress() {
    const pressed = this._firePressed;
    this._firePressed = false;
    return pressed;
  }
  /** Touch AIM button. */
  setAim(active) { this._aimTouch = !!active; }

  /** True while any aim input is held: right mouse button, Z or the touch AIM button. */
  get aimHeld() {
    return !this.blocked && (this._aimMouse || this._aimTouch || this._keys.has(AIM_KEY));
  }
  pressReload() { this._reloadQueued = true; }
  pressGrenade() { this._grenadeQueued = true; }
  pressSlot(n) { this._slotQueued = n; }
  setVirtualCrouch(active) { this._virtualCrouch = !!active; }

  /** Touch crouch button: toggles crouch and counts as a press (for sliding). */
  toggleCrouch() {
    this._virtualCrouch = !this._virtualCrouch;
    if (this._virtualCrouch) this._crouchPressed = true;
  }

  /** Called when a slide starts, so a toggled crouch does not stick afterwards. */
  clearCrouchToggle() { this._virtualCrouch = false; }

  get crouchToggled() { return this._virtualCrouch; }

  pressShop() { this._shopQueued = true; }
  pressMine() { this._mineQueued = true; }

  /** True once per shop key press. */
  consumeShop() {
    const q = this._shopQueued;
    this._shopQueued = false;
    return q;
  }

  /** True once per landmine key press. */
  consumeMine() {
    const q = this._mineQueued;
    this._mineQueued = false;
    return q && !this.blocked;
  }

  /** True once per crouch press. */
  consumeCrouchPress() {
    const pressed = this._crouchPressed;
    this._crouchPressed = false;
    return pressed;
  }

  /** True while crouch (C) is held. */
  get crouch() {
    return this._virtualCrouch || this._keys.has(CROUCH);
  }

  /** True once per grenade key press. */
  consumeGrenade() {
    const queued = this._grenadeQueued;
    this._grenadeQueued = false;
    return queued && !this.blocked;
  }

  /** Mouse wheel step since the last call: 1 (next), -1 (previous) or 0. */
  consumeWheel() {
    const w = this._wheel;
    this._wheel = 0;
    return w;
  }

  /** Weapon slot requested since the last call: 1-8, -1 (previous weapon) or 0 (none). */
  consumeSlot() {
    const slot = this._slotQueued;
    this._slotQueued = 0;
    return slot;
  }

  // --- Internals ----------------------------------------------------------

  _down(codes) {
    for (let i = 0; i < codes.length; i++) {
      if (this._keys.has(codes[i])) return true;
    }
    return false;
  }

  _onKeyDown(e) {
    if (!this.locked) return; // gameplay keys are ignored while the menu is open
    if (e.code === 'F11' || (e.code === 'KeyF' && e.shiftKey)) {
      e.preventDefault();
      if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
      else if (document.documentElement.requestFullscreen) document.documentElement.requestFullscreen().catch(() => {});
      return;
    }
    // Without pointer lock the browser does not handle Esc for us.
    if (this._mode !== 'lock' && (e.code === 'Escape' || e.code === 'KeyP')) {
      this.pause();
      return;
    }
    if (BLOCKED_DEFAULTS.has(e.code)) e.preventDefault();
    if (e.repeat) return;
    this._keys.add(e.code);
    if (e.code === JUMP) this._jumpQueued = true;
    if (e.code === RELOAD) this._reloadQueued = true;
    if (e.code === GRENADE) this._grenadeQueued = true;
    if (e.code === CROUCH) this._crouchPressed = true;
    if (e.code === 'Tab') { e.preventDefault(); this.scoreHeld = true; return; }
    if (e.code === SHOP_KEY) this._shopQueued = true;
    if (e.code === MINE_KEY) this._mineQueued = true;
    if (SLOT_KEYS[e.code]) this._slotQueued = SLOT_KEYS[e.code];
  }

  _onKeyUp(e) {
    this._keys.delete(e.code);
    if (e.code === 'Tab') this.scoreHeld = false;
  }

  _onLockChange() {
    const locked = document.pointerLockElement === this.element;
    if (locked) this._start('lock');
    else if (this._mode === 'lock') this._setPlaying(false);
  }

  _setPlaying(playing) {
    if (playing === this.locked) return;
    this.locked = playing;
    if (!playing) {
      this._mode = 'none';
      this._lastUnlock = performance.now();
      this._keys.clear();
      this._lookX = 0;
      this._lookY = 0;
      this._jumpQueued = false;
      this._reloadQueued = false;
      this._grenadeQueued = false;
      this._slotQueued = 0;
      this._firePressed = false;
      this._wheel = 0;
      this._fireMouse = false;
      this._fireTouch = false;
      this._aimMouse = false;
      this._aimTouch = false;
      this._virtualMove.x = 0;
      this._virtualMove.y = 0;
      this._virtualSprint = false;
      this._virtualCrouch = false;
      this._crouchPressed = false;
      this._shopQueued = false;
      this._mineQueued = false;
      this.scoreHeld = false;
    }
    if (this.onLockChange) this.onLockChange(playing);
  }
}

// ===== js/world/Collision.js =====
/**
 * Static axis-aligned box collision. Pure data and maths: no Three.js here.
 *
 * Brute-force scanning is plenty for the few dozen boxes of the test level.
 * When levels grow, replace the loops in `intersects` / `overlapping` with a
 * uniform grid; the interface can stay the same.
 */
class CollisionWorld {
  constructor() {
    this.boxes = [];
    this._hits = [];
  }

  addBox(minX, minY, minZ, maxX, maxY, maxZ) {
    const box = { minX, minY, minZ, maxX, maxY, maxZ };
    this.boxes.push(box);
    return box;
  }

  /** True if the given AABB overlaps any box (touching faces do not count). */
  intersects(minX, minY, minZ, maxX, maxY, maxZ) {
    const boxes = this.boxes;
    for (let i = 0; i < boxes.length; i++) {
      const b = boxes[i];
      if (maxX > b.minX && minX < b.maxX &&
          maxY > b.minY && minY < b.maxY &&
          maxZ > b.minZ && minZ < b.maxZ) {
        return true;
      }
    }
    return false;
  }

  /** Remove a box returned by addBox (e.g. a destroyed barrel). */
  removeBox(box) {
    const i = this.boxes.indexOf(box);
    if (i >= 0) this.boxes.splice(i, 1);
  }

  /**
   * Nearest box hit by a ray (origin o, unit direction d) within maxDist.
   * Fills `out` with dist, point (x, y, z) and face normal (nx, ny, nz).
   * Returns false when nothing is hit. A box the ray starts inside is skipped.
   */
  raycast(ox, oy, oz, dx, dy, dz, maxDist, out, filter) {
    const boxes = this.boxes;
    let best = maxDist;
    let found = false;
    for (let i = 0; i < boxes.length; i++) {
      const b = boxes[i];
      if (filter && !filter(b)) continue;
      let tMin = -Infinity;
      let tMax = Infinity;
      let axis = -1;
      let sign = 0;

      if (dx > 1e-9 || dx < -1e-9) {
        let t1 = (b.minX - ox) / dx, t2 = (b.maxX - ox) / dx, s = -1;
        if (t1 > t2) { const t = t1; t1 = t2; t2 = t; s = 1; }
        if (t1 > tMin) { tMin = t1; axis = 0; sign = s; }
        if (t2 < tMax) tMax = t2;
      } else if (ox < b.minX || ox > b.maxX) continue;

      if (dy > 1e-9 || dy < -1e-9) {
        let t1 = (b.minY - oy) / dy, t2 = (b.maxY - oy) / dy, s = -1;
        if (t1 > t2) { const t = t1; t1 = t2; t2 = t; s = 1; }
        if (t1 > tMin) { tMin = t1; axis = 1; sign = s; }
        if (t2 < tMax) tMax = t2;
      } else if (oy < b.minY || oy > b.maxY) continue;

      if (dz > 1e-9 || dz < -1e-9) {
        let t1 = (b.minZ - oz) / dz, t2 = (b.maxZ - oz) / dz, s = -1;
        if (t1 > t2) { const t = t1; t1 = t2; t2 = t; s = 1; }
        if (t1 > tMin) { tMin = t1; axis = 2; sign = s; }
        if (t2 < tMax) tMax = t2;
      } else if (oz < b.minZ || oz > b.maxZ) continue;

      if (tMax < tMin || tMin < 0 || tMin >= best || axis < 0) continue;
      best = tMin;
      found = true;
      out.dist = tMin;
      out.box = b;
      out.x = ox + dx * tMin;
      out.y = oy + dy * tMin;
      out.z = oz + dz * tMin;
      out.nx = axis === 0 ? sign : 0;
      out.ny = axis === 1 ? sign : 0;
      out.nz = axis === 2 ? sign : 0;
    }
    return found;
  }

  /**
   * All boxes overlapping the given AABB. The returned array is reused
   * between calls: read it before the next call.
   */
  overlapping(minX, minY, minZ, maxX, maxY, maxZ) {
    const hits = this._hits;
    hits.length = 0;
    const boxes = this.boxes;
    for (let i = 0; i < boxes.length; i++) {
      const b = boxes[i];
      if (maxX > b.minX && minX < b.maxX &&
          maxY > b.minY && minY < b.maxY &&
          maxZ > b.minZ && minZ < b.maxZ) {
        hits.push(b);
      }
    }
    return hits;
  }
}

// ===== js/player/Player.js =====
// Player movement and camera control. No rendering-library imports: the
// camera is any object with `position.set(x, y, z)` and `rotation.set(x, y, z)`.

const SKIN = 0.001; // tiny gap left after resolving a collision
const LOOK_RADIANS_PER_PIXEL = 0.0022; // at sensitivity 1.0
const MAX_PITCH = Math.PI / 2 - 0.01;
const MAX_SUBSTEP = 1 / 60; // physics substep so fast movement cannot tunnel

class Player {
  constructor({ camera, input, collision, settings, spawn }) {
    this.camera = camera;
    this.input = input;
    this.collision = collision;
    this.settings = settings;
    this.spawn = spawn;

    // Body (metres). Position is the centre of the feet.
    this.radius = 0.35;
    this.standHeight = 1.8;
    this.crouchHeight = 1.1; // smaller hitbox while crouching
    this.standEye = 1.62;
    this.crouchEye = 0.95;
    this.height = this.standHeight;
    this.eyeHeight = this.standEye;
    this.crouchSpeedScale = 0.5;

    // Movement tuning.
    this.walkSpeed = 5.0;
    this.sprintSpeed = 8.5;
    this.groundAccel = 55;
    this.airAccel = 14;
    this.jumpSpeed = 7.5; // ~1.1 m jump
    this.gravity = 24;
    this.terminalVelocity = 45;
    this.stepHeight = 0.35; // ledges up to this height are walked over
    this.coyoteTime = 0.1; // jump grace period after leaving a ledge

    // Slide (crouch while sprinting).
    this.slideSpeed = 11.5;     // starting speed
    this.slideFriction = 9;     // m/s lost per second on the ground
    this.slideDuration = 0.85;  // max length in seconds
    this.slideEndSpeed = 4.5;   // slide ends below this speed
    this.slideCooldown = 0.4;
    this.slideEye = 0.78;
    this.jumpBufferTime = 0.12; // early jump press is remembered this long

    // State.
    this.x = 0; this.y = 0; this.z = 0;
    this.vx = 0; this.vy = 0; this.vz = 0;
    this.yaw = 0;
    this.pitch = 0;
    this.onGround = false;
    this.sprinting = false;

    // Hooks used by the weapon: look/move scaling while aiming, sprint lock.
    this.lookScale = 1;
    this.speedScale = 1;
    this.canSprint = true;
    this.crouching = false;
    this.roll = 0; // camera roll, used for explosion shake
    this.enabled = true; // false while dead: no movement, looking or jumping
    this.deathRoll = 0;
    this.onLand = null; // called with the landing speed (m/s)
    this.lookDx = 0; // last frame's raw mouse delta (pixels), for weapon sway
    this.lookDy = 0;
    this.aimEase = 0;   // 0..1, set by the weapon; scales aim sensitivity
    this.sliding = false;
    this.fovBoost = 0;  // extra degrees while sprinting / sliding, read by the weapon
    this.slideRoll = 0; // camera tilt during a slide
    this._slideTime = 0;
    this._slideCd = 0;

    this._coyote = 0;
    this._jumpBuffer = 0;
    this._move = { x: 0, y: 0 };
    this._look = { x: 0, y: 0 };

    this.respawn();
  }

  respawn() {
    const s = this.spawn;
    this.x = s.x; this.y = s.y; this.z = s.z;
    this.vx = 0; this.vy = 0; this.vz = 0;
    this.yaw = s.yaw || 0;
    this.pitch = 0;
    this.onGround = false;
    this.crouching = false;
    this.sliding = false;
    this.fovBoost = 0;
    this.slideRoll = 0;
    this.height = this.standHeight;
    this.eyeHeight = this.standEye;
    this._syncCamera();
  }

  update(dt) {
    dt = Math.min(dt, 0.1);
    const input = this.input;

    // Mouse look.
    input.consumeLook(this._look);
    if (!this.enabled) { this._look.x = 0; this._look.y = 0; }
    this.lookDx = this._look.x;
    this.lookDy = this._look.y;
    const ads = 1 + (this.settings.get('adsSensitivity') - 1) * this.aimEase;
    const k = LOOK_RADIANS_PER_PIXEL * this.settings.get('sensitivity') * this.lookScale * ads;
    const invert = this.settings.get('invertY') ? -1 : 1;
    this.yaw -= this._look.x * k;
    this.pitch -= this._look.y * k * invert;
    this.pitch = Math.max(-MAX_PITCH, Math.min(MAX_PITCH, this.pitch));
    this.yaw %= Math.PI * 2;

    // Movement input.
    input.getMove(this._move);
    if (!this.enabled) { this._move.x = 0; this._move.y = 0; }
    if (input.consumeJump() && this.enabled) this._jumpBuffer = this.jumpBufferTime;

    // Crouch pressed while sprinting on the ground: slide.
    this._slideCd = Math.max(0, this._slideCd - dt);
    if (input.consumeCrouchPress() && this.enabled && this.sprinting && this.onGround && !this.sliding && this._slideCd <= 0) {
      this._startSlide();
      input.clearCrouchToggle();
    }

    // Crouch is held; standing back up needs headroom.
    if (this.sliding || (input.crouch && this.enabled)) this.crouching = true;
    else if (this.crouching && this._canStand()) this.crouching = false;
    this.height = this.crouching ? this.crouchHeight : this.standHeight;
    const eyeTarget = !this.enabled ? 0.4 : this.sliding ? this.slideEye : this.crouching ? this.crouchEye : this.standEye;
    this.deathRoll += ((this.enabled ? 0 : 1.3) - this.deathRoll) * Math.min(1, dt * 6);
    this.eyeHeight += (eyeTarget - this.eyeHeight) * Math.min(1, dt * 14);

    const autoSprint = this.settings.get('autoSprint') && this._move.y > 0.85 && Math.abs(this._move.x) < 0.6;
    this.sprinting = !this.sliding && this.canSprint && !this.crouching &&
      (input.sprint || autoSprint) && this._move.y > 0.1;

    // Camera feel: wider view while running, a tilt while sliding.
    const fovTarget = this.sliding ? 9 : this.sprinting ? 5 : 0;
    this.fovBoost += (fovTarget - this.fovBoost) * Math.min(1, dt * 8);
    const rollTarget = this.sliding ? 0.06 : 0;
    this.slideRoll += (rollTarget - this.slideRoll) * Math.min(1, dt * 10);

    const steps = Math.max(1, Math.ceil(dt / MAX_SUBSTEP));
    const h = dt / steps;
    for (let i = 0; i < steps; i++) this._step(h);

    if (this.y < -30) this.respawn(); // fell out of the world
    this._syncCamera();
  }

  _step(h) {
    // Jump timing.
    if (this.onGround) this._coyote = this.coyoteTime;
    else this._coyote -= h;
    this._jumpBuffer -= h;

    if (this._coyote > 0 && (this._jumpBuffer > 0 || (this.enabled && this.input.jumpHeld && this.onGround))) {
      this.vy = this.jumpSpeed;
      this.onGround = false;
      this._coyote = 0;
      this._jumpBuffer = 0;
      // Jumping out of a slide keeps its speed.
      if (this.sliding) this._endSlide();
    }

    if (this.sliding) {
      this._slideTime -= h;
      const sp = Math.hypot(this.vx, this.vz);
      const next = this.onGround ? Math.max(0, sp - this.slideFriction * h) : sp;
      if (sp > 0) {
        this.vx *= next / sp;
        this.vz *= next / sp;
      }
      // Hitting a wall (velocity zeroed by collision) also ends the slide.
      if (this._slideTime <= 0 || next < this.slideEndSpeed) this._endSlide();
    }

    // Horizontal velocity: move toward the wished velocity.
    let mx = this._move.x;
    let mz = this._move.y;
    const len = Math.hypot(mx, mz);
    if (len > 1) { mx /= len; mz /= len; }
    const hasWish = mx !== 0 || mz !== 0;

    if (!this.sliding && (this.onGround || hasWish)) {
      const speed = (this.sprinting ? this.sprintSpeed : this.walkSpeed) * this.speedScale *
        (this.crouching ? this.crouchSpeedScale : 1);
      const sin = Math.sin(this.yaw);
      const cos = Math.cos(this.yaw);
      // Camera looks down -Z at yaw 0; right is +X.
      const targetX = (cos * mx - sin * mz) * speed;
      const targetZ = (-sin * mx - cos * mz) * speed;

      const accel = this.onGround ? this.groundAccel : this.airAccel;
      const dx = targetX - this.vx;
      const dz = targetZ - this.vz;
      const dist = Math.hypot(dx, dz);
      const maxChange = accel * h;
      if (dist <= maxChange) {
        this.vx = targetX;
        this.vz = targetZ;
      } else {
        this.vx += (dx / dist) * maxChange;
        this.vz += (dz / dist) * maxChange;
      }
    }

    // Gravity.
    this.vy -= this.gravity * h;
    if (this.vy < -this.terminalVelocity) this.vy = -this.terminalVelocity;

    // Move one axis at a time so the player slides along walls.
    this._moveX(this.vx * h);
    this._moveZ(this.vz * h);
    this._moveY(this.vy * h);
  }

  _overlapping() {
    const r = this.radius;
    return this.collision.overlapping(
      this.x - r, this.y, this.z - r,
      this.x + r, this.y + this.height, this.z + r
    );
  }

  _moveX(dx) {
    if (dx === 0) return;
    this.x += dx;
    const hits = this._overlapping();
    if (hits.length === 0) return;
    if (this.onGround && this._tryStepUp(hits)) return;
    const r = this.radius;
    for (let i = 0; i < hits.length; i++) {
      const b = hits[i];
      this.x = dx > 0
        ? Math.min(this.x, b.minX - r - SKIN)
        : Math.max(this.x, b.maxX + r + SKIN);
    }
    this.vx = 0;
  }

  _moveZ(dz) {
    if (dz === 0) return;
    this.z += dz;
    const hits = this._overlapping();
    if (hits.length === 0) return;
    if (this.onGround && this._tryStepUp(hits)) return;
    const r = this.radius;
    for (let i = 0; i < hits.length; i++) {
      const b = hits[i];
      this.z = dz > 0
        ? Math.min(this.z, b.minZ - r - SKIN)
        : Math.max(this.z, b.maxZ + r + SKIN);
    }
    this.vz = 0;
  }

  _moveY(dy) {
    this.y += dy;
    const hits = this._overlapping();
    if (hits.length === 0) {
      this.onGround = false;
      return;
    }
    if (dy <= 0) {
      // Landed on top of something.
      let top = -Infinity;
      for (let i = 0; i < hits.length; i++) top = Math.max(top, hits[i].maxY);
      const impact = -this.vy;
      this.y = top;
      this.onGround = true;
      if (impact > 3 && this.onLand) this.onLand(impact);
    } else {
      // Bumped a ceiling.
      let bottom = Infinity;
      for (let i = 0; i < hits.length; i++) bottom = Math.min(bottom, hits[i].minY);
      this.y = bottom - this.height - SKIN;
      this.onGround = false;
    }
    this.vy = 0;
  }

  /**
   * After a horizontal move ended inside geometry: if everything we hit is a
   * low ledge and there is headroom on top, climb onto it instead of stopping.
   */
  _tryStepUp(hits) {
    let top = this.y;
    for (let i = 0; i < hits.length; i++) top = Math.max(top, hits[i].maxY);
    const rise = top - this.y;
    if (rise <= 0 || rise > this.stepHeight) return false;

    const r = this.radius;
    if (this.collision.intersects(
      this.x - r, top, this.z - r,
      this.x + r, top + this.height, this.z + r
    )) {
      return false;
    }
    this.y = top;
    return true;
  }

  _startSlide() {
    let dx = this.vx;
    let dz = this.vz;
    let sp = Math.hypot(dx, dz);
    if (sp < 0.5) {
      dx = -Math.sin(this.yaw);
      dz = -Math.cos(this.yaw);
      sp = 1;
    }
    const speed = Math.max(this.slideSpeed, Math.hypot(this.vx, this.vz) * 1.15);
    this.vx = (dx / sp) * speed;
    this.vz = (dz / sp) * speed;
    this.sliding = true;
    this.sprinting = false;
    this._slideTime = this.slideDuration;
  }

  _endSlide() {
    this.sliding = false;
    this._slideCd = this.slideCooldown;
  }

  _canStand() {
    const r = this.radius;
    return !this.collision.intersects(
      this.x - r, this.y, this.z - r,
      this.x + r, this.y + this.standHeight, this.z + r
    );
  }

  /** Weapon recoil: pitch up (radians, positive = up) and yaw. */
  kick(dPitch, dYaw) {
    this.pitch = Math.max(-MAX_PITCH, Math.min(MAX_PITCH, this.pitch + dPitch));
    this.yaw += dYaw;
    this._syncCamera();
  }

  _syncCamera() {
    this.camera.position.set(this.x, this.y + this.eyeHeight, this.z);
    this.camera.rotation.set(this.pitch, this.yaw, this.roll + this.slideRoll + this.deathRoll);
  }
}

// ===== js/player/Health.js =====
const HEALTH_MAX = 100;
const HEALTH_RESPAWN_DELAY = 3; // seconds dead before respawning
const HEALTH_SPAWN_PROTECTION = 2; // seconds of invulnerability after a respawn
const HEALTH_FALL_SAFE_SPEED = 11; // m/s landing speed with no damage (about a 5 m drop)
const HEALTH_FALL_DAMAGE = 9; // damage per m/s above the safe speed
const HEALTH_MEDKIT_HEAL = 35;
const HEALTH_MEDKIT_RESPAWN = 30; // seconds

/**
 * Player health. Pure game logic (no rendering), so a server can run it too.
 * Damage comes in through damage(amount, cause); medkits come from `spots`.
 * Listener arrays: onDeath(cause), onRespawn(), onPickup().
 */
class Health {
  constructor({ player, spots }) {
    this.player = player;
    this.max = HEALTH_MAX;
    this.value = HEALTH_MAX;
    this.dead = false;
    this.cause = '';
    this.deathTimer = 0;
    this.invulnerable = 0;
    this.hurt = 0; // 0..1 red flash, decays
    this.time = 0;
    this.onDeath = [];
    this.onRespawn = [];
    this.onPickup = [];
    /** Optional () => spawn point, used on every respawn. */
    this.chooseSpawn = null;
    /** Who caused the last damage: 'me' (own grenade, fall...) or 'other'. */
    this.lastOwner = 'me';
    /** Medkits: { x, y, z, active, timer }. */
    this.pickups = spots.map((s) => ({ x: s.x, y: s.y, z: s.z, room: s.room, enabled: true, active: true, timer: 0 }));
    player.onLand = (speed) => this._fall(speed);
  }

  /** Medkits exist only in the rooms of the current map. */
  setRooms(rooms) {
    for (const k of this.pickups) {
      k.enabled = !k.room || rooms.has(k.room);
      k.active = true;
      k.timer = 0;
    }
  }

  /** Returns the damage actually applied. */
  damage(amount, cause, owner) {
    if (this.dead || this.invulnerable > 0 || amount <= 0) return 0;
    const applied = Math.min(this.value, amount);
    this.value -= applied;
    this.lastOwner = owner || 'me';
    this.hurt = Math.min(1, this.hurt + 0.25 + amount / 60);
    if (this.value <= 0.0001) {
      this.value = 0;
      this._die(cause);
    }
    return applied;
  }

  heal(amount) {
    if (this.dead) return;
    this.value = Math.min(this.max, this.value + amount);
  }

  _fall(speed) {
    if (speed > HEALTH_FALL_SAFE_SPEED) this.damage((speed - HEALTH_FALL_SAFE_SPEED) * HEALTH_FALL_DAMAGE, 'fall', 'me');
  }

  _die(cause) {
    this.dead = true;
    this.cause = cause;
    this.deathTimer = HEALTH_RESPAWN_DELAY;
    this.player.enabled = false;
    for (const f of this.onDeath) f(cause);
  }

  respawn() {
    this.value = this.max;
    this.dead = false;
    this.hurt = 0;
    this.invulnerable = HEALTH_SPAWN_PROTECTION;
    this.player.enabled = true;
    if (this.chooseSpawn) this.player.spawn = this.chooseSpawn();
    this.player.respawn();
    for (const f of this.onRespawn) f();
  }

  update(dt) {
    this.time += dt;
    this.hurt = Math.max(0, this.hurt - dt * 1.5);
    this.invulnerable = Math.max(0, this.invulnerable - dt);

    if (this.dead) {
      this.deathTimer -= dt;
      if (this.deathTimer <= 0) this.respawn();
      return;
    }

    const p = this.player;
    for (const k of this.pickups) {
      if (!k.enabled) continue;
      if (!k.active) {
        k.timer -= dt;
        if (k.timer <= 0) k.active = true;
        continue;
      }
      if (this.value >= this.max) continue;
      if (Math.hypot(p.x - k.x, p.z - k.z) < 1.0 && p.y < k.y + 1.6 && p.y + p.height > k.y) {
        k.active = false;
        k.timer = HEALTH_MEDKIT_RESPAWN;
        this.heal(HEALTH_MEDKIT_HEAL);
        for (const f of this.onPickup) f();
      }
    }
  }
}

// ===== js/world/BoxGeometry.js =====
/**
 * A box whose UVs are scaled to world size, so a texture keeps the same
 * texel density on every face no matter how large the box is.
 * `tile` is the world size in metres covered by one texture repeat.
 */
function createBoxGeometry(width, height, depth, tile) {
  const geometry = new THREE.BoxGeometry(width, height, depth);
  const uv = geometry.attributes.uv;

  // BoxGeometry face order: +x, -x, +y, -y, +z, -z (4 vertices each).
  const faceSizes = [
    [depth, height], [depth, height],
    [width, depth], [width, depth],
    [width, height], [width, height],
  ];

  for (let face = 0; face < 6; face++) {
    const scaleU = faceSizes[face][0] / tile;
    const scaleV = faceSizes[face][1] / tile;
    for (let i = 0; i < 4; i++) {
      const index = face * 4 + i;
      uv.setXY(index, uv.getX(index) * scaleU, uv.getY(index) * scaleV);
    }
  }
  uv.needsUpdate = true;
  return geometry;
}

// ===== js/world/Textures.js =====
const SIZE = 64;

/** Small deterministic random generator so textures look the same every run. */
function mulberry32(seed) {
  return function () {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

/** Build a 64x64 texture by calling shade(x, y, rand) -> [r, g, b] per pixel. */
function paint(seed, shade) {
  const canvas = document.createElement('canvas');
  canvas.width = SIZE;
  canvas.height = SIZE;
  const ctx = canvas.getContext('2d');
  const image = ctx.createImageData(SIZE, SIZE);
  const data = image.data; // Uint8ClampedArray: values are rounded and clamped
  const rand = mulberry32(seed);

  for (let y = 0; y < SIZE; y++) {
    for (let x = 0; x < SIZE; x++) {
      const c = shade(x, y, rand);
      const i = (y * SIZE + x) * 4;
      data[i] = c[0];
      data[i + 1] = c[1];
      data[i + 2] = c[2];
      data[i + 3] = 255;
    }
  }
  ctx.putImageData(image, 0, 0);

  const texture = new THREE.CanvasTexture(canvas);
  texture.wrapS = THREE.RepeatWrapping;
  texture.wrapT = THREE.RepeatWrapping;
  texture.magFilter = THREE.NearestFilter; // chunky pixels up close
  texture.minFilter = THREE.NearestMipmapNearestFilter; // stable at a distance
  texture.colorSpace = THREE.SRGBColorSpace;
  texture.anisotropy = 1;
  return texture;
}

/** Procedural, muted, DOOM-ish textures. No image files needed. */
function createTextures() {
  return {
    concrete: paint(1, (x, y, r) => {
      let v = 128 + (r() - 0.5) * 20;
      const q = r();
      if (q < 0.04) v -= 26;
      else if (q > 0.985) v += 20;
      return [v, v, v - 2];
    }),

    floor: paint(2, (x, y, r) => {
      let v = 100 + (r() - 0.5) * 16;
      const gx = x % 32;
      const gy = y % 32;
      if (gx === 0 || gy === 0) v -= 36;
      else if (gx === 1 || gy === 1) v += 8;
      if (r() < 0.03) v -= 20;
      return [v, v, v + 1];
    }),

    panel: paint(3, (x, y, r) => {
      let v = 120 + (r() - 0.5) * 14;
      const gx = x % 32;
      const gy = y % 32;
      if (gx === 0 || gy === 0) v -= 40;
      else if (gx === 1 || gy === 1) v += 10;
      const rivetX = gx === 5 || gx === 6 || gx === 25 || gx === 26;
      const rivetY = gy === 5 || gy === 6 || gy === 25 || gy === 26;
      if (rivetX && rivetY) v += 26;
      if (r() < 0.02) v -= 18;
      return [v, v, v + 2];
    }),

    ceiling: paint(4, (x, y, r) => {
      let v = 88 + (r() - 0.5) * 12;
      if (x % 32 < 2 || y % 32 < 2) v -= 28;
      return [v, v, v + 2];
    }),

    crate: paint(5, (x, y, r) => {
      let k = 1 + (r() - 0.5) * 0.14;
      const edge = x < 4 || x > SIZE - 5 || y < 4 || y > SIZE - 5;
      const diagonal = Math.abs(x - y) < 3 || Math.abs(x + y - (SIZE - 1)) < 3;
      let c = [108, 84, 56];
      if (edge || diagonal) c = [80, 61, 39];
      else if (y % 16 === 0) k *= 0.75;
      if (x === 0 || y === 0 || x === SIZE - 1 || y === SIZE - 1) k *= 0.6;
      return [c[0] * k, c[1] * k, c[2] * k];
    }),

    hazard: paint(6, (x, y, r) => {
      const k = 1 + (r() - 0.5) * 0.12;
      const stripe = ((x + y) >> 3) & 1; // period 16 px: tiles seamlessly
      const c = stripe ? [156, 134, 46] : [40, 40, 38];
      return [c[0] * k, c[1] * k, c[2] * k];
    }),

    barrel: paint(7, (x, y, r) => {
      const k = 1 + (r() - 0.5) * 0.12;
      let c = [118, 44, 36]; // red explosive barrel
      if (y % 16 < 3) c = [150, 124, 44]; // yellow bands
      if (r() < 0.05) c = [70, 34, 28];
      return [c[0] * k, c[1] * k, c[2] * k];
    }),
  };
}

// ===== js/weapon/Ak47Model.js =====
const AK_TEX = 128;

/**
 * Paint a 128x128 canvas texture. `makeShade(rand)` returns a function
 * (x, y) -> [r, g, b]; it may precompute per-row or per-pixel data.
 */
function paintWeaponTexture(seed, makeShade) {
  const canvas = document.createElement('canvas');
  canvas.width = AK_TEX;
  canvas.height = AK_TEX;
  const ctx = canvas.getContext('2d');
  const image = ctx.createImageData(AK_TEX, AK_TEX);
  const data = image.data;
  const shade = makeShade(mulberry32(seed));

  for (let y = 0; y < AK_TEX; y++) {
    for (let x = 0; x < AK_TEX; x++) {
      const c = shade(x, y);
      const i = (y * AK_TEX + x) * 4;
      data[i] = c[0];
      data[i + 1] = c[1];
      data[i + 2] = c[2];
      data[i + 3] = 255;
    }
  }
  ctx.putImageData(image, 0, 0);

  const texture = new THREE.CanvasTexture(canvas);
  texture.wrapS = THREE.RepeatWrapping;
  texture.wrapT = THREE.RepeatWrapping;
  texture.colorSpace = THREE.SRGBColorSpace;
  return texture;
}

/** Random short horizontal scratches as a per-pixel mask. */
function scratchMask(rand, count) {
  const mask = new Uint8Array(AK_TEX * AK_TEX);
  for (let n = 0; n < count; n++) {
    const sx = Math.floor(rand() * AK_TEX);
    const sy = Math.floor(rand() * AK_TEX);
    const len = 6 + Math.floor(rand() * 22);
    for (let i = 0; i < len; i++) mask[sy * AK_TEX + ((sx + i) % AK_TEX)] = 1;
  }
  return mask;
}

/** Varnished walnut-brown wood with long grain streaks. */
function woodTexture() {
  return paintWeaponTexture(11, (rand) => {
    const rows = new Float32Array(AK_TEX);
    for (let y = 0; y < AK_TEX; y++) {
      rows[y] = Math.sin(y * 0.45) * 0.5 + Math.sin(y * 1.7 + 1.3) * 0.25 + (rand() - 0.5) * 0.6;
    }
    return (x, y) => {
      let k = 1 + 0.17 * rows[y] + 0.07 * Math.sin(x * 0.07 + y * 0.15) + (rand() - 0.5) * 0.07;
      if (rand() < 0.012) k *= 0.68; // pores
      return [122 * k, 68 * k, 34 * k];
    };
  });
}

/** Dark blued steel with brushed streaks, scratches and worn edges. */
function steelTexture() {
  return paintWeaponTexture(12, (rand) => {
    const scratch = scratchMask(rand, 70);
    return (x, y) => {
      let v = 44 + (rand() - 0.5) * 9 + Math.sin(y * 0.9) * 2;
      if (scratch[y * AK_TEX + x]) v += 34;
      const edge = x < 3 || y < 3 || x > AK_TEX - 4 || y > AK_TEX - 4;
      if (edge && rand() < 0.55) v += 52; // worn bare metal
      return [v, v + 1, v + 4];
    };
  });
}

/** Ribbed, slightly brownish stamped-steel magazine. */
function magTexture() {
  return paintWeaponTexture(13, (rand) => {
    const scratch = scratchMask(rand, 50);
    return (x, y) => {
      let v = 58 + (rand() - 0.5) * 10;
      const rib = y % 16;
      if (rib < 2) v -= 20;
      else if (rib === 2) v += 12;
      if (scratch[y * AK_TEX + x]) v += 30;
      if (x < 3 || x > AK_TEX - 4) v += 24;
      return [v + 6, v + 2, v - 4];
    };
  });
}

/** Soft star used for the muzzle flash. */
function flashTexture() {
  const size = 64;
  const canvas = document.createElement('canvas');
  canvas.width = size;
  canvas.height = size;
  const ctx = canvas.getContext('2d');
  const half = size / 2;
  const glow = ctx.createRadialGradient(half, half, 0, half, half, half);
  glow.addColorStop(0, 'rgba(255,250,220,1)');
  glow.addColorStop(0.3, 'rgba(255,200,110,0.85)');
  glow.addColorStop(1, 'rgba(255,120,30,0)');
  ctx.fillStyle = glow;
  ctx.fillRect(0, 0, size, size);
  ctx.globalCompositeOperation = 'lighter';
  for (let i = 0; i < 2; i++) {
    ctx.save();
    ctx.translate(half, half);
    ctx.rotate(i * Math.PI / 2);
    ctx.scale(1, 0.12);
    ctx.fillStyle = glow;
    ctx.beginPath();
    ctx.arc(0, 0, half, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();
  }
  return new THREE.CanvasTexture(canvas);
}

/**
 * Build the AK-47 viewmodel. Units are metres, the muzzle points down -Z.
 * The rear sight ears and the front sight post both top out at y = 0.075,
 * so aiming means placing the model at y = -0.075 in front of the eye.
 */
let sharedMaterials = null;

/** Wood, steel and magazine materials, built once and shared by every weapon. */
function createWeaponMaterials() {
  if (!sharedMaterials) {
    sharedMaterials = {
      woodMat: new THREE.MeshPhongMaterial({ map: woodTexture(), shininess: 22, specular: 0x2a1c10 }),
      steelMat: new THREE.MeshPhongMaterial({ map: steelTexture(), shininess: 45, specular: 0x3a3a3c }),
      magMat: new THREE.MeshPhongMaterial({ map: magTexture(), shininess: 30, specular: 0x2a2a2a }),
    };
  }
  return sharedMaterials;
}

let sharedFlashMaterial = null;

/** Muzzle flash: two crossed front-facing planes and one along the barrel. Hidden by default. */
function createMuzzleFlash() {
  if (!sharedFlashMaterial) {
    sharedFlashMaterial = new THREE.MeshBasicMaterial({
      map: flashTexture(),
      transparent: true,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
      fog: false,
    });
  }
  const flash = new THREE.Group();
  const starA = new THREE.Mesh(new THREE.PlaneGeometry(0.14, 0.14), sharedFlashMaterial);
  const starB = new THREE.Mesh(new THREE.PlaneGeometry(0.14, 0.14), sharedFlashMaterial);
  starB.rotation.z = Math.PI / 4;
  const sideGeometry = new THREE.PlaneGeometry(0.26, 0.06);
  sideGeometry.rotateY(Math.PI / 2);
  const side = new THREE.Mesh(sideGeometry, sharedFlashMaterial);
  side.position.z = -0.08;
  flash.add(starA, starB, side);
  flash.visible = false;
  return flash;
}

function createAk47() {
  const { woodMat, steelMat, magMat } = createWeaponMaterials();

  const root = new THREE.Group();

  const box = (parent, mat, w, h, d, x, y, z, rx) => {
    const mesh = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), mat);
    mesh.position.set(x, y, z);
    if (rx) mesh.rotation.x = rx;
    parent.add(mesh);
    return mesh;
  };
  const tube = (mat, radius, length, x, y, z) => {
    const geometry = new THREE.CylinderGeometry(radius, radius, length, 10, 1);
    geometry.rotateX(Math.PI / 2);
    const mesh = new THREE.Mesh(geometry, mat);
    mesh.position.set(x, y, z);
    root.add(mesh);
    return mesh;
  };

  // Receiver, dust cover, trigger guard.
  box(root, steelMat, 0.042, 0.062, 0.26, 0, 0, -0.10);
  box(root, steelMat, 0.038, 0.016, 0.22, 0, 0.040, -0.115);
  box(root, steelMat, 0.006, 0.010, 0.065, 0, -0.060, -0.03);

  // Barrel, gas tube, muzzle device.
  tube(steelMat, 0.0105, 0.60, 0, 0.012, -0.52);
  tube(steelMat, 0.0105, 0.28, 0, 0.0335, -0.41);
  tube(steelMat, 0.0125, 0.05, 0, 0.012, -0.835);

  // Handguards.
  box(root, woodMat, 0.044, 0.040, 0.23, 0, -0.004, -0.385);
  box(root, woodMat, 0.040, 0.022, 0.23, 0, 0.034, -0.385);

  // Iron sights: rear ears with a gap, front post on its base.
  box(root, steelMat, 0.030, 0.020, 0.040, 0, 0.040, -0.265);
  box(root, steelMat, 0.008, 0.025, 0.012, 0.0095, 0.0625, -0.27);
  box(root, steelMat, 0.008, 0.025, 0.012, -0.0095, 0.0625, -0.27);
  box(root, steelMat, 0.022, 0.034, 0.030, 0, 0.0395, -0.78);
  box(root, steelMat, 0.004, 0.0185, 0.004, 0, 0.06575, -0.78);

  // Pistol grip and stock.
  box(root, woodMat, 0.034, 0.10, 0.045, 0, -0.09, 0.01, -0.30);
  box(root, woodMat, 0.034, 0.07, 0.32, 0, -0.012, 0.19, 0.08);
  box(root, steelMat, 0.034, 0.09, 0.012, 0, -0.02, 0.355, 0.08);

  // Charging handle (slides back when the bolt is racked).
  const handleRestZ = -0.06;
  const handle = box(root, steelMat, 0.012, 0.014, 0.03, 0.026, 0.012, handleRestZ);

  // Curved magazine: five tilted segments under one pivot.
  const mag = new THREE.Group();
  const magRestY = -0.03;
  mag.position.set(0, magRestY, -0.135);
  for (let i = 0; i < 5; i++) {
    box(mag, magMat, 0.036, 0.07, 0.05, 0, -(0.035 + i * 0.063), -(i * i * 0.0045), i * 0.12);
  }
  root.add(mag);

  // Muzzle flash.
  const flash = createMuzzleFlash();
  flash.position.set(0, 0.012, -0.9);
  root.add(flash);

  /** r: { magY, magVisible, charge } from the reload animation. */
  const applyReload = (r) => {
    mag.position.y = magRestY + r.magY;
    mag.visible = r.magVisible;
    handle.position.z = handleRestZ + 0.055 * r.charge;
  };

  return { root, flash, applyReload };
}

// ===== js/weapon/RevolverModel.js =====
/**
 * Build a .357 revolver viewmodel. Units are metres, the muzzle points down -Z.
 * The rear sight ears and the front sight post both top out at y = 0.052,
 * so aiming means placing the model at y = -0.052 in front of the eye.
 * The cylinder advances one chamber per shot and swings out for reloads.
 */
function createRevolver() {
  const { woodMat, steelMat } = createWeaponMaterials();
  const root = new THREE.Group();

  const box = (mat, w, h, d, x, y, z, rx) => {
    const mesh = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), mat);
    mesh.position.set(x, y, z);
    if (rx) mesh.rotation.x = rx;
    root.add(mesh);
    return mesh;
  };
  const tube = (radius, length, x, y, z, segments) => {
    const geometry = new THREE.CylinderGeometry(radius, radius, length, segments, 1);
    geometry.rotateX(Math.PI / 2);
    const mesh = new THREE.Mesh(geometry, steelMat);
    mesh.position.set(x, y, z);
    root.add(mesh);
    return mesh;
  };

  // Frame: rear block and the top strap over the cylinder.
  box(steelMat, 0.030, 0.062, 0.055, 0, -0.004, 0.012);
  box(steelMat, 0.026, 0.020, 0.115, 0, 0.027, -0.045);
  box(steelMat, 0.028, 0.030, 0.040, 0, -0.022, -0.095); // frame below the cylinder

  // Barrel with a full underlug.
  tube(0.0095, 0.19, 0, 0.012, -0.215, 12);
  box(steelMat, 0.016, 0.014, 0.12, 0, -0.004, -0.185);

  // Sights: rear ears with a gap, front post on a ramp.
  box(steelMat, 0.006, 0.012, 0.010, 0.0075, 0.046, 0.012);
  box(steelMat, 0.006, 0.012, 0.010, -0.0075, 0.046, 0.012);
  box(steelMat, 0.010, 0.016, 0.020, 0, 0.0295, -0.30);
  box(steelMat, 0.004, 0.0145, 0.004, 0, 0.04475, -0.30);

  // Hammer, trigger guard, grip.
  box(steelMat, 0.008, 0.022, 0.018, 0, 0.032, 0.046, -0.25);
  box(steelMat, 0.006, 0.010, 0.05, 0, -0.040, -0.005);
  box(woodMat, 0.032, 0.10, 0.05, 0, -0.075, 0.055, -0.30);

  // Cylinder on a swing-out crane: pivot at the lower left of the frame.
  const crane = new THREE.Group();
  crane.position.set(-0.025, -0.022, -0.06);
  const drum = new THREE.Mesh(new THREE.CylinderGeometry(0.022, 0.022, 0.045, 12, 1).rotateX(Math.PI / 2), steelMat);
  drum.position.set(0.025, 0.022, 0);
  crane.add(drum);
  root.add(crane);

  const flash = createMuzzleFlash();
  flash.position.set(0, 0.012, -0.325);
  root.add(flash);

  let spinTarget = 0;
  let spin = 0;
  let reloadSpin = 0;

  /** r: { magY: cylinder swing-out 0..1, charge: spin while loading 0..1 }. */
  const applyReload = (r) => {
    crane.rotation.z = 1.0 * r.magY;
    reloadSpin = r.charge * Math.PI * 2;
  };

  return {
    root,
    flash,
    applyReload,
    onShot() { spinTarget += Math.PI / 3; },
    update(dt) {
      spin += (spinTarget - spin) * Math.min(1, dt * 30);
      drum.rotation.z = spin + reloadSpin;
    },
  };
}

