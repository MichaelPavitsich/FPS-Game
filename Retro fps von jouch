  /**
   * A straight wall along x (at z = fixed) or along z (at x = fixed), with doors and windows.
   * openings: [{ a, b, type: 'door' | 'window' }] in coordinates along the wall.
   */
  _wall(kind, axis, fixed, a0, a1, y0, y1, thick, openings) {
    const box = (lo, hi, ylo, yhi) => {
      if (hi - lo < 0.01 || yhi - ylo < 0.01) return;
      if (axis === 'x') this._solid(kind, lo, ylo, fixed - thick / 2, hi, yhi, fixed + thick / 2);
      else this._solid(kind, fixed - thick / 2, ylo, lo, fixed + thick / 2, yhi, hi);
    };
    let cur = a0;
    for (const o of (openings || []).slice().sort((p, q) => p.a - q.a)) {
      box(cur, o.a, y0, y1);
      const h0 = o.type === 'window' ? y0 + 1.0 : y0;
      const h1 = o.type === 'window' ? y0 + 2.3 : y0 + 2.6;
      if (h0 > y0) box(o.a, o.b, y0, h0);
      box(o.a, o.b, h1, y1);
      cur = o.b;
    }
    box(cur, a1, y0, y1);
  }

  /** Steps of 0.3 m rise from y0, starting at (x0, z0) and running in direction dir ('+x', '-x', '+z', '-z'). */
  _stairs(kind, x0, z0, dir, width, steps, rise, depth, y0) {
    for (let i = 0; i < steps; i++) {
      const top = y0 + rise * (i + 1);
      const a = i * depth, b = (i + 1) * depth;
      if (dir === '+x') this._solid(kind, x0 + a, y0, z0, x0 + b, top, z0 + width);
      else if (dir === '-x') this._solid(kind, x0 - b, y0, z0, x0 - a, top, z0 + width);
      else if (dir === '+z') this._solid(kind, x0, y0, z0 + a, x0 + width, top, z0 + b);
      else this._solid(kind, x0, y0, z0 - b, x0 + width, top, z0 - a);
    }
  }

  /**
   * A building shell. o: x0, z0, x1, z1, floors (1 or 2), kind, n/s/w/e (ground floor openings),
   * un/us/uw/ue (upper floor openings), part (interior wall), stair { x, z, dir, w }.
   */
  _house(o) {
    const T = 0.4, H = o.h || 3.4, U = 3.2, kind = o.kind || 'sand';
    const { x0, z0, x1, z1 } = o;
    this._wall(kind, 'x', z0 + T / 2, x0, x1, 0, H, T, o.n);
    this._wall(kind, 'x', z1 - T / 2, x0, x1, 0, H, T, o.s);
    this._wall(kind, 'z', x0 + T / 2, z0 + T, z1 - T, 0, H, T, o.w);
    this._wall(kind, 'z', x1 - T / 2, z0 + T, z1 - T, 0, H, T, o.e);
    if (o.part) this._wall(kind, o.part.axis, o.part.pos, o.part.from, o.part.to, 0, H, T, o.part.doors);
    let roofY = H;
    if (o.floors === 2) {
      const top = H + T;
      const hole = o.hole; // [hx0, hz0, hx1, hz1]
      this._solid(kind, x0, H, z0, hole[0], top, z1);
      this._solid(kind, hole[2], H, z0, x1, top, z1);
      this._solid(kind, hole[0], H, z0, hole[2], top, hole[1]);
      this._solid(kind, hole[0], H, hole[3], hole[2], top, z1);
      this._wall(kind, 'x', z0 + T / 2, x0, x1, top, top + U, T, o.un);
      this._wall(kind, 'x', z1 - T / 2, x0, x1, top, top + U, T, o.us);
      this._wall(kind, 'z', x0 + T / 2, z0 + T, z1 - T, top, top + U, T, o.uw);
      this._wall(kind, 'z', x1 - T / 2, z0 + T, z1 - T, top, top + U, T, o.ue);
      if (o.part) this._wall(kind, o.part.axis, o.part.pos, o.part.from, o.part.to, top, top + U, T, o.part.udoors || o.part.doors);
      roofY = top + U;
      // Parapet on the roof.
      this._solid(kind, x0, roofY + T, z0, x1, roofY + T + 0.9, z0 + 0.25);
      this._solid(kind, x0, roofY + T, z1 - 0.25, x1, roofY + T + 0.9, z1);
      this._solid(kind, x0, roofY + T, z0, x0 + 0.25, roofY + T + 0.9, z1);
      this._solid(kind, x1 - 0.25, roofY + T, z0, x1, roofY + T + 0.9, z1);
    }
    this._solid(kind, x0, roofY, z0, x1, roofY + T, z1);
  }

  /** Windows spaced along a wall from a0 to a1, skipping the given [a, b] ranges. */
  _windows(a0, a1, skip) {
    const out = [];
    for (let a = a0 + 1.5; a + 2.4 <= a1 - 1.5; a += 4.6) {
      if ((skip || []).some((r) => a < r[1] + 0.6 && a + 2.4 > r[0] - 0.6)) continue;
      out.push({ a, b: a + 2.4, type: 'window' });
    }
    return out;
  }

