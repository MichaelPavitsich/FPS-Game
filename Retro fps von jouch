// ===== js/weapon/ViewHands.js =====
/** Where the left hand goes to fetch a fresh magazine, shell or round: low and to the left, out of view. */
const HAND_AWAY = [-0.12, -0.30, 0.08];

const hLerp = (a, b, k) => [a[0] + (b[0] - a[0]) * k, a[1] + (b[1] - a[1]) * k, a[2] + (b[2] - a[2]) * k];
const hEase = (a, b, t) => specEase(a, b, t);

/**
 * First-person hands for a viewmodel. The right hand holds the grip. The left
 * hand holds the front of the gun and does the reloading: it follows the
 * reload timeline of the weapon kind:
 *  'mag'      pull the magazine out, take it away, bring a fresh one, seat it, rack the bolt if empty
 *  'revolver' open the cylinder, bring rounds, load, close
 *  'shells'   fetch a shell, push it in, repeat (once per shell cycle)
 *  'bolt'     right hand works the bolt, left hand brings the rounds
 * cfg anchors are in the weapon's own model space:
 *  G grip, F front hold, M magazine well (or cylinder), C bolt / slide / charging handle, P loading port.
 */
class ViewHands {
  constructor(parent, cfg, scene) {
    this.cfg = cfg;
    this.root = new THREE.Group();
    parent.add(this.root);
    const skin = new THREE.MeshLambertMaterial({ color: 0xc89a74 });
    const sleeve = new THREE.MeshLambertMaterial({ color: 0x46543a });
    const gloveDark = new THREE.MeshLambertMaterial({ color: 0x2c3326 });
    skin.name = 'skin';
    sleeve.name = 'sleeve';
    const make = (side) => {
      const g = new THREE.Group();
      g.rotation.order = 'YXZ';
      const fist = new THREE.Mesh(new THREE.BoxGeometry(0.054, 0.046, 0.085), skin);
      const thumb = new THREE.Mesh(new THREE.BoxGeometry(0.017, 0.017, 0.055), skin);
      thumb.position.set(-0.026 * side, 0.026, -0.012);
      const cuff = new THREE.Mesh(new THREE.BoxGeometry(0.066, 0.058, 0.05), gloveDark);
      cuff.position.set(0, 0, 0.065);
      const arm = new THREE.Group(); // forearm slopes down and out towards the camera
      arm.rotation.order = 'YXZ';
      arm.rotation.x = 0.32;
      arm.rotation.y = 0.32 * side;
      const sleeveBox = new THREE.Mesh(new THREE.BoxGeometry(0.07, 0.07, 0.5), sleeve);
      sleeveBox.position.set(0, 0, 0.33);
      arm.add(sleeveBox);
      g.add(fist, thumb, cuff, arm);
      return g;
    };
    this.left = make(-1);
    this.right = make(1);
    this.root.add(this.left, this.right);

    // What the left hand carries while it fetches: a magazine, rounds or a shell.
    const kind = cfg.kind;
    const carryMat = new THREE.MeshLambertMaterial({ color: kind === 'mag' ? 0x2b2b2d : kind === 'shells' ? 0xa83a2a : 0xc9a24a });
    carryMat.name = 'carry';
    const size = kind === 'mag' ? [0.03, 0.11 * (cfg.carryScale || 1), 0.045] : kind === 'shells' ? [0.024, 0.024, 0.07] : [0.04, 0.022, 0.05];
    this.carry = new THREE.Mesh(new THREE.BoxGeometry(size[0], size[1], size[2]), carryMat);
    this.carry.position.set(0, kind === 'mag' ? -0.05 : 0, -0.01);
    this.carry.visible = false;
    this.left.add(this.carry);

    this.lp = cfg.F.slice();
    this.rp = cfg.G.slice();
    this._first = true;

    // The magazine that gets dropped: a loose box in the view scene with a little gravity.
    this.scene = scene || parent.parent || null;
    this.prevT = 0;
    this.dropAge = -1;
    this.dropV = [0, 0, 0];
    this.drop = null;
    if (cfg.kind === 'mag' && this.scene) {
      this.drop = new THREE.Mesh(new THREE.BoxGeometry(0.03, 0.11 * (cfg.carryScale || 1), 0.045), carryMat);
      this.drop.visible = false;
      this.scene.add(this.drop);
    }
  }

  _spawnDrop() {
    if (!this.drop || !this.left.getWorldPosition || !THREE.Vector3) return;
    const v = new THREE.Vector3();
    this.left.getWorldPosition(v);
    this.drop.position.copy(v);
    this.drop.rotation.set(0, 0, 0);
    this.dropV = [-0.25, -0.05, -0.15];
    this.dropAge = 0;
    this.drop.visible = true;
  }

  /**
   * t: reload phase 0..1 (a shell cycle for 'shells'), r: the reload pose output
   * (magY, charge), empty: the weapon was empty when the reload began.
   */
  update(dt, reloading, t, empty, r) {
    const c = this.cfg;
    let L = c.F;
    let R = c.G;
    let carry = false;
    if (reloading) {
      const A = c.A || HAND_AWAY;
      if (c.kind === 'mag') {
        const ms = c.magScale || 1;
        const follow = [c.M[0], c.M[1] + r.magY * ms, c.M[2]];
        const out = [c.M[0], c.M[1] - 0.3 * ms, c.M[2]];
        if (t < 0.16) L = hLerp(c.F, c.M, hEase(0, 0.16, t));
        else if (t < 0.34) L = follow;
        else if (t < 0.44) L = hLerp(out, A, hEase(0.34, 0.44, t));
        else if (t < 0.52) L = hLerp(A, out, hEase(0.44, 0.52, t));
        else if (t < 0.72) L = follow;
        else if (empty) {
          const back = [c.C[0], c.C[1], c.C[2] + (c.backZ || 0.05) * r.charge];
          if (t < 0.78) L = hLerp(c.M, c.C, hEase(0.72, 0.78, t));
          else if (t < 0.92) L = back;
          else L = hLerp(c.C, c.F, hEase(0.92, 1, t));
        } else {
          L = hLerp(c.M, c.F, hEase(0.74, 0.92, t));
        }
        carry = t >= 0.34 && t < 0.52;
      } else if (c.kind === 'revolver') {
        if (t < 0.14) L = hLerp(c.F, c.M, hEase(0, 0.14, t));
        else if (t < 0.5) L = c.M;
        else if (t < 0.58) L = hLerp(c.M, A, hEase(0.5, 0.58, t));
        else if (t < 0.66) L = hLerp(A, c.M, hEase(0.58, 0.66, t));
        else if (t < 0.8) L = c.M;
        else L = hLerp(c.M, c.F, hEase(0.8, 0.9, t));
        carry = t >= 0.54 && t < 0.72;
      } else if (c.kind === 'shells') {
        if (t < 0.4) L = hLerp(A, c.P, hEase(0, 0.4, t));
        else if (t < 0.5) L = c.P;
        else L = hLerp(c.P, A, hEase(0.5, 0.9, t));
        carry = t < 0.46;
      } else if (c.kind === 'bolt') {
        // Left hand: two rounds, one after the other.
        if (t < 0.26) L = hLerp(c.F, A, hEase(0.1, 0.26, t));
        else if (t < 0.72) {
          const q = ((t - 0.26) / 0.46) * 2;
          const f = q - Math.floor(q);
          L = f < 0.55 ? hLerp(A, c.P, hEase(0, 0.5, f)) : hLerp(c.P, A, hEase(0.55, 1, f));
          carry = f < 0.5;
        } else L = hLerp(A, c.F, hEase(0.72, 0.9, t));
        // Right hand: opens the bolt, lets go, closes it again.
        const b = hEase(0.1, 0.16, t) - hEase(0.28, 0.34, t) + hEase(0.64, 0.7, t) - hEase(0.8, 0.86, t);
        R = hLerp(c.G, [c.C[0], c.C[1], c.C[2] + (c.backZ || 0.06) * r.charge], b);
      }
    }
    const k = this._first ? 1 : Math.min(1, dt * 26);
    this._first = false;
    for (let i = 0; i < 3; i++) {
      this.lp[i] += (L[i] - this.lp[i]) * k;
      this.rp[i] += (R[i] - this.rp[i]) * k;
    }
    this.left.position.set(this.lp[0], this.lp[1], this.lp[2]);
    this.right.position.set(this.rp[0], this.rp[1], this.rp[2]);
    this.carry.visible = carry;

    if (this.drop) {
      // The old magazine is let go the moment the hand takes it away.
      if (reloading && this.prevT < 0.34 && t >= 0.34) this._spawnDrop();
      this.prevT = reloading ? t : 0;
      if (this.dropAge >= 0) {
        this.dropAge += dt;
        this.dropV[1] -= 2.6 * dt;
        this.drop.position.x += this.dropV[0] * dt;
        this.drop.position.y += this.dropV[1] * dt;
        this.drop.position.z += this.dropV[2] * dt;
        this.drop.rotation.x += 5 * dt;
        this.drop.rotation.z += 3 * dt;
        if (this.dropAge > 0.9) { this.dropAge = -1; this.drop.visible = false; }
      }
    }
  }
}

// ===== js/net/Net.js =====
const PEER_PREFIX = 'retrofps-m7-';
const PEERJS_URLS = [
  'https://cdn.jsdelivr.net/npm/peerjs@1.5.4/dist/peerjs.min.js',
  'https://cdnjs.cloudflare.com/ajax/libs/peerjs/1.5.4/peerjs.min.js',
  'https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js',
];
const CODE_CHARS = 'ABCDEFGHJKMNPQRSTUVWXYZ23456789'; // no 0/O, 1/I/L

/** Load PeerJS (WebRTC helper) on first use. Resolves to the Peer class or null. */
function loadPeerJs() {
  if (window.Peer) return Promise.resolve(window.Peer);
  return new Promise((resolve) => {
    let i = 0;
    const next = () => {
      if (i >= PEERJS_URLS.length) { resolve(null); return; }
      const tag = document.createElement('script');
      tag.src = PEERJS_URLS[i++];
      tag.onload = () => (window.Peer ? resolve(window.Peer) : next());
      tag.onerror = next;
      document.head.appendChild(tag);
    };
    next();
  });
}

/**
 * Multiplayer connection. Three ways in, one interface for the game:
 *  - host(mode):  this browser hosts a peer-to-peer match and gets a short code.
 *                 mode 'pvp' = 1v1 (2 players), 'coop' = zombie defense (up to 3).
 *  - join(code):  connect to a friend's hosted match
 *  - connect(url): a WebSocket relay server (the original 1v1 server version)
 * Messages are small JSON objects: { t: 'type', ... }; the host stamps each
 * with `from` (player id) and does the server's job (relaying, damage, score).
 * status: 'offline' | 'connecting' | 'connected' | 'full' | 'error'
 */
class Net {
  constructor() {
    this.ws = null;
    this.status = 'offline';
    this.mode = null; // 'ws' | 'host' | 'guest'
    this.roomMode = 'pvp'; // 'pvp' | 'coop'
    this.mapSize = 'middle'; // 'small' | 'middle' | 'large', chosen by the host
    this.code = ''; // match code (peer-to-peer)
    this.error = ''; // reason for the last 'error' status
    this.id = 0; // my player id (1 = host) once welcomed
    this.players = new Set(); // ids of the other players present
    this.teams = {}; // player id -> team (0 / 1) in team matches
    this.team = 0; // my team
    this._latest = {}; // host, team matches: newest state of every player
    this._flushT = 0;
    this.score = [0, 0]; // 1v1 kills for player 1 and player 2
    this.handlers = {};
    this.onStatus = null;
    this._peerObj = null;
    this._conn = null; // guest: connection to the host
    this._guests = new Map(); // host: id -> connection
    this._joinTimer = 0;
  }

  get online() {
    return this.status === 'connected';
  }

  /** Is anyone else here? */
  get peer() {
    return this.players.size > 0;
  }

  get maxPlayers() {
    return this.roomMode === 'coop' ? 3 : this.roomMode === 'tdm' ? 10 : 2;
  }

  /** The smaller team gets the next player (a tie goes to team 0). */
  _pickTeam() {
    if (this.roomMode !== 'tdm') return 0;
    const n = [0, 0];
    for (const id of Object.keys(this.teams)) n[this.teams[id] ? 1 : 0]++;
    return n[1] < n[0] ? 1 : 0;
  }

  on(type, fn) {
    this.handlers[type] = fn;
  }

  // --- Peer-to-peer --------------------------------------------------------

  async host(roomMode, mapSize) {
    this.disconnect();
    this.mode = 'host';
    this.mapSize = mapSize || 'middle';
    this.roomMode = roomMode === 'coop' ? 'coop' : roomMode === 'tdm' ? 'tdm' : 'pvp';
    this._set('connecting');
    const Peer = await loadPeerJs();
    if (this.mode !== 'host') return; // cancelled meanwhile
    if (!Peer) { this._fail('lib'); return; }
    this.score = [0, 0];
    const open = (attempt) => {
      let code = '';
      for (let i = 0; i < 5; i++) code += CODE_CHARS[Math.floor(Math.random() * CODE_CHARS.length)];
      const peer = new Peer(PEER_PREFIX + code, { debug: 0 });
      this._peerObj = peer;
      peer.on('open', () => {
        if (this._peerObj !== peer) return;
        this.code = code;
        this.teams = { 1: 0 };
        this._receive({ t: 'welcome', id: 1, players: [], mode: this.roomMode, map: this.mapSize, team: 0, teams: { 1: 0 }, s: this.score.slice() });
      });
      peer.on('connection', (conn) => {
        conn.on('open', () => {
          if (this._peerObj !== peer) { conn.close(); return; }
          let id = 0;
          for (let n = 2; n <= this.maxPlayers; n++) if (!this._guests.has(n)) { id = n; break; }
          if (!id) {
            conn.send({ t: 'full' });
            setTimeout(() => conn.close(), 300);
            return;
          }
          conn._pid = id;
          this._guests.set(id, conn);
          if (this.roomMode === 'pvp') this.score = [0, 0];
          const team = this._pickTeam();
          this.teams[id] = team;
          const others = [1];
          for (const g of this._guests.keys()) if (g !== id) others.push(g);
          conn.send({ t: 'welcome', id, players: others, peer: true, mode: this.roomMode, map: this.mapSize, team, teams: Object.assign({}, this.teams), s: this.score.slice() });
          this._broadcast({ t: 'peer', present: true, id, team }, id);
          this._receive({ t: 'peer', present: true, id, team });
          if (this.roomMode === 'pvp') this._receive({ t: 'score', s: this.score.slice(), victim: 0, killer: 0, quiet: 1 });
        });
        conn.on('data', (m) => { if (conn._pid) this._serve(conn._pid, m); });
        const gone = () => {
          const id = conn._pid;
          if (!id || this._guests.get(id) !== conn) return;
          this._guests.delete(id);
          delete this.teams[id];
          delete this._latest[id];
          this._broadcast({ t: 'peer', present: false, id }, id);
          this._receive({ t: 'peer', present: false, id });
        };
        conn.on('close', gone);
        conn.on('error', gone);
      });
      peer.on('error', (err) => {
        if (this._peerObj !== peer) return;
        if (err.type === 'unavailable-id' && attempt < 4) { peer.destroy(); open(attempt + 1); return; }
        if (err.type === 'peer-unavailable') return; // not relevant for the host
        if (this.status !== 'connected') this._fail(err.type || 'error');
      });
      // Lost the matchmaking server only: an established match keeps running.
      peer.on('disconnected', () => { try { if (!peer.destroyed) peer.reconnect(); } catch (_) { /* ignore */ } });
    };
    open(0);
  }

  async join(rawCode) {
    const code = String(rawCode || '').toUpperCase().replace(/[^A-Z0-9]/g, '');
    this.disconnect();
    if (code.length < 4) { this._fail('code'); return; }
    this.mode = 'guest';
    this.code = code;
    this._set('connecting');
    const Peer = await loadPeerJs();
    if (this.mode !== 'guest') return;
    if (!Peer) { this._fail('lib'); return; }
    const peer = new Peer({ debug: 0 });
    this._peerObj = peer;
    peer.on('open', () => {
      if (this._peerObj !== peer) return;
      const conn = peer.connect(PEER_PREFIX + code, { reliable: true });
      this._conn = conn;
      conn.on('data', (m) => this._receive(m));
      const gone = () => {
        if (this._conn !== conn) return;
        this._conn = null;
        if (this.status === 'connecting') this._fail('timeout');
        else this._lost();
      };
      conn.on('close', gone);
      conn.on('error', gone);
    });
    peer.on('error', (err) => {
      if (this._peerObj !== peer) return;
      if (this.status === 'connecting') this._fail(err.type || 'error');
    });
    clearTimeout(this._joinTimer);
    this._joinTimer = setTimeout(() => { if (this.mode === 'guest' && this.status === 'connecting') this._fail('timeout'); }, 15000);
  }

  /** The host plays server: handle a message sent by player `from` (1 = me). */
  _serve(from, m) {
    if (!m || typeof m.t !== 'string') return;
    const msg = Object.assign({}, m, { from });
    switch (m.t) {
      case 's':
        if (this.roomMode === 'tdm') {
          // Team matches: states are batched and sent a few times a second (see flush).
          this._latest[from] = m;
          if (from !== 1) this._receive(msg);
          break;
        }
        if (from !== 1) this._receive(msg);
        this._broadcast(msg, from);
        break;
      case 'hit': { // my bullet hit player `to`
        const to = m.to || (from === 1 ? 2 : 1);
        if (this.roomMode === 'tdm' && (this.teams[from] === undefined || this.teams[from] === this.teams[to])) break; // no friendly fire
        if (to !== from && typeof m.dmg === 'number') this._deliver(to, { t: 'dmg', dmg: m.head ? HEAD_ONE_SHOT : Math.min(250, Math.max(0, m.dmg)), head: m.head ? 1 : 0, from });
        break;
      }
      case 'died': {
        if (this.roomMode === 'tdm') {
          this._receive(msg); // the host's match logic scores it
        } else if (this.roomMode === 'pvp') {
          const killer = m.self ? 0 : (from === 1 ? 2 : 1);
          if (killer) this.score[killer - 1]++;
          const sc = { t: 'score', s: this.score.slice(), victim: from, killer };
          this._receive(sc);
          this._broadcast(sc, 0);
        } else {
          const ev = { t: 'pdied', id: from };
          this._receive(ev);
          this._broadcast(ev, 0);
        }
        break;
      }
      case 'zhit': // a guest hit a zombie, bought something or placed a mine: only the host needs it
      case 'zbuy':
      case 'zmine':
      case 'bhit':
        if (from !== 1) this._receive(msg);
        break;
      default:
        if (m.to) {
          if (m.to !== from) this._deliver(m.to, msg);
        } else {
          if (from !== 1) this._receive(msg);
          this._broadcast(msg, from);
        }
    }
  }

  /** Host, team matches: send everyone's newest state to every guest (call every frame). */
  flush(dt) {
    if (this.mode !== 'host' || this.roomMode !== 'tdm' || this.status !== 'connected') return;
    this._flushT -= dt;
    if (this._flushT > 0) return;
    this._flushT = 0.066;
    const rows = [];
    for (const id of Object.keys(this._latest)) {
      const m = this._latest[id];
      rows.push([+id, m.x, m.y, m.z, m.yaw, m.pitch, m.c, m.w, m.d]);
    }
    for (const [gid, conn] of this._guests) {
      const others = rows.filter((r) => r[0] !== gid);
      if (others.length) this._sendTo(conn, { t: 'sa', a: others });
    }
  }

  _deliver(to, msg) {
    if (to === 1) this._receive(msg);
    else this._sendTo(this._guests.get(to), msg);
  }

  _broadcast(msg, except) {
    for (const [id, c] of this._guests) if (id !== except) this._sendTo(c, msg);
  }

  _sendTo(c, msg) {
    if (c && c.open) { try { c.send(msg); } catch (_) { /* ignore */ } }
  }

  // --- WebSocket server (optional, 1v1) -------------------------------------

  connect(url) {
    this.disconnect();
    this.mode = 'ws';
    this.roomMode = 'pvp';
    this._set('connecting');
    let ws;
    try {
      ws = new WebSocket(url);
    } catch (_) {
      this._fail('error');
      return;
    }
    this.ws = ws;
    ws.onmessage = (e) => {
      let m;
      try { m = JSON.parse(e.data); } catch (_) { return; }
      this._receive(m);
    };
    ws.onerror = () => { if (this.status === 'connecting') this._fail('error'); };
    ws.onclose = () => {
      if (this.ws !== ws) return;
      this.ws = null;
      if (this.status === 'connecting') this._fail('error');
      else this._lost();
    };
  }

  // --- Shared --------------------------------------------------------------

  _closeAll() {
    clearTimeout(this._joinTimer);
    const ws = this.ws, conn = this._conn, peer = this._peerObj;
    this.ws = null;
    this._conn = null;
    this._peerObj = null;
    for (const c of this._guests.values()) { try { c.close(); } catch (_) { /* ignore */ } }
    this._guests.clear();
    if (ws) { try { ws.close(); } catch (_) { /* ignore */ } }
    if (conn) { try { conn.close(); } catch (_) { /* ignore */ } }
    if (peer) { try { peer.destroy(); } catch (_) { /* ignore */ } }
    this.players.clear();
    this.teams = {};
    this._latest = {};
    this.id = 0;
    const h = this.handlers.clear;
    if (h) h();
  }

  disconnect() {
    this._closeAll();
    this.mode = null;
    this.code = '';
    if (this.status !== 'offline') this._set('offline');
  }

  send(obj) {
    if (this.status !== 'connected') return;
    if (this.mode === 'host') this._serve(1, obj);
    else if (this.mode === 'guest') this._sendTo(this._conn, obj);
    else if (this.ws && this.ws.readyState === 1) this.ws.send(JSON.stringify(obj));
  }

  /** A message for this player (from the server, the host, or the host's own logic). */
  _receive(m) {
    if (!m || typeof m.t !== 'string') return;
    // The 1v1 WebSocket server does not say who sent what: it is the other player.
    if (m.from === undefined && this.mode === 'ws') m.from = this.id === 1 ? 2 : 1;
    if (m.t === 'welcome') {
      clearTimeout(this._joinTimer);
      this.id = m.id;
      this.roomMode = m.mode === 'coop' ? 'coop' : m.mode === 'tdm' ? 'tdm' : 'pvp';
      this.team = m.team | 0;
      this.teams = m.teams ? Object.assign({}, m.teams) : { [m.id]: this.team };
      this.mapSize = MAP_SIZES.includes(m.map) ? m.map : 'middle';
      this.players = new Set(Array.isArray(m.players) ? m.players.filter((p) => p !== m.id) : (m.peer ? [m.id === 1 ? 2 : 1] : []));
      this.score = m.s || [0, 0];
      this._set('connected');
    } else if (m.t === 'full') {
      const mode = this.mode;
      this._closeAll();
      this.mode = mode;
      this._set('full');
      this.mode = null;
      return;
    } else if (m.t === 'sa') {
      const h = this.handlers.s;
      if (h) for (const a of m.a) h({ t: 's', from: a[0], x: a[1], y: a[2], z: a[3], yaw: a[4], pitch: a[5], c: a[6], w: a[7], d: a[8] });
      return;
    } else if (m.t === 'peer') {
      if (m.id === undefined) m.id = this.id === 1 ? 2 : 1;
      if (m.present) { this.players.add(m.id); if (m.team !== undefined) this.teams[m.id] = m.team; }
      else { this.players.delete(m.id); delete this.teams[m.id]; }
    } else if (m.t === 'score') {
      this.score = m.s;
      if (m.quiet) {
        const h = this.handlers.scoreReset;
        if (h) h(m);
        return;
      }
    }
    const h = this.handlers[m.t];
    if (h) h(m);
  }

  /** The connection dropped after it was established. */
  _lost() {
    const mode = this.mode;
    this._closeAll();
    this.mode = mode;
    this.error = 'lost';
    this._set('error');
    this.mode = null;
  }

  _fail(reason) {
    const mode = this.mode;
    const code = this.code;
    this._closeAll();
    this.error = reason;
    this.mode = mode;
    this.code = code;
    this._set('error');
    this.mode = null;
  }

  _set(s) {
    this.status = s;
    if (this.onStatus) this.onStatus(s);
  }
}

// ===== js/net/RemotePlayer.js =====
const R_HALF = 0.35; // half width of the hit box
const R_STAND = 1.8;
const R_CROUCH = 1.1;
const R_HEAD = 0.26; // height of the head box at the top of the player
const R_HEAD_HALF = 0.14; // half width of the head box (the body box is wider)

/**
 * The other player: a boxy DOOM-style figure with a gun, driven by 20 Hz
 * state messages and smoothed. It is also the shooting target: raycast()
 * tests a ray against the box that is currently displayed.
 */
class RemotePlayer {
  constructor(scene, effects, color) {
    this.effects = effects;
    this.present = false;
    this.dead = false;
    this.crouch = 0; // 0 standing .. 1 crouching (smoothed)
    this._crouchTarget = 0;
    this.head = false; // set by raycast(): was the last hit a headshot?
    this.tx = 0; this.ty = 0; this.tz = 0; this.tyaw = 0; this.tpitch = 0;
    this.x = 0; this.y = 0; this.z = 0; this.yaw = 0; this.pitch = 0;
    this.slot = 1;
    this.flash = 0;

    const body = new THREE.MeshLambertMaterial({ color: color || 0x6b3a2a });
    this.bodyMat = body;
    this.team = undefined; // set in team matches
    const dark = new THREE.MeshLambertMaterial({ color: 0x3a3a40 });
    const skin = new THREE.MeshLambertMaterial({ color: 0xc09070 });
    const metal = new THREE.MeshLambertMaterial({ color: 0x222226 });
    const box = (w, h, d, mat, x, y, z, parent) => {
      const m = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), mat);
      m.position.set(x, y, z);
      parent.add(m);
      return m;
    };
    this.root = new THREE.Group();
    this.root.visible = false;
    this.legs = box(0.46, 0.8, 0.28, dark, 0, 0.4, 0, this.root);
    this.torso = new THREE.Group();
    this.root.add(this.torso);
    box(0.6, 0.62, 0.32, body, 0, 1.11, 0, this.torso);
    box(0.28, 0.28, 0.28, skin, 0, 1.58, 0, this.torso);
    this.pivot = new THREE.Group(); // arms + gun, pitched with the view
    this.pivot.position.set(0, 1.3, 0);
    this.torso.add(this.pivot);
    box(0.12, 0.12, 0.5, skin, 0.22, -0.05, -0.3, this.pivot);
    // The real weapon model of whatever they hold, made on first use.
    this.gunPivot = new THREE.Group();
    this.gunPivot.position.set(0.2, -0.045, -0.15);
    this.pivot.add(this.gunPivot);
    this.gunModels = new Map();
    this._gunShown = 0;
    this.muzzle = new THREE.PointLight(0xffc060, 0, 6);
    this.muzzle.position.set(0.2, 0, -0.85);
    this.pivot.add(this.muzzle);
    scene.add(this.root);
  }

  /** Team colour for the uniform (team matches). */
  setTeam(team) {
    this.team = team;
    if (team === 0 || team === 1) this.bodyMat.color.setHex(TEAM_HEX[team]);
  }

  /** A floating name above the head, drawn through walls (for teammates). */
  setLabel(text, color) {
    if (!this.tag) {
      const canvas = document.createElement('canvas');
      canvas.width = 128;
      canvas.height = 40;
      this._tagCanvas = canvas;
      const tex = new THREE.CanvasTexture(canvas);
      this.tag = new THREE.Sprite(new THREE.SpriteMaterial({ map: tex, transparent: true, depthTest: false }));
      this.tag.scale.set(0.9, 0.28, 1);
      this.tag.position.set(0, 2.15, 0);
      this.tag.renderOrder = 10;
      this.tag.visible = false;
      this.root.add(this.tag);
    }
    if (this._tagText === text + color) return;
    this._tagText = text + color;
    const g = this._tagCanvas.getContext('2d');
    g.clearRect(0, 0, 128, 40);
    g.font = 'bold 26px monospace';
    g.textAlign = 'center';
    g.lineWidth = 5;
    g.strokeStyle = '#000';
    g.strokeText(text, 64, 28);
    g.fillStyle = color;
    g.fillText(text, 64, 28);
    this.tag.material.map.needsUpdate = true;
  }

  get active() {
    return this.present && !this.dead;
  }

  get height() {
    return R_STAND + (R_CROUCH - R_STAND) * this.crouch;
  }

  setPresent(p) {
    this.present = p;
    this.root.visible = p && !this.dead;
  }

  setDead(d) {
    this.dead = d;
    this.root.visible = this.present && !d;
  }

  /** New state from the network: { x, y, z, yaw, pitch, c, w, d }. */
  setState(m) {
    if (!this.present) this.setPresent(true);
    const first = this.tx === 0 && this.ty === 0 && this.tz === 0;
    const jump = Math.hypot(m.x - this.tx, m.z - this.tz) > 5 || m.d !== this.dead; // respawn
    this.tx = m.x; this.ty = m.y; this.tz = m.z; this.tyaw = m.yaw; this.tpitch = m.pitch;
    this._crouchTarget = m.c ? 1 : 0;
    this.slot = m.w || 1;
    if (first || jump) {
      this.x = m.x; this.y = m.y; this.z = m.z; this.yaw = m.yaw;
    }
    if (m.d !== this.dead) this.setDead(!!m.d);
  }

  update(dt) {
    const k = Math.min(1, dt * 14);
    this.x += (this.tx - this.x) * k;
    this.y += (this.ty - this.y) * k;
    this.z += (this.tz - this.z) * k;
    let dy = this.tyaw - this.yaw;
    dy = Math.atan2(Math.sin(dy), Math.cos(dy));
    this.yaw += dy * k;
    this.pitch += (this.tpitch - this.pitch) * k;
    this.crouch += (this._crouchTarget - this.crouch) * Math.min(1, dt * 12);

    this.root.position.set(this.x, this.y, this.z);
    this.root.rotation.y = this.yaw;
    const squash = this.height / R_STAND;
    this.root.scale.y = squash;
    this.pivot.rotation.x = this.pitch;
    this.flash = Math.max(0, this.flash - dt * 20);
    this.muzzle.intensity = this.flash * 2.5;
    this._showGun(this.slot);
    const gm = this.gunModels.get(this._gunShown);
    if (gm) gm.flash.visible = this.flash > 0.45;
  }

  /** Show the model for weapon id `id` (index into WEAPON_SPECS + 1) in their hands. */
  _showGun(id) {
    if (id === this._gunShown) return;
    const spec = WEAPON_SPECS[id - 1];
    if (!spec) return;
    let m = this.gunModels.get(id);
    if (!m) {
      m = spec.createModel();
      m.root.rotation.y = 0;
      m.flash.visible = false;
      this.gunPivot.add(m.root);
      this.gunModels.set(id, m);
    }
    const old = this.gunModels.get(this._gunShown);
    if (old) { old.root.visible = false; old.flash.visible = false; }
    m.root.visible = true;
    this._gunShown = id;
  }

  /** The other player fired: muzzle light. */
  shotFx() {
    this.flash = 1;
  }

  /**
   * Distance along the ray to the box (slab test), or -1 if it misses or is
   * farther than `max`. Sets `this.head` when the hit point is in the top slice.
   */
  raycast(ox, oy, oz, dx, dy, dz, max) {
    const h = this.height;
    const min = [this.x - R_HALF, this.y, this.z - R_HALF];
    const mx = [this.x + R_HALF, this.y + h, this.z + R_HALF];
    const o = [ox, oy, oz], d = [dx, dy, dz];
    let t0 = 0, t1 = max;
    for (let i = 0; i < 3; i++) {
      if (Math.abs(d[i]) < 1e-9) {
        if (o[i] < min[i] || o[i] > mx[i]) return -1;
      } else {
        let a = (min[i] - o[i]) / d[i], b = (mx[i] - o[i]) / d[i];
        if (a > b) { const t = a; a = b; b = t; }
        if (a > t0) t0 = a;
        if (b < t1) t1 = b;
        if (t0 > t1) return -1;
      }
    }
    // Headshot only if the ray also passes through the small head box.
    this.head = rayBoxDist(ox, oy, oz, dx, dy, dz, this.x - R_HEAD_HALF, this.y + h - R_HEAD, this.z - R_HEAD_HALF,
      this.x + R_HEAD_HALF, this.y + h, this.z + R_HEAD_HALF, t1 + 0.5) >= 0;
    return t0;
  }
}

// ===== js/weapon/Weapon.js =====
/** Damage multiplier of a headshot when headshots kill instantly. */
const HEAD_ONE_SHOT = 1000;

/** Distance along a ray to an axis-aligned box (slab test), or -1 if it misses or is farther than max. */
function rayBoxDist(ox, oy, oz, dx, dy, dz, x0, y0, z0, x1, y1, z1, max) {
  const o = [ox, oy, oz], d = [dx, dy, dz], lo = [x0, y0, z0], hi = [x1, y1, z1];
  let t0 = 0, t1 = max;
  for (let i = 0; i < 3; i++) {
    if (Math.abs(d[i]) < 1e-9) {
      if (o[i] < lo[i] || o[i] > hi[i]) return -1;
    } else {
      let a = (lo[i] - o[i]) / d[i], b = (hi[i] - o[i]) / d[i];
      if (a > b) { const t = a; a = b; b = t; }
      if (a > t0) t0 = a;
      if (b < t1) t1 = b;
      if (t0 > t1) return -1;
    }
  }
  return t0;
}

/**
 * Was the shot that produced `hit` a headshot on this soldier / zombie / bot?
 * The head is a small box (0.28 wide) at the top of the body; the shot ray has to pass through it.
 */
function enemyHeadHit(e, hit) {
  if (hit.dx === undefined) return false;
  return rayBoxDist(hit.ox, hit.oy, hit.oz, hit.dx, hit.dy, hit.dz,
    e.x - 0.14, e.y + 1.56, e.z - 0.14, e.x + 0.14, e.y + 1.86, e.z + 0.14, hit.dist + 1) >= 0;
}

const akLerp = (a, b, t) => a + (b - a) * t;
const akClamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));
const akSmooth = (t) => t * t * (3 - 2 * t);

/**
 * One weapon, driven by a spec (see WeaponSpecs.js): fire (auto or semi),
 * recoil, spread, aim down sights, reload with infinite reserve ammo, and the
 * first-person viewmodel. Left and right mouse buttons are read independently,
 * so you can shoot and aim at the same time.
 *
 * Only the active weapon is updated; WeaponManager handles switching.
 */
class Weapon {
  constructor({ spec, engine, input, player, collision, settings, effects, audio, onHit, targets, onShoot, onTargetHit, onEnemyHit, onProjectile }) {
    this.spec = spec;
    this.onProjectile = onProjectile; // (spec, x, y, z, dx, dy, dz) for rockets / launcher grenades
    this.burstLeft = 0;
    this.bursting = false;
    this.spinT = 0;
    this.camera = engine.camera;
    this.input = input;
    this.player = player;
    this.collision = collision;
    this.settings = settings;
    this.effects = effects;
    this.audio = audio;
    this.onHit = onHit;
    this.targets = targets; // remote player (raycast(...) -> distance or -1, .head, .active)
    this.onShoot = onShoot; // (slot, impactPoint | null)
    this.onTargetHit = onTargetHit; // (damage, head)
    this.onEnemyHit = onEnemyHit; // (box, hit, damage, headMul) -> true if an enemy was hit
    this.shotFilter = null; // (box) => false lets bullets pass through that box (allies in team matches)
    this.lastImpact = null;

    this.model = spec.createModel();
    this.model.root.visible = false;
    engine.viewScene.add(this.model.root);
    this.hands = spec.hands ? new ViewHands(this.model.root, spec.hands, engine.viewScene) : null;
    this.reloadEnv = 0;

    this.name = spec.name;
    this.magSize = spec.magSize;
    this.ammo = spec.magSize;

    this.reloading = false;
    this.reloadTime = 0;
    this.reloadDuration = 0;
    this.reloadEmpty = false;

    this.cooldown = 0;
    this.fireBuffer = 0; // semi-auto: a click made slightly early still fires
    this.heat = 0; // 0..1, grows with sustained fire
    this.sinceShot = 10;
    this.shotIndex = 0;
    this.recoilDebt = 0; // camera pitch to hand back after firing stops

    this.raise = 1; // 0 = lowered, 1 = ready (set by the manager when switching)
    this.throwTimer = 0;
    this.throwDuration = 0;

    this.aim = 0;
    this.aimEase = 0;
    this.scopeEase = 0; // scope overlay amount (scoped weapons only)
    this.shellClock = 0;
    this.slot = 0;
    this.sprintBlend = 0;
    this.spread = 0;
    this.crosshairNdc = 0;

    this.kickZ = 0;
    this.kickRot = 0;
    this.swayX = 0;
    this.swayY = 0;
    this.bobPhase = 0;
    this.bobAmount = 0;
    this.time = 0;
    this.flashTime = 0;

    this._hit = { dist: 0, x: 0, y: 0, z: 0, nx: 0, ny: 0, nz: 0 };
    this._reload = { x: 0, y: 0, z: 0, rx: 0, ry: 0, rz: 0, magY: 0, magVisible: true, charge: 0 };
    this._idleReload = { magY: 0, magVisible: true, charge: 0 };
  }

  get ready() {
    return this.raise > 0.9 && this.throwTimer <= 0 && this.player.enabled;
  }

  cancelReload() {
    this.reloading = false;
    this.bursting = false;
    this.burstLeft = 0;
  }

  /** Lower the weapon briefly while a grenade is thrown. */
  startThrow(duration) {
    this.throwDuration = duration;
    this.throwTimer = duration;
    this.cancelReload();
  }

  update(dt) {
    const spec = this.spec;
    const input = this.input;
    const p = this.player;
    this.time += dt;
    this.sinceShot += dt;
    this.heat = Math.max(0, this.heat - 1.8 * dt);
    if (this.throwTimer > 0) this.throwTimer = Math.max(0, this.throwTimer - dt);

    if (input.consumeReload() && this.ready && !this.reloading && this.ammo < this.magSize) this._startReload();

    const ready = this.ready;
    const wantsFire = input.fireHeld && ready;
    const wantsAim = input.aimHeld && !this.reloading && ready;
    // Aiming or shooting ends a sprint; reloading does not.
    p.canSprint = !(wantsAim || (wantsFire && !this.reloading));

    // Raise / lower the sights.
    const step = dt / spec.aimTime;
    this.aim = wantsAim ? Math.min(1, this.aim + step) : Math.max(0, this.aim - step);
    const aimE = akSmooth(this.aim);
    this.aimEase = aimE;
    this.scopeEase = spec.scope ? aimE : 0;

    // Reload progress.
    if (this.reloading) {
      this.reloadTime += dt;
      if (spec.shellTime) {
        // Shells go in one at a time.
        this.shellClock += dt * (this.player.reloadMul || 1);
        while (this.shellClock >= spec.shellTime && this.ammo < this.magSize) {
          this.shellClock -= spec.shellTime;
          this.ammo++;
          this.audio.shell();
        }
        if (this.ammo >= this.magSize) this.reloading = false;
      } else if (this.reloadTime >= this.reloadDuration) {
        this.reloading = false;
        this.ammo = this.magSize; // infinite reserve
      }
    }

    // Trigger. Semi-auto needs a fresh pull (a click up to 0.15 s early is kept).
    const pulled = input.consumeFirePress();
    if (!spec.auto) {
      if (pulled && ready) this.fireBuffer = 0.15;
      this.fireBuffer = Math.max(0, this.fireBuffer - dt);
    }
    let trigger = spec.auto ? wantsFire : this.fireBuffer > 0;
    // Rotary guns need to spin up before the first round leaves.
    if (spec.spinUp) {
      const spinning = wantsFire && !this.reloading;
      this.spinT = spinning ? Math.min(1, this.spinT + dt / spec.spinUp) : Math.max(0, this.spinT - dt / (spec.spinUp * 1.5));
      if (this.model.setSpin) this.model.setSpin(this.spinT, dt);
      if (this.spinT < 1) trigger = false;
    }
    if (this.bursting && ready) trigger = true; // a started burst runs to its end
    // A shell-by-shell reload can be interrupted by shooting.
    if (spec.shellTime && this.reloading && this.ammo > 0 && trigger) this.reloading = false;

    // The cooldown carries its remainder so the rate stays exact at any frame rate.
    this.cooldown -= dt;
    let shots = 0;
    while (trigger && !this.reloading && this.ammo > 0 && this.cooldown <= 0 && shots < 3) {
      this._shoot(aimE);
      if (spec.burst) {
        if (!this.bursting) { this.bursting = true; this.burstLeft = spec.burst - 1; this.cooldown += spec.burstGap; }
        else {
          this.burstLeft--;
          this.cooldown += this.burstLeft > 0 ? spec.burstGap : spec.interval;
          if (this.burstLeft <= 0) this.bursting = false;
        }
      } else this.cooldown += spec.interval;
      shots++;
      if (!spec.auto) {
        this.fireBuffer = 0;
        break;
      }
    }
    if (this.cooldown < 0) this.cooldown = 0;
    if (this.ammo === 0 && !this.reloading && ready) this._startReload();

    // Hand back the climb once firing has stopped.
    if (this.sinceShot > 0.12 && this.recoilDebt > 0) {
      const back = this.recoilDebt * (1 - Math.exp(-5 * dt));
      this.recoilDebt -= back;
      p.kick(-back, 0);
    }

    // Aim zoom, matching look speed, and slower movement while aiming.
    const baseFov = this.settings.get('fov');
    const fov = (baseFov + p.fovBoost * (1 - aimE)) * (1 - spec.zoom * aimE);
    if (Math.abs(this.camera.fov - fov) > 0.01) {
      this.camera.fov = fov;
      this.camera.updateProjectionMatrix();
    }
    p.lookScale = 1 - spec.zoom * aimE;
    p.aimEase = aimE;
    p.speedScale = (1 - 0.3 * aimE) * (spec.moveMul || 1);

    // Spread (radians): worse when moving, airborne or after sustained fire; better crouched.
    const speed = Math.hypot(p.vx, p.vz) / p.sprintSpeed;
    const air = p.onGround ? 0 : 1;
    const stance = p.crouching ? 0.75 : 1;
    const h = spec.spreadHip;
    const a = spec.spreadAds;
    const hip = (h[0] + h[1] * speed + h[2] * air + h[3] * this.heat) * stance;
    const ads = (a[0] + a[1] * speed + a[2] * air + a[3] * this.heat) * stance;
    this.spread = hip + (ads - hip) * aimE;
    this.crosshairNdc = Math.tan(this.spread) / Math.tan((fov * Math.PI) / 360);

    this._updateViewmodel(dt, aimE, wantsFire, wantsAim);
  }

  // --- Firing --------------------------------------------------------------

  _shoot(aimE) {
    const spec = this.spec;
    const p = this.player;
    const cam = this.camera;
    this.ammo--;
    this.shotIndex++;

    // Camera basis from yaw / pitch (matches the camera's YXZ rotation).
    const sy = Math.sin(p.yaw), cy = Math.cos(p.yaw);
    const sp = Math.sin(p.pitch), cp = Math.cos(p.pitch);
    const fx = -sy * cp, fy = sp, fz = -cy * cp;
    const rx = cy, rz = -sy; // right vector (y = 0)
    const ux = -rz * fy, uy = rz * fx - rx * fz, uz = rx * fy; // up = right x forward

    // One ray per pellet, each in its own random point of the spread cone.
    const pellets = spec.projectile ? 0 : (spec.pellets || 1);
    const cone = this.spread + (spec.pelletSpread || 0) * (1 - 0.4 * aimE);
    const hit = this._hit;
    const targets = this.targets;
    // Headshots kill instantly (a setting; otherwise the weapon's own multiplier).
    const headMul = this.settings.get('oneShotHead') ? HEAD_ONE_SHOT : (spec.headMul || 1.8);
    let dealt = 0;
    let headHit = false;
    this.lastImpact = null;
    for (let n = 0; n < pellets; n++) {
      const angle = Math.random() * Math.PI * 2;
      const radius = cone * Math.sqrt(Math.random());
      const ox = Math.cos(angle) * radius;
      const oy = Math.sin(angle) * radius;
      let dx = fx + rx * ox + ux * oy;
      let dy = fy + uy * oy;
      let dz = fz + rz * ox + uz * oy;
      const len = Math.hypot(dx, dy, dz);
      dx /= len; dy /= len; dz /= len;
      const worldHit = this.collision.raycast(cam.position.x, cam.position.y, cam.position.z, dx, dy, dz, spec.range, hit, this.shotFilter);
      if (targets && targets.active) {
        // The other player counts if they are closer than the wall behind them.
        const dp = targets.raycast(cam.position.x, cam.position.y, cam.position.z, dx, dy, dz, worldHit ? hit.dist : spec.range);
        if (dp >= 0) {
          dealt += this._damageAt(dp) * (targets.head ? headMul : 1);
          if (targets.head) headHit = true;
          continue;
        }
      }
      if (worldHit) {
        // Enemy soldiers are boxes in the collision world.
        if (hit.box && hit.box.enemy && this.onEnemyHit) {
          hit.ox = cam.position.x; hit.oy = cam.position.y; hit.oz = cam.position.z;
          hit.dx = dx; hit.dy = dy; hit.dz = dz;
          if (this.onEnemyHit(hit.box, hit, this._damageAt(hit.dist), headMul)) continue;
        }
        this.effects.spawn(hit.x, hit.y, hit.z, hit.nx, hit.ny, hit.nz);
        if (!this.lastImpact) this.lastImpact = [hit.x, hit.y, hit.z, hit.nx, hit.ny, hit.nz];
        if (this.onHit) this.onHit(hit.box, spec.barrelChance || 0);
      }
    }
    if (spec.projectile && this.onProjectile) {
      const angle = Math.random() * Math.PI * 2;
      const radius = this.spread * Math.sqrt(Math.random()) * 0.5;
      const ox = Math.cos(angle) * radius, oy = Math.sin(angle) * radius;
      let dx = fx + rx * ox + ux * oy, dy = fy + uy * oy, dz = fz + rz * ox + uz * oy;
      const len = Math.hypot(dx, dy, dz);
      this.onProjectile(spec, cam.position.x, cam.position.y, cam.position.z, dx / len, dy / len, dz / len);
    }
    if (dealt > 0 && this.onTargetHit) this.onTargetHit(Math.round(dealt), headHit);

    // Recoil: climbs with sustained fire, random sideways wobble, calmer when aimed or crouched.
    const rc = spec.recoil;
    const calm = (1 - 0.3 * aimE) * (p.crouching ? 0.85 : 1);
    const kickPitch = (rc.pitch + rc.pitchHeat * this.heat) * calm;
    const kickYaw = ((Math.random() - 0.5) * rc.yaw + rc.wave * Math.sin(this.shotIndex * 0.8)) * calm;
    p.kick(kickPitch, kickYaw);
    this.recoilDebt = Math.min(0.35, this.recoilDebt + kickPitch);
    this.heat = Math.min(1, this.heat + rc.heatPerShot);
    this.sinceShot = 0;

    // Viewmodel kick and muzzle flash.
    this.kickZ += spec.kick.z * (1 - 0.45 * aimE);
    this.kickRot += spec.kick.rot * (1 - 0.4 * aimE);
    const flash = this.model.flash;
    flash.visible = true;
    flash.rotation.z = Math.random() * Math.PI * 2;
    flash.scale.setScalar((0.8 + Math.random() * 0.5) * (1 - 0.5 * aimE) * spec.flashScale);
    this.flashTime = spec.flashTime;
    if (this.model.onShot) this.model.onShot();

    this.audio.shot(spec.sound);
    if (this.onShoot) this.onShoot(this.slot, this.lastImpact);
  }

  /** Damage of one bullet that travelled `dist` metres. */
  _damageAt(dist) {
    const spec = this.spec;
    const f = spec.falloff;
    let mul = 1;
    if (f && dist > f.start) mul = Math.max(f.min, 1 - ((1 - f.min) * (dist - f.start)) / (f.end - f.start));
    return (spec.damage || 0) * mul * (this.player.damageMul || 1);
  }

  _startReload() {
    const spec = this.spec;
    this.reloading = true;
    this.reloadTime = 0;
    this.bursting = false;
    this.reloadEmpty = this.ammo === 0;
    this.reloadDuration = (this.reloadEmpty ? spec.reloadEmpty : spec.reloadTactical) / (this.player.reloadMul || 1);
    this.shellClock = -0.2;
    if (!spec.shellTime) this.audio.reload(this.reloadDuration, this.reloadEmpty, spec.sound);
  }

  // --- Viewmodel -----------------------------------------------------------

  _updateViewmodel(dt, aimE, wantsFire, wantsAim) {
    const spec = this.spec;
    const p = this.player;
    const m = this.model;
    const locked = this.input.locked;

    if (this.flashTime > 0) {
      this.flashTime -= dt;
      if (this.flashTime <= 0) m.flash.visible = false;
    }

    // Kick decays quickly.
    const decay = Math.exp(-16 * dt);
    this.kickZ *= decay;
    this.kickRot *= decay;

    // Sway: the weapon lags behind mouse movement.
    const dtc = Math.max(dt, 1 / 240);
    const lookX = locked ? p.lookDx : 0;
    const lookY = locked ? p.lookDy : 0;
    const swayScale = 1 - 0.7 * aimE;
    const targetX = akClamp(-(lookX / dtc) * 0.000012, -0.02, 0.02) * swayScale;
    const targetY = akClamp((lookY / dtc) * 0.000012, -0.02, 0.02) * swayScale;
    const follow = Math.min(1, dt * 10);
    this.swayX += (targetX - this.swayX) * follow;
    this.swayY += (targetY - this.swayY) * follow;

    // Walk bob scales with speed and is nearly gone when aiming.
    const speed = p.onGround ? Math.hypot(p.vx, p.vz) / p.sprintSpeed : 0;
    this.bobAmount += (speed - this.bobAmount) * Math.min(1, dt * 8);
    this.bobPhase += dt * (5 + 7 * this.bobAmount);
    const bobDamp = (1 - 0.85 * aimE) * this.settings.get('viewBob');
    const bobX = Math.sin(this.bobPhase) * 0.008 * this.bobAmount * bobDamp;
    const bobY = Math.sin(this.bobPhase * 2) * 0.005 * this.bobAmount * bobDamp;
    const breathe = Math.sin(this.time * 1.6) * 0.0012;
    const air = akClamp(-p.vy * 0.001, -0.015, 0.015);

    // Base pose: hip -> aim, then towards the sprint pose.
    let x = akLerp(spec.hip.x, spec.aimPose.x, aimE);
    let y = akLerp(spec.hip.y, spec.aimPose.y, aimE);
    let z = akLerp(spec.hip.z, spec.aimPose.z, aimE);
    let rx = 0;
    let ry = akLerp(spec.hip.ry, spec.aimPose.ry, aimE);
    let rz = 0;

    const sprintTarget = p.sprinting && !wantsFire && !wantsAim ? 1 : 0;
    this.sprintBlend += (sprintTarget - this.sprintBlend) * Math.min(1, dt * 8);
    const sb = this.sprintBlend;
    if (sb > 0.001) {
      const s = spec.sprintPose;
      x = akLerp(x, s.x, sb);
      y = akLerp(y, s.y, sb);
      z = akLerp(z, s.z, sb);
      rx = akLerp(rx, s.rx, sb);
      ry = akLerp(ry, s.ry, sb);
      rz = akLerp(rz, s.rz, sb);
    }

    // Reload animation.
    let anim = this._idleReload;
    let phase = 0;
    const view = spec.hands && spec.hands.view; // where the weapon is held while reloading
    if (this.reloading) {
      const r = this._reload;
      phase = spec.shellTime ? Math.max(0, this.shellClock) / spec.shellTime : this.reloadTime / this.reloadDuration;
      spec.reloadPose(phase, this.reloadEmpty, r);
      if (!view) {
        x += r.x; y += r.y; z += r.z;
        rx += r.rx; ry += r.ry; rz += r.rz;
      }
      anim = r;
    }
    // The whole weapon dips towards the middle and rolls, so the reload is easy to see.
    this.reloadEnv += ((this.reloading ? 1 : 0) - this.reloadEnv) * Math.min(1, dt * 7);
    const env = this.reloadEnv;
    if (env > 0.001) {
      if (view) {
        // Hold the weapon out in front, rolled to the side: the magazine, the hand and the new magazine are all on screen.
        x = akLerp(x, view.x, env);
        y = akLerp(y, view.y, env);
        z = akLerp(z, view.z, env);
        rx = akLerp(rx, view.rx, env) + (view.addRx && this.reloading ? this._reload.rx : 0);
        ry = akLerp(ry, view.ry, env);
        rz = akLerp(rz, view.rz, env);
      } else {
        x -= 0.05 * env;
        y -= 0.07 * env;
        z += 0.02 * env;
        rx += 0.18 * env;
        rz += 0.22 * env;
      }
    }
    m.applyReload(anim);
    if (m.update) m.update(dt);
    if (this.hands) this.hands.update(dt, this.reloading, phase, this.reloadEmpty, anim);

    // Switching (lowered) and grenade throw (dip and tip down).
    const lowered = 1 - akSmooth(this.raise);
    y -= 0.3 * lowered;
    rx -= 0.7 * lowered;
    if (this.throwTimer > 0) {
      const env = Math.sin(Math.PI * (1 - this.throwTimer / this.throwDuration));
      y -= 0.2 * env;
      rx -= 0.5 * env;
    }

    m.root.position.set(
      x + bobX + this.swayX,
      y + bobY + this.swayY + breathe + air,
      z + this.kickZ
    );
    m.root.rotation.set(rx + this.kickRot, ry + this.swayX * 1.5, rz);
    m.root.visible = !(spec.scope && aimE > 0.85); // looking through the scope
  }
}

// ===== js/weapon/WeaponManager.js =====
const LOWER_TIME = 0.18; // seconds to put the current weapon away
const RAISE_TIME = 0.25; // seconds to bring up the next one

/**
 * Owns the weapons plus the effects and audio they share.
 * `all` holds every weapon (index = id - 1); `weapons` is the current loadout:
 * keys 1-3 pick primary, secondary or sidearm, the mouse wheel cycles, Q returns to the previous one.
 */
class WeaponManager {
  constructor({ engine, input, player, collision, settings, onHit, targets, onShoot, onTargetHit, onEnemyHit, onProjectile }) {
    this.input = input;
    this.effects = new ImpactEffects(engine.scene);
    this.audio = new WeaponAudio();

    const deps = { engine, input, player, collision, settings, effects: this.effects, audio: this.audio, onHit, targets, onShoot, onTargetHit, onEnemyHit, onProjectile };
    this.all = WEAPON_SPECS.map((spec, i) => {
      const weapon = new Weapon({ ...deps, spec });
      weapon.slot = i + 1; // weapon id, also sent over the network
      weapon.loadoutSlot = 0;
      return weapon;
    });
    this.loadout = DEFAULT_LOADOUT.slice();
    this.weapons = [];
    this.previous = 1;
    this.index = 0;
    this.target = 0;
    this.state = 'idle'; // 'idle' | 'lowering' | 'raising'
    this.setLoadout(this.loadout);
  }

  /** Choose the three weapons (ids). Switches to the first one. */
  setLoadout(ids) {
    const valid = [];
    for (let k = 0; k < 3; k++) {
      const id = ids && ids[k];
      valid.push(this.all[id - 1] ? id : DEFAULT_LOADOUT[k]);
    }
    if (valid[0] === valid[1]) valid[1] = DEFAULT_LOADOUT[1] === valid[0] ? DEFAULT_LOADOUT[0] : DEFAULT_LOADOUT[1];
    const current = this.weapons[this.index];
    for (const w of this.all) { w.model.root.visible = false; w.loadoutSlot = 0; w.cancelReload(); }
    this.loadout = valid;
    this.weapons = valid.map((id) => this.all[id - 1]);
    this.weapons.forEach((w, k) => { w.loadoutSlot = k + 1; });
    // Keep the weapon in hand if it is still in the loadout.
    const keep = current ? this.weapons.indexOf(current) : -1;
    this.index = keep >= 0 ? keep : 0;
    this.target = this.index;
    this.previous = this.index === 0 ? 1 : 0;
    this.state = 'idle';
    this.active.raise = 1;
    this.active.model.root.visible = true;
  }

  /** Bullets ignore the boxes this returns false for (or null: everything counts). */
  setShotFilter(fn) {
    for (const w of this.all) w.shotFilter = fn;
  }

  /** Full ammo for every weapon (on respawn). */
  refill() {
    for (const w of this.all) {
      w.ammo = w.magSize;
      w.reloading = false;
      w.heat = 0;
      w.recoilDebt = 0;
    }
  }

  get active() {
    return this.weapons[this.index];
  }

  /** Grenades may be thrown when the weapon is ready and not mid-throw. */
  canThrow() {
    return this.state === 'idle' && this.active.ready;
  }

  startThrow(duration) {
    this.active.startThrow(duration);
  }

  update(dt) {
    const slot = this.input.consumeSlot();
    const wheel = this.input.consumeWheel();
    if ((slot || wheel) && this.state === 'idle' && this.active.throwTimer <= 0) {
      const n = this.weapons.length;
      let next = this.index;
      if (slot === -1) next = this.previous;
      else if (slot) next = slot - 1;
      else next = (this.index + wheel + n) % n;
      if (next !== this.index && next >= 0 && next < n) {
        this.previous = this.index;
        this.target = next;
        this.state = 'lowering';
        this.active.cancelReload();
      }
    }

    if (this.state === 'lowering') {
      const w = this.active;
      w.raise = Math.max(0, w.raise - dt / LOWER_TIME);
      if (w.raise <= 0) {
        w.model.root.visible = false;
        this.index = this.target;
        const next = this.active;
        next.raise = 0;
        next.model.root.visible = true;
        this.state = 'raising';
      }
    } else if (this.state === 'raising') {
      const w = this.active;
      w.raise = Math.min(1, w.raise + dt / RAISE_TIME);
      if (w.raise >= 1) this.state = 'idle';
    }

    this.active.update(dt);
    this.effects.update(dt);
  }
}

// ===== js/weapon/Explosions.js =====
const EX_FIRE_TIME = 0.45;
const EX_CORE_TIME = 0.18;
const EX_SMOKE_TIME = 1.6;
const EX_LIGHT_TIME = 0.25;
const EX_BASE_RADIUS = 7; // knockback radius at scale 1, metres

/**
 * Shared explosion: fireball, smoke, light flash, scorch mark, camera shake,
 * sound and knockback on the player. Used by grenades and barrels.
 * Listeners in `onExplode` get (x, y, z, radius) for chain reactions / damage.
 */
class Explosions {
  constructor({ scene, player, collision, effects, audio, settings }) {
    this.settings = settings;
    this.player = player;
    this.collision = collision;
    this.effects = effects;
    this.audio = audio;
    this.onExplode = [];
    /** Optional (damage, owner) callback for the player's share of a blast. owner: 'me' or 'other'. */
    this.onPlayerBlast = null;
    this._shake = 0;
    this._hit = { dist: 0, x: 0, y: 0, z: 0, nx: 0, ny: 0, nz: 0, box: null };

    const sphere = new THREE.SphereGeometry(1, 8, 6);
    const additive = (color) => new THREE.MeshBasicMaterial({
      color, transparent: true, blending: THREE.AdditiveBlending, depthWrite: false, fog: false,
    });
    this.blasts = [];
    for (let i = 0; i < 4; i++) {
      const fire = new THREE.Mesh(sphere, additive(0xff8a30));
      const core = new THREE.Mesh(sphere, additive(0xfff0c0));
      const smoke = new THREE.Mesh(sphere, new THREE.MeshBasicMaterial({ color: 0x2a2a2a, transparent: true, depthWrite: false }));
      for (const m of [fire, core, smoke]) { m.visible = false; scene.add(m); }
      this.blasts.push({ fire, core, smoke, t: -1, x: 0, y: 0, z: 0, s: 1 });
    }
    this._next = 0;

    // One permanent light (the light count never changes), flashed on explosions.
    this.light = new THREE.PointLight(0xffa050, 0, 18, 2);
    scene.add(this.light);
    this._lightT = 0;
  }

  /** (x,y,z): fireball centre. (hx,hy,hz)+normal: surface point (zero normal = mid-air). scale: size/power. */
  explode(x, y, z, hx, hy, hz, nx, ny, nz, scale, owner) {
    const b = this.blasts[this._next];
    this._next = (this._next + 1) % this.blasts.length;
    b.t = 0; b.x = x; b.y = y; b.z = z; b.s = scale;
    b.fire.visible = b.core.visible = b.smoke.visible = true;

    if (nx !== 0 || ny !== 0 || nz !== 0) this.effects.spawnScorch(hx, hy, hz, nx, ny, nz);
    this.light.position.set(x, y, z);
    this._lightT = EX_LIGHT_TIME;

    const p = this.player;
    const radius = EX_BASE_RADIUS * scale;
    const dx = p.x - x, dy = p.y + p.height * 0.5 - y, dz = p.z - z;
    const d = Math.hypot(dx, dy, dz);
    this._shake = Math.max(this._shake, 0.15 + 0.85 * Math.max(0, 1 - d / 20));

    if (d < radius) {
      let k = 1 - d / radius;
      if (d > 0.01 && this.collision.raycast(x, y, z, dx / d, dy / d, dz / d, d, this._hit)) k *= 0.35;
      const strength = 16 * k * k;
      if (this.onPlayerBlast) this.onPlayerBlast(110 * k * scale, owner);
      const inv = d > 0.01 ? 1 / d : 0;
      p.vx += dx * inv * strength;
      p.vz += dz * inv * strength;
      p.vy += (d > 0.01 ? dy * inv : 1) * strength + 3 * k;
      if (p.vy > 0) p.onGround = false;
    }

    this.audio.explosion(Math.max(0.25, 1 / (1 + d * 0.08)));
    for (let i = 0; i < this.onExplode.length; i++) this.onExplode[i](x, y, z, radius, owner);
  }

  update(dt) {
    for (const b of this.blasts) {
      if (b.t < 0) continue;
      b.t += dt;
      const f = b.t / EX_FIRE_TIME;
      if (f < 1) {
        b.fire.position.set(b.x, b.y, b.z);
        b.fire.scale.setScalar((0.4 + 2.2 * (1 - (1 - f) * (1 - f))) * b.s);
        b.fire.material.opacity = 1 - f;
      } else b.fire.visible = false;

      const c = b.t / EX_CORE_TIME;
      if (c < 1) {
        b.core.position.set(b.x, b.y, b.z);
        b.core.scale.setScalar((0.3 + 0.9 * c) * b.s);
        b.core.material.opacity = 1 - c;
      } else b.core.visible = false;

      const s = b.t / EX_SMOKE_TIME;
      if (s < 1) {
        b.smoke.position.set(b.x, b.y + 0.5 * b.t, b.z);
        b.smoke.scale.setScalar((0.8 + 1.8 * s) * b.s);
        b.smoke.material.opacity = 0.55 * (1 - s);
      } else {
        b.smoke.visible = false;
        b.t = -1;
      }
    }

    if (this._lightT > 0) {
      this._lightT -= dt;
      const k = Math.max(0, this._lightT / EX_LIGHT_TIME);
      this.light.intensity = 150 * k * k;
    } else this.light.intensity = 0;

    this._shake *= Math.exp(-4 * dt);
    this.player.roll = this._shake > 0.002 ? (Math.random() - 0.5) * 0.08 * this._shake * (this.settings ? this.settings.get('screenShake') : 1) : 0;
  }
}

// ===== js/weapon/Barrels.js =====
const BAR_CHAIN_RADIUS = 4.5; // other barrels this close to an explosion go off too
const BAR_RESPAWN = 45; // seconds

/**
 * Explosive barrels. A bullet hit makes a barrel explode with a chance set by
 * the weapon (spec.barrelChance); any explosion nearby sets it off for sure,
 * so barrels chain. Destroyed barrels come back after a while.
 */
class Barrels {
  constructor({ world, explosions }) {
    this.world = world;
    this.explosions = explosions;
    this.fuses = []; // barrels about to blow: { barrel, t }
    /** Called with the barrel index when a bullet of mine sets one off (for the network). */
    this.onIgnite = null;
    explosions.onExplode.push((x, y, z, radius, owner) => this._chain(x, y, z, owner));
  }

  /** Called for every bullet hit. `box` is the collision box that was hit. */
  hit(box, chance) {
    const barrel = box && box.barrel;
    if (barrel && barrel.alive && !barrel.fused && Math.random() < chance) {
      this._light(barrel, 0.05, 'me');
      if (this.onIgnite) this.onIgnite(this.world.barrels.indexOf(barrel));
    }
  }

  /** The other player shot barrel number `index`. */
  remoteIgnite(index) {
    const b = this.world.barrels[index];
    if (b && b.alive) this._light(b, 0.05, 'other');
  }

  _chain(x, y, z, owner) {
    for (const b of this.world.barrels) {
      if (!b.alive || b.fused) continue;
      const d = Math.hypot(b.x - x, b.y + 0.55 - y, b.z - z);
      if (d < BAR_CHAIN_RADIUS) this._light(b, 0.12 + d * 0.06, owner);
    }
  }

  _light(barrel, delay, owner) {
    if (barrel.fused) return;
    barrel.fused = true;
    barrel.owner = owner || 'me';
    this.fuses.push({ barrel, t: delay });
  }

  update(dt, player) {
    for (let i = this.fuses.length - 1; i >= 0; i--) {
      const f = this.fuses[i];
      f.t -= dt;
      if (f.t > 0) continue;
      this.fuses.splice(i, 1);
      const b = f.barrel;
      b.alive = false;
      b.fused = false;
      b.respawn = BAR_RESPAWN;
      b.mesh.visible = false;
      this.world.collision.removeBox(b.box);
      this.explosions.explode(b.x, b.y + 0.55, b.z, b.x, b.y, b.z, 0, 1, 0, 1.3, b.owner);
    }
    for (const b of this.world.barrels) {
      if (b.alive) continue;
      b.respawn -= dt;
      if (b.respawn > 0) continue;
      // Wait until the player is not standing where the barrel would appear.
      if (Math.hypot(player.x - b.x, player.z - b.z) < 1.2) { b.respawn = 1; continue; }
      b.alive = true;
      b.mesh.visible = true;
      this.world.collision.boxes.push(b.box);
    }
  }
}

// ===== js/weapon/Grenades.js =====
const GR_COOLDOWN = 5; // seconds between throws
const GR_THROW_ANIM = 0.5; // viewmodel throw animation
const GR_RELEASE = 0.18; // seconds into the animation when the grenade leaves the hand
const GR_SPEED = 17; // m/s
const GR_GRAVITY = 18;
const GR_RADIUS = 0.06;
const GR_MAX_FLIGHT = 2.6; // seconds of fuse: it bounces around, then goes off
const GR_BOUNCE = 0.5; // how much speed a bounce keeps
const GR_FRICTION = 0.7; // sideways speed kept on a bounce

/**
 * Grenades: E throws one that bounces off walls and floors and explodes when
 * the fuse runs out (or at once when it hits an enemy), 5 s cooldown.
 * There are two grenade slots: mine and the other player's. A throw is sent
 * to the other player (onThrow), whose game flies an identical grenade
 * through the same static level, so both see it explode in the same place.
 */
class GrenadeSystem {
  constructor({ engine, input, player, collision, weapons, explosions }) {
    this.scene = engine.scene;
    this.camera = engine.camera;
    this.input = input;
    this.player = player;
    this.collision = collision;
    this.weapons = weapons;
    this.audio = weapons.audio;
    this.explosions = explosions;

    /** Seconds until the next grenade is available (0 = ready). */
    this.cooldown = 0;
    /** Optional (x, y, z, vx, vy, vz) callback when I throw. */
    this.onThrow = null;

    this._pending = 0; // seconds until release, 0 = idle
    this._hit = { dist: 0, x: 0, y: 0, z: 0, nx: 0, ny: 0, nz: 0, box: null };

    const bodyGeometry = new THREE.SphereGeometry(GR_RADIUS, 8, 6);
    const capGeometry = new THREE.BoxGeometry(0.03, 0.03, 0.03);
    const bodyMaterial = new THREE.MeshLambertMaterial({ color: 0x4b5a3a });
    const capMaterial = new THREE.MeshLambertMaterial({ color: 0x6a6a6a });
    this.list = ['me', 'other', 'other', 'other', 'other', 'other', 'other', 'other', 'other'].map((owner) => {
      const mesh = new THREE.Group();
      const cap = new THREE.Mesh(capGeometry, capMaterial);
      cap.position.y = GR_RADIUS;
      mesh.add(new THREE.Mesh(bodyGeometry, bodyMaterial), cap);
      mesh.visible = false;
      this.scene.add(mesh);
      return { owner, ownerId: 0, mesh, active: false, x: 0, y: 0, z: 0, vx: 0, vy: 0, vz: 0, life: 0 };
    });
  }

  update(dt) {
    this.cooldown = Math.max(0, this.cooldown - dt);

    if (this.input.consumeGrenade() && this.player.enabled && this.cooldown <= 0 && this._pending === 0 && this.weapons.canThrow()) {
      this.cooldown = GR_COOLDOWN;
      this._pending = GR_RELEASE;
      this.weapons.startThrow(GR_THROW_ANIM);
    }
    if (this._pending > 0) {
      this._pending -= dt;
      if (this._pending <= 0) {
        this._pending = 0;
        this._release();
      }
    }
    for (const g of this.list) this._fly(g, dt);
  }

  /** The other player threw a grenade. */
  spawnRemote(m) {
    // First free slot of the other players' grenades; the oldest one if all are in flight.
    let slot = null;
    for (let i = 1; i < this.list.length; i++) {
      const g = this.list[i];
      if (!g.active) { slot = g; break; }
      if (!slot || g.life < slot.life) slot = g;
    }
    slot.ownerId = m.from || 0;
    this._launch(slot, m.x, m.y, m.z, m.vx, m.vy, m.vz);
    this.audio.whoosh();
  }

  _release() {
    const p = this.player;
    const cam = this.camera;
    const sy = Math.sin(p.yaw), cy = Math.cos(p.yaw);
    const sp = Math.sin(p.pitch), cp = Math.cos(p.pitch);
    const fx = -sy * cp, fy = sp, fz = -cy * cp;

    // A slight upward lob on top of the aim direction.
    let vx = fx, vy = fy + 0.18, vz = fz;
    const len = Math.hypot(vx, vy, vz);
    vx = (vx / len) * GR_SPEED + p.vx * 0.6;
    vy = (vy / len) * GR_SPEED + p.vy * 0.3;
    vz = (vz / len) * GR_SPEED + p.vz * 0.6;

    const x = cam.position.x + fx * 0.35;
    const y = cam.position.y + fy * 0.35 - 0.1;
    const z = cam.position.z + fz * 0.35;
    this._launch(this.list[0], x, y, z, vx, vy, vz);
    this.audio.whoosh();
    if (this.onThrow) this.onThrow(x, y, z, vx, vy, vz);
  }

  _launch(g, x, y, z, vx, vy, vz) {
    g.active = true;
    g.x = x; g.y = y; g.z = z;
    g.vx = vx; g.vy = vy; g.vz = vz;
    g.life = GR_MAX_FLIGHT;
    g.resting = false;
    g.spin = 1;
    g.mesh.position.set(x, y, z);
    g.mesh.visible = true;
  }

  _fly(g, dt) {
    if (!g.active) return;
    g.life -= dt;
    if (g.life <= 0) {
      // Fuse over. A grenade lying on the floor leaves a scorch mark.
      if (g.resting) this._explode(g, g.x, g.y + 0.15, g.z, g.x, g.y - GR_RADIUS, g.z, 0, 1, 0);
      else this._explode(g, g.x, g.y, g.z, 0, 0, 0, 0, 0, 0);
      return;
    }
    if (g.resting) return;
    g.vy -= GR_GRAVITY * dt;

    const sx = g.vx * dt, sy = g.vy * dt, sz = g.vz * dt;
    const len = Math.hypot(sx, sy, sz);
    if (len > 1e-6) {
      const hit = this._hit;
      if (this.collision.raycast(g.x, g.y, g.z, sx / len, sy / len, sz / len, len + GR_RADIUS, hit)) {
        if (hit.box && hit.box.enemy) {
          // Straight into a soldier or zombie: goes off on contact.
          this._explode(g, hit.x + hit.nx * 0.15, hit.y + hit.ny * 0.15, hit.z + hit.nz * 0.15, 0, 0, 0, 0, 0, 0);
          return;
        }
        // Bounce: back to just in front of the surface, then reflect.
        g.x = hit.x + hit.nx * (GR_RADIUS + 0.01);
        g.y = hit.y + hit.ny * (GR_RADIUS + 0.01);
        g.z = hit.z + hit.nz * (GR_RADIUS + 0.01);
        const vn = g.vx * hit.nx + g.vy * hit.ny + g.vz * hit.nz;
        if (vn < 0) {
          const tx = g.vx - vn * hit.nx, ty = g.vy - vn * hit.ny, tz = g.vz - vn * hit.nz; // along the surface
          g.vx = tx * GR_FRICTION - vn * GR_BOUNCE * hit.nx;
          g.vy = ty * GR_FRICTION - vn * GR_BOUNCE * hit.ny;
          g.vz = tz * GR_FRICTION - vn * GR_BOUNCE * hit.nz;
          if (-vn > 1.5) this.audio.clink(Math.min(1, -vn / 12));
        }
        g.spin = 0.5;
        if (hit.ny > 0.7 && Math.hypot(g.vx, g.vy, g.vz) < 1.6) {
          g.vx = g.vy = g.vz = 0;
          g.resting = true;
        }
        g.mesh.position.set(g.x, g.y, g.z);
        return;
      }
    }
    g.x += sx; g.y += sy; g.z += sz;
    g.mesh.position.set(g.x, g.y, g.z);
    g.spin = Math.min(1, (g.spin || 1) + dt * 2);
    g.mesh.rotation.x += dt * 9 * g.spin;
    g.mesh.rotation.z += dt * 6 * g.spin;
  }

  _explode(g, x, y, z, hx, hy, hz, nx, ny, nz) {
    g.active = false;
    g.mesh.visible = false;
    this.explosions.ownerId = g.ownerId || 0; // who threw it, for team rules
    this.explosions.explode(x, y, z, hx, hy, hz, nx, ny, nz, 1, g.owner);
    this.explosions.ownerId = 0;
  }
}

// ===== js/weapon/Projectiles.js =====
const PROJ_POOL = 12;

/**
 * Rockets, launcher grenades and BFG balls. They fly (optionally with gravity),
 * stop at the first wall, enemy or opposing player, and explode through the
 * shared Explosions system. The other player's game flies an identical shot
 * (see the 'proj' message), the same way thrown grenades work.
 */
class Projectiles {
  constructor({ scene, collision, explosions, audio, targets }) {
    this.collision = collision;
    this.explosions = explosions;
    this.audio = audio;
    this.targets = targets;
    this._hit = { dist: 0, x: 0, y: 0, z: 0, nx: 0, ny: 0, nz: 0, box: null };

    const rocketMat = new THREE.MeshPhongMaterial({ color: 0x6a7a3a, shininess: 20 });
    const flameMat = new THREE.MeshBasicMaterial({ color: 0xffa040, transparent: true, blending: THREE.AdditiveBlending, depthWrite: false, fog: false });
    const grenadeMat = new THREE.MeshLambertMaterial({ color: 0x4b5a3a });
    const bfgMat = new THREE.MeshBasicMaterial({ color: 0x77ff99, fog: false });
    const haloMat = new THREE.MeshBasicMaterial({ color: 0x33ff66, transparent: true, opacity: 0.35, blending: THREE.AdditiveBlending, depthWrite: false, fog: false });
    this.list = [];
    for (let i = 0; i < PROJ_POOL; i++) {
      const group = new THREE.Group();
      const rocket = new THREE.Group();
      rocket.add(new THREE.Mesh(new THREE.BoxGeometry(0.07, 0.07, 0.38), rocketMat));
      const flame = new THREE.Mesh(new THREE.BoxGeometry(0.05, 0.05, 0.24), flameMat);
      flame.position.z = 0.3;
      rocket.add(flame);
      const grenade = new THREE.Mesh(new THREE.SphereGeometry(0.07, 8, 6), grenadeMat);
      const bfg = new THREE.Group();
      bfg.add(new THREE.Mesh(new THREE.SphereGeometry(0.2, 10, 8), bfgMat));
      bfg.add(new THREE.Mesh(new THREE.SphereGeometry(0.36, 10, 8), haloMat));
      group.add(rocket, grenade, bfg);
      group.visible = false;
      scene.add(group);
      this.list.push({ group, rocket, flame, grenade, bfg, active: false, x: 0, y: 0, z: 0, vx: 0, vy: 0, vz: 0, life: 0, p: null, owner: 'me', age: 0 });
    }
    this._next = 0;
  }

  /** Fire one: owner 'me' or 'other', p = spec.projectile, origin and unit direction. */
  launch(owner, p, x, y, z, dx, dy, dz, ownerId) {
    if (!p || ![x, y, z, dx, dy, dz].every((v) => typeof v === 'number' && isFinite(v))) return;
    const len = Math.hypot(dx, dy, dz) || 1;
    dx /= len; dy /= len; dz /= len;
    // Already touching a wall? Go off right here (the muzzle can be inside geometry).
    const h = this._hit;
    if (this.collision.raycast(x, y, z, dx, dy, dz, 0.6, h)) {
      this._boom(owner, p, h.x + h.nx * 0.25, h.y + h.ny * 0.25, h.z + h.nz * 0.25, h.x, h.y, h.z, h.nx, h.ny, h.nz, ownerId);
      return;
    }
    let s = this.list.find((q) => !q.active);
    if (!s) { s = this.list[this._next]; this._next = (this._next + 1) % this.list.length; }
    s.active = true;
    s.owner = owner;
    s.ownerId = ownerId || 0;
    s.p = p;
    s.x = x + dx * 0.5; s.y = y + dy * 0.5; s.z = z + dz * 0.5;
    s.vx = dx * p.speed; s.vy = dy * p.speed; s.vz = dz * p.speed;
    s.life = p.life;
    s.age = 0;
    s.rocket.visible = p.kind === 'rocket';
    s.grenade.visible = p.kind === 'grenade';
    s.bfg.visible = p.kind === 'bfg';
    s.group.visible = true;
    s.group.position.set(s.x, s.y, s.z);
    s.group.lookAt(s.x + dx, s.y + dy, s.z + dz);
  }

  update(dt) {
    const h = this._hit;
    for (const s of this.list) {
      if (!s.active) continue;
      s.life -= dt;
      s.age += dt;
      if (s.life <= 0) {
        this._end(s, s.x, s.y, s.z, s.x, s.y, s.z, 0, 0, 0);
        continue;
      }
      s.vy -= (s.p.gravity || 0) * dt;
      const sx = s.vx * dt, sy = s.vy * dt, sz = s.vz * dt;
      const len = Math.hypot(sx, sy, sz);
      if (len > 1e-6) {
        const dx = sx / len, dy = sy / len, dz = sz / len;
        const worldHit = this.collision.raycast(s.x, s.y, s.z, dx, dy, dz, len + 0.05, h);
        // An opposing player in the way counts too (they are not part of the collision world).
        if (s.owner === 'me' && this.targets && this.targets.active) {
          const d = this.targets.raycast(s.x, s.y, s.z, dx, dy, dz, worldHit ? h.dist : len + 0.05);
          if (d >= 0) {
            this._end(s, s.x + dx * d, s.y + dy * d, s.z + dz * d, s.x + dx * d, s.y + dy * d, s.z + dz * d, 0, 0, 0);
            continue;
          }
        }
        if (worldHit) {
          this._end(s, h.x + h.nx * 0.25, h.y + h.ny * 0.25, h.z + h.nz * 0.25, h.x, h.y, h.z, h.nx, h.ny, h.nz);
          continue;
        }
        s.group.lookAt(s.x + dx, s.y + dy, s.z + dz);
      }
      s.x += sx; s.y += sy; s.z += sz;
      s.group.position.set(s.x, s.y, s.z);
      if (s.p.kind === 'rocket') s.flame.scale.z = 0.7 + Math.random() * 0.8;
      else if (s.p.kind === 'bfg') s.bfg.scale.setScalar(1 + 0.12 * Math.sin(s.age * 30));
    }
  }

  _end(s, x, y, z, hx, hy, hz, nx, ny, nz) {
    s.active = false;
    s.group.visible = false;
    this._boom(s.owner, s.p, x, y, z, hx, hy, hz, nx, ny, nz, s.ownerId);
  }

  _boom(owner, p, x, y, z, hx, hy, hz, nx, ny, nz, ownerId) {
    this.explosions.ownerId = ownerId || 0; // who fired it, for team rules and credit
    this.explosions.explode(x, y, z, hx, hy, hz, nx, ny, nz, p.scale, owner);
    this.explosions.ownerId = 0;
  }
}


