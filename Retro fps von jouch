<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
  <title>Retro FPS - Milestone 9</title>
  <style>
html, body {
  margin: 0;
  height: 100%;
  overflow: hidden;
  overscroll-behavior: none;
  background: #0e0e0f;
  color: #b9b7ae;
  font-family: "Courier New", Courier, monospace;
  user-select: none;
  -webkit-user-select: none;
}

#game {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  /* The canvas may render at a reduced scale; keep pixels chunky. */
  image-rendering: pixelated;
  image-rendering: crisp-edges;
  touch-action: none;
}

#crosshair {
  --gap: 6px;
  --dot: 3px;
  position: fixed;
  left: 50%;
  top: 50%;
  width: 0;
  height: 0;
  pointer-events: none;
}

#crosshair i {
  position: absolute;
  left: calc(var(--dot) / -2);
  top: calc(var(--dot) / -2);
  width: var(--dot);
  height: var(--dot);
  border-radius: 50%;
  background: rgba(240, 240, 230, 0.95);
  box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.65);
}

#ammo-count.lowammo { color: #d24a3a; animation: lowblink 0.7s steps(2) infinite; }
@keyframes lowblink { 50% { opacity: 0.45; } }
#weapon-name.pop { animation: wpop 0.25s steps(4); }
@keyframes wpop { 0% { transform: translateX(14px); opacity: 0; } 100% { transform: none; opacity: 1; } }

#hud {
  position: fixed;
  right: 22px;
  bottom: 18px;
  text-align: right;
  pointer-events: none;
  text-shadow: 2px 2px 0 #000;
}

#weapon-name { font-size: 12px; letter-spacing: 3px; color: #8f8d85; }
#ammo { font-size: 14px; color: #8f8d85; }
#ammo-count { font-size: 40px; color: #d0a84a; }
#reload-bar {
  position: fixed;
  left: 50%;
  top: calc(50% + 34px);
  width: 150px;
  margin-left: -75px;
  text-align: center;
  font-size: 11px;
  letter-spacing: 3px;
  color: #e6e2d2;
  text-shadow: 1px 1px 0 #000;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.12s;
  z-index: 4;
}
#reload-bar.on { opacity: 1; }
#reload-bar i { display: block; height: 5px; margin-top: 4px; background: rgba(0, 0, 0, 0.55); border: 1px solid rgba(255, 255, 255, 0.5); }
#reload-bar b { display: block; height: 100%; width: 0; background: #d0a84a; }
#reload-label { min-height: 14px; font-size: 12px; letter-spacing: 2px; color: #c9c6ba; }

#fps {
  position: fixed;
  left: 8px;
  top: 6px;
  font-size: 12px;
  color: #8f8d85;
  pointer-events: none;
}

/* =====================================================================
   MENU / SETTINGS / SHOP / LOADOUT  (one shared design system)
   ===================================================================== */
:root {
  --bg: #121214;
  --panel: #1b1b1e;
  --raise: #242427;
  --raise-hi: #2e2e32;
  --line: #36363a;
  --text: #d8d5ca;
  --muted: #8a887f;
  --dim: #66645e;
  --accent: #d0a84a;
  --accent-hi: #e2bd5e;
  --ink: #1a1710;
  --gold: #e2c35a;
  --good: #8fae7a;
  --bad: #c8412e;
  --r: 3px;
}

#menu {
  position: fixed;
  inset: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  box-sizing: border-box;
  background: radial-gradient(ellipse at center, rgba(10, 10, 12, 0.62) 0%, rgba(6, 6, 7, 0.88) 100%);
}
#menu.hidden { display: none; }

.panel {
  position: relative;
  width: 380px;
  max-width: 100%;
  max-height: calc(100vh - 32px);
  max-height: calc(100dvh - 32px);
  overflow-y: auto;
  overscroll-behavior: contain;
  touch-action: pan-y;
  box-sizing: border-box;
  padding: 22px 22px 20px;
  color: var(--text);
  background: var(--panel);
  border: 1px solid var(--line);
  border-top: 3px solid var(--accent);
  border-radius: var(--r);
  box-shadow: 0 18px 50px rgba(0, 0, 0, 0.6);
  scrollbar-width: thin;
  scrollbar-color: var(--raise-hi) transparent;
}
.panel::-webkit-scrollbar { width: 8px; }
.panel::-webkit-scrollbar-thumb { background: var(--raise-hi); border-radius: 4px; }

/* ---- Headings ---- */
.brand { margin-bottom: 16px; }
h1 {
  margin: 0;
  font-size: 26px;
  line-height: 1;
  letter-spacing: 6px;
  color: var(--text);
}
.sub { margin: 6px 0 0; font-size: 11px; letter-spacing: 1px; color: var(--dim); }

/* Sticky header used by sub-pages: back button + title (+ action). */
.view-head {
  position: sticky;
  top: -22px;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 12px;
  margin: -22px -22px 14px;
  padding: 14px 22px;
  background: var(--panel);
  border-bottom: 1px solid var(--line);
}
.view-head h1 { flex: 1; font-size: 16px; letter-spacing: 4px; }
.view-lead { margin: 0 0 14px; font-size: 12px; line-height: 1.5; color: var(--muted); }
#shop-gold { margin: 0 0 4px; font-size: 18px; letter-spacing: 3px; color: var(--gold); }

/* ---- Buttons ---- */
#menu button {
  display: block;
  width: 100%;
  margin: 0;
  padding: 11px 12px;
  box-sizing: border-box;
  font: inherit;
  font-size: 13px;
  font-weight: bold;
  letter-spacing: 2px;
  color: var(--ink);
  background: var(--accent);
  border: 1px solid transparent;
  border-radius: var(--r);
  cursor: pointer;
  transition: background 0.12s, border-color 0.12s, color 0.12s;
}
#menu button:hover:not(:disabled) { background: var(--accent-hi); }
#menu button:active:not(:disabled) { transform: translateY(1px); }
#menu button:focus-visible,
#menu summary:focus-visible,
#menu input:focus-visible { outline: 2px solid var(--accent-hi); outline-offset: 2px; }
#menu button:disabled { opacity: 0.45; cursor: default; }

#menu button.secondary {
  color: var(--text);
  background: var(--raise);
  border-color: var(--line);
}
#menu button.secondary:hover:not(:disabled) { background: var(--raise-hi); }

#menu button.ghost {
  display: inline-block;
  width: auto;
  padding: 7px 12px;
  font-size: 12px;
  letter-spacing: 1px;
  color: var(--muted);
  background: transparent;
  border-color: var(--line);
}
#menu button.ghost:hover:not(:disabled) { color: var(--text); background: var(--raise); }

#menu #play { padding: 15px 12px; font-size: 16px; letter-spacing: 5px; }

.menu-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 8px; }
.menu-grid { margin-top: 8px; }
#menu .menu-grid button { font-size: 12px; padding: 10px 6px; }
#menu #play-full, #menu #open-tab, #menu #save-file { margin-top: 8px; font-size: 11px; letter-spacing: 1px; }
#menu #open-tab, #menu #save-file { display: none; }
#menu #open-tab.on, #menu #save-file.on { display: block; }
#menu #open-shop { display: none; }
#menu #move-buttons { grid-column: 1 / -1; }
body.zmode #menu #move-buttons { grid-column: auto; }
body.zmode #menu #open-shop { display: block; color: var(--gold); border-color: rgba(226, 195, 90, 0.45); }
@media (pointer: coarse) { #menu #play-full { display: none; } }

.hint { min-height: 16px; margin: 10px 0 0; font-size: 12px; line-height: 1.4; color: var(--accent); }
.hint:empty { display: none; }
.frame-note {
  margin: 10px 0 0;
  padding: 8px 10px;
  font-size: 11px;
  line-height: 1.5;
  color: #b9a47e;
  background: rgba(208, 168, 74, 0.08);
  border-left: 2px solid var(--accent);
}

/* ---- Segmented tabs ---- */
.tabs {
  display: flex;
  gap: 2px;
  margin: 0 0 14px;
  padding: 2px;
  background: var(--bg);
  border: 1px solid var(--line);
  border-radius: var(--r);
}
#menu .tabs button {
  flex: 1;
  padding: 8px 4px;
  font-size: 11px;
  letter-spacing: 1px;
  color: var(--muted);
  background: transparent;
  border-color: transparent;
}
#menu .tabs button:hover:not(:disabled):not(.on) { color: var(--text); background: var(--raise); }
#menu .tabs button.on { color: var(--ink); background: var(--accent); }
#menu .tabs button:disabled:not(.on) { opacity: 0.35; }
#menu .tabs button.on:disabled { opacity: 0.85; }
.tabs.small button { font-size: 10px; letter-spacing: 0; }
#lo-slots button { line-height: 1.35; }
#lo-slots button small { display: block; margin-top: 2px; font-size: 9px; letter-spacing: 0; font-weight: normal; opacity: 0.8; }

.mode-note { margin: -4px 0 14px; font-size: 11px; line-height: 1.5; color: var(--muted); }
.mode-note:empty { display: none; }

/* ---- Cards (multiplayer, controls) ---- */
.card, #net, #controls-help {
  margin-top: 14px;
  padding: 12px;
  background: var(--bg);
  border: 1px solid var(--line);
  border-radius: var(--r);
}
.card-title, #net-title {
  display: block;
  margin: 0 0 10px;
  font-size: 11px;
  letter-spacing: 3px;
  color: var(--muted);
  text-transform: uppercase;
}
.map-row > small {
  display: block;
  margin-bottom: 6px;
  font-size: 10px;
  letter-spacing: 2px;
  color: var(--dim);
}
.map-row em { font-style: normal; color: #a8957a; letter-spacing: 0; }
.map-row .tabs { background: var(--panel); }
#map-tabs { margin: 0 0 10px; }

.net-join { display: flex; gap: 8px; margin-top: 8px; }
.net-join input,
#net-url {
  min-width: 0;
  box-sizing: border-box;
  padding: 9px 10px;
  font: inherit;
  color: var(--text);
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: var(--r);
  user-select: text;
  -webkit-user-select: text;
}
.net-join input { flex: 1; font-size: 15px; letter-spacing: 4px; text-transform: uppercase; }
.net-join input::placeholder { letter-spacing: 2px; color: var(--dim); }
.net-join input:focus, #net-url:focus { border-color: var(--accent); outline: none; }
#menu .net-join button { width: auto; padding: 9px 18px; }
#net-url { width: 100%; margin: 8px 0; font-size: 12px; }
#menu #net-host { margin-top: 0; }
#net-status {
  margin-top: 10px;
  font-size: 12px;
  line-height: 1.5;
  color: var(--muted);
  user-select: text;
  -webkit-user-select: text;
}
#net-status b { font-size: 22px; letter-spacing: 5px; color: var(--accent); }
#net-status.ok { color: var(--good); }
#net-status.bad { color: var(--bad); }
#net-advanced { margin-top: 10px; font-size: 11px; color: var(--dim); }
#net-advanced summary, #controls-help summary { cursor: pointer; list-style: none; }
#net-advanced summary::-webkit-details-marker, #controls-help summary::-webkit-details-marker { display: none; }
#net-advanced summary::before, #controls-help summary::before { content: '\25B8  '; }
#net-advanced[open] summary::before, #controls-help[open] summary::before { content: '\25BE  '; }

#controls-help summary { font-size: 11px; letter-spacing: 3px; color: var(--muted); text-transform: uppercase; }
#controls-help[open] summary { margin-bottom: 10px; color: var(--text); }
.controls { list-style: none; margin: 0; padding: 0; font-size: 12px; color: var(--muted); line-height: 1.7; }
.controls li { display: flex; gap: 10px; }
.controls b { flex: 0 0 76px; color: var(--text); font-weight: normal; }
.controls-touch { display: none; }
@media (pointer: coarse) {
  .controls-key { display: none; }
  .controls-touch { display: block; }
}

/* ---- Settings rows ---- */
.setting { padding: 11px 0; border-bottom: 1px solid var(--raise); }
.setting:last-child { border-bottom: 0; }
#menu label {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  gap: 6px 10px;
  margin: 0;
  font-size: 13px;
  color: var(--text);
}
#menu label output { font-size: 12px; color: var(--accent); min-width: 44px; text-align: right; }
.setting-note { margin: 5px 0 0; font-size: 11px; line-height: 1.4; color: var(--dim); }
#menu #settings-list > button.secondary { margin-top: 2px; }
#settings-list > .setting-note { margin: 8px 0 4px; }

/* Slider */
#menu input[type="range"] {
  grid-column: 1 / 3;
  width: 100%;
  height: 22px;
  margin: 0;
  background: transparent;
  cursor: pointer;
  -webkit-appearance: none;
  appearance: none;
}
#menu input[type="range"]::-webkit-slider-runnable-track { height: 4px; background: var(--line); border-radius: 2px; }
#menu input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 16px; height: 16px; margin-top: -6px;
  background: var(--accent);
  border: 2px solid var(--panel);
  border-radius: 2px;
  box-shadow: 0 0 0 1px var(--accent);
}
#menu input[type="range"]::-moz-range-track { height: 4px; background: var(--line); border-radius: 2px; }
#menu input[type="range"]::-moz-range-thumb {
  width: 12px; height: 12px;
  background: var(--accent);
  border: 2px solid var(--panel);
  border-radius: 2px;
  box-shadow: 0 0 0 1px var(--accent);
}

/* Toggle switch */
#menu label.toggle { cursor: pointer; }
#menu label.toggle input {
  position: relative;
  width: 38px;
  height: 22px;
  margin: 0;
  background: var(--raise-hi);
  border: 1px solid var(--line);
  border-radius: 11px;
  cursor: pointer;
  transition: background 0.15s;
  -webkit-appearance: none;
  appearance: none;
}
#menu label.toggle input::after {
  content: '';
  position: absolute;
  top: 2px; left: 2px;
  width: 16px; height: 16px;
  background: var(--muted);
  border-radius: 50%;
  transition: transform 0.15s, background 0.15s;
}
#menu label.toggle input:checked { background: rgba(208, 168, 74, 0.25); border-color: var(--accent); }
#menu label.toggle input:checked::after { transform: translateX(16px); background: var(--accent); }

/* ---- Loadout + shop rows ---- */
.lo-item, .shop-item {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 3px 12px;
  align-items: center;
  margin-bottom: 6px;
  padding: 10px 12px;
  background: var(--raise);
  border: 1px solid var(--line);
  border-radius: var(--r);
}
.lo-item b, .shop-item b { font-size: 13px; color: var(--text); }
.lo-item small, .shop-item small { font-size: 11px; line-height: 1.4; color: var(--muted); }
.shop-item em { font-style: normal; font-size: 11px; color: #a8957a; }
#menu .lo-item button, #menu .shop-item button {
  grid-column: 2;
  grid-row: 1 / 4;
  width: auto;
  min-width: 96px;
  padding: 9px 10px;
  font-size: 11px;
  letter-spacing: 1px;
}
.lo-item button { grid-row: 1 / 3; }
#menu .lo-item button:disabled {
  opacity: 1;
  color: var(--accent);
  background: transparent;
  border-color: var(--accent);
}
#menu .shop-item button { color: #1a1608; background: var(--gold); }
#menu .shop-item button:hover:not(:disabled) { background: #f0d36a; }
#menu .shop-item button:disabled { color: var(--muted); background: var(--raise-hi); opacity: 0.8; }
.shop-head { margin: 16px 0 8px; font-size: 10px; letter-spacing: 3px; color: var(--dim); }
.shop-head:first-child { margin-top: 0; }

/* ---- RETRO SKIN: hard pixels, offset shadows, scanlines ---- */
:root { --r: 0; --panel: #1d1d1f; --bg: #141416; --raise: #2a2a2c; --raise-hi: #38383a; --line: #55554f; --accent: #a89c6a; --accent-hi: #c2b57c; }
#menu { font-family: 'Courier New', Courier, monospace; background: rgba(8, 8, 8, 0.82); }
#menu::after {
  content: ''; position: absolute; inset: 0; pointer-events: none;
  background: repeating-linear-gradient(to bottom, rgba(0,0,0,0) 0, rgba(0,0,0,0) 2px, rgba(0,0,0,0.22) 3px);
}
.panel {
  border: 2px solid #55554f; border-top-width: 2px; border-radius: 0;
  box-shadow: 0 0 0 2px #0a0a0a, 6px 6px 0 #0a0a0a;
}
.panel::-webkit-scrollbar-thumb { border-radius: 0; }
h1 { color: #c9c6ba; letter-spacing: 4px; text-shadow: 3px 3px 0 #000; text-transform: uppercase; }
.sub { text-transform: uppercase; letter-spacing: 2px; }
#menu button { border: 2px solid #0a0a0a; border-radius: 0; box-shadow: inset -2px -2px 0 rgba(0,0,0,0.35), inset 2px 2px 0 rgba(255,255,255,0.18); transition: none; text-transform: uppercase; }
#menu button:active:not(:disabled) { transform: translate(1px, 1px); box-shadow: inset 2px 2px 0 rgba(0,0,0,0.35); }
#menu button.secondary { background: #2a2a2c; border-color: #0a0a0a; box-shadow: inset -2px -2px 0 #111, inset 2px 2px 0 #444; }
#menu button.ghost { box-shadow: none; border: 2px solid #55554f; }
.tabs, .card, #net, #controls-help, .lo-item, .shop-item, .net-join input, #net-url { border-width: 2px; border-radius: 0; }
#menu .tabs button { box-shadow: none; border: 0; }
#menu .tabs button.on { box-shadow: inset 0 -3px 0 rgba(0,0,0,0.35); }
#menu input[type="range"]::-webkit-slider-runnable-track { height: 6px; border-radius: 0; background: #0a0a0a; border: 1px solid #55554f; }
#menu input[type="range"]::-webkit-slider-thumb { border-radius: 0; margin-top: -8px; width: 12px; height: 20px; box-shadow: none; border: 2px solid #0a0a0a; }
#menu input[type="range"]::-moz-range-track { border-radius: 0; height: 6px; background: #0a0a0a; }
#menu input[type="range"]::-moz-range-thumb { border-radius: 0; width: 8px; height: 16px; border: 2px solid #0a0a0a; box-shadow: none; }
#menu label.toggle input { border-radius: 0; width: 40px; height: 20px; background: #0a0a0a; border: 2px solid #55554f; }
#menu label.toggle input::after { border-radius: 0; width: 14px; height: 12px; top: 2px; left: 2px; }
#menu label.toggle input:checked { background: #2c2a1c; border-color: var(--accent); }
#menu label.toggle input:checked::after { transform: translateX(20px); }
.lo-item { box-shadow: 3px 3px 0 #0a0a0a; }
.lo-item .lo-desc { grid-column: 1; font-style: italic; color: var(--dim); }
.lo-item button { grid-row: 1 / 4; }
.frame-note { border-left-width: 4px; }

/* ---- Notice toast ---- */
#notice {
  position: fixed;
  left: 50%;
  top: 22%;
  z-index: 12;
  max-width: min(520px, calc(100vw - 32px));
  transform: translateX(-50%);
  padding: 12px 16px;
  box-sizing: border-box;
  font-size: 13px;
  line-height: 1.5;
  color: var(--text);
  background: rgba(18, 18, 20, 0.94);
  border: 1px solid var(--line);
  border-left: 3px solid var(--accent);
  border-radius: var(--r);
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.4s;
}
#notice.on { opacity: 1; }

@media (max-width: 420px), (max-height: 460px) {
  #menu { padding: 8px; }
  .panel { padding: 16px 16px 14px; max-height: calc(100vh - 16px); max-height: calc(100dvh - 16px); }
  .view-head { top: -16px; margin: -16px -16px 12px; padding: 12px 16px; }
  h1 { font-size: 22px; letter-spacing: 4px; }
  .brand { margin-bottom: 12px; }
}

/* ---- 5v5 team deathmatch ---- */
#tdmhud {
  position: fixed;
  top: calc(10px + env(safe-area-inset-top, 0px));
  left: 50%;
  transform: translateX(-50%);
  display: none;
  text-align: center;
  white-space: nowrap;
  text-shadow: 2px 2px 0 #000;
  pointer-events: none;
  z-index: 4;
}
#tdmhud.on { display: block; }
#tdmhud span { font-size: 20px; letter-spacing: 3px; padding: 0 12px; }
#tdm-a { color: #6fa0e0; }
#tdm-b { color: #e0795f; }
#tdm-time { font-size: 20px; letter-spacing: 3px; color: #e6e2d2; }
#tdm-you { margin-top: 2px; font-size: 11px; letter-spacing: 3px; }
#tdmover {
  position: fixed;
  inset: 0;
  display: none;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding-top: 12%;
  background: rgba(0, 0, 0, 0.45);
  text-shadow: 2px 2px 0 #000;
  pointer-events: none;
  z-index: 6;
}
#tdmover.on { display: flex; }
#tdmover h2 { margin: 0; font-size: 46px; letter-spacing: 6px; color: #e6e2d2; text-align: center; }
#tdmover p { margin: 8px 0 0; letter-spacing: 3px; color: #c9c6ba; text-align: center; }
#tdmboard {
  position: fixed;
  left: 50%;
  top: 22%;
  transform: translateX(-50%);
  display: none;
  min-width: 420px;
  max-width: calc(100vw - 24px);
  padding: 12px 16px;
  color: #e6e2d2;
  font-size: 13px;
  background: rgba(14, 14, 16, 0.82);
  border: 2px solid #55554f;
  pointer-events: none;
  z-index: 7;
}
#tdmboard.on { display: block; }
#tdmboard .tb-wrap { display: flex; gap: 24px; }
#tdmboard .tb-col { flex: 1; }
#tdmboard h3 { margin: 0 0 6px; font-size: 14px; letter-spacing: 3px; }
#tdmboard table { width: 100%; border-collapse: collapse; }
#tdmboard th { text-align: right; color: #77756e; font-weight: normal; font-size: 11px; }
#tdmboard td { padding: 1px 0; text-align: right; }
