          : health.cause === 'zombie' ? 'EATEN BY ZOMBIES'
          : health.cause === 'bot' ? 'KILLED BY A BOT' : 'YOU WERE BLOWN UP';
      }
    }
    if (health.dead && this.killedBy) this.deathCause.textContent = this.killedBy;
    if (health.dead) {
      const secs = Math.max(1, Math.ceil(health.deathTimer));
      if (secs !== this._deathSecs) {
        this._deathSecs = secs;
        this.deathTimer.textContent = 'Respawning in ' + secs;
