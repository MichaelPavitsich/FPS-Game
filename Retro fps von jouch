/** Medkit visuals: a white case with a red cross that bobs and spins while available. */
class Pickups {
  constructor(scene, health) {
    this.health = health;
    this.time = 0;
    const caseMat = new THREE.MeshLambertMaterial({ color: 0xd8d8d0 });
    const crossMat = new THREE.MeshBasicMaterial({ color: 0xcc2a2a, fog: false });
    this.items = health.pickups.map((k) => {
      const group = new THREE.Group();
      group.add(new THREE.Mesh(new THREE.BoxGeometry(0.42, 0.26, 0.30), caseMat));
      const crossA = new THREE.Mesh(new THREE.BoxGeometry(0.22, 0.02, 0.07), crossMat);
      const crossB = new THREE.Mesh(new THREE.BoxGeometry(0.07, 0.02, 0.22), crossMat);
      crossA.position.y = crossB.position.y = 0.135;
      group.add(crossA, crossB);
      group.position.set(k.x, k.y + 0.7, k.z);
      scene.add(group);
      return group;
    });
  }

  update(dt) {
    this.time += dt;
    for (let i = 0; i < this.items.length; i++) {
      const item = this.items[i];
      const active = this.health.pickups[i].active && this.health.pickups[i].enabled;
      item.visible = active;
      if (!active) continue;
      item.rotation.y = this.time * 1.5;
      item.position.y = this.health.pickups[i].y + 0.7 + Math.sin(this.time * 2 + i) * 0.06;
    }
  }
}

