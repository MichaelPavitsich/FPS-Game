  tube(steelMat, 0.020, 0.20, 0, 0.002, -0.32, 10);
  tube(steelMat, 0.008, 0.05, 0, 0.002, -0.44, 8);
  box(steelMat, 0.016, 0.020, 0.02, 0, 0.030, -0.40);
  box(steelMat, 0.004, 0.015, 0.004, 0, 0.0475, -0.40);
  box(steelMat, 0.046, 0.040, 0.14, 0, -0.014, -0.28);
  box(steelMat, 0.030, 0.095, 0.04, 0, -0.075, 0.02, -0.25);
  box(steelMat, 0.006, 0.010, 0.06, 0, -0.045, -0.03);
  box(steelMat, 0.012, 0.012, 0.22, 0.014, 0.012, 0.22);
  box(steelMat, 0.012, 0.012, 0.22, -0.014, 0.012, 0.22);
  box(steelMat, 0.030, 0.07, 0.01, 0, 0, 0.335);
  const handle = box(steelMat, 0.008, 0.012, 0.03, -0.026, 0.020, -0.12);

