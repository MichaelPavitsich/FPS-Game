    this.spawnPoints = [];
    /** Medkit spots of all rooms (data only; Health switches the ones in missing rooms off). */
    this.pickupSpots = ALL_PICKUPS;

    const textures = createTextures();
    this.materials = {};
    for (const name of Object.keys(textures)) {
      this.materials[name] = new THREE.MeshLambertMaterial({ map: textures[name] });
