const LMG_SIGHT = { y: 0.062, z: 0.0 };

/** Light machine gun: long barrel, carry handle, folded bipod, 100-round box magazine. */
function createLmg() {
  const { woodMat, steelMat, magMat } = createWeaponMaterials();
  const root = new THREE.Group();
  const { box, tube } = gunBuilders(root);

  box(steelMat, 0.052, 0.072, 0.30, 0, 0, -0.08); // receiver
  box(steelMat, 0.032, 0.012, 0.22, 0, 0.042, -0.08); // feed cover
