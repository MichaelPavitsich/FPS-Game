// ===== js/weapon/GunBuilder.js =====
/**
 * Parametric gun builder: one function makes rifles, SMGs, LMGs, snipers and
 * shotguns from a handful of options. gunGeom(o) returns the sight line (used
 * by the weapon specs to place the aim pose) without building anything.
 *
 * Options (all optional, metres): bodyH, bodyW, bodyL, rearZ, barrelL, barrelR,
 * rail, guardL, shroudR, shroudL, wood, double, muzzle ('brake'|'suppressor'|'none'),
 * scope, stock ('fixed'|'collapse'|'wire'|'bull'|'none'), mag ('stick'|'curved'|'box'|'drum'|'top'|'none'),
 * magZ, gripZ, foregrip, bipod, action ('auto'|'bolt'|'pump'|'lever'), tube (under-barrel magazine).
 */
function gunGeom(o) {
  const bh = o.bodyH || 0.058;
  const bl = o.bodyL || 0.26;
  const rear = o.rearZ === undefined ? 0.05 : o.rearZ;
  const top = bh / 2;
  const front = rear - bl;
  const bar = o.barrelL || 0.3;
  const mzBase = front - bar + 0.02;
  let mz = mzBase;
  if (o.muzzle === 'suppressor') mz -= 0.155;
  else if (o.muzzle !== 'none') mz -= 0.045;
  const sightY = o.scope ? top + 0.038 : top + 0.022;
  const sightZ = o.scope ? rear - 0.005 : (o.sightZ === undefined ? rear - 0.05 : o.sightZ);
  return { y: sightY, z: sightZ, top, rear, front, mzBase, mz };
}

function createGun(o) {
  const { woodMat, steelMat, magMat } = createWeaponMaterials();
  const root = new THREE.Group();
  const { box, tube } = gunBuilders(root);
  const g = gunGeom(o);
  const bh = o.bodyH || 0.058;
  const bw = o.bodyW || 0.040;
  const bl = o.bodyL || 0.26;
  const br = o.barrelR || 0.0095;
  const top = g.top;
  const rear = g.rear;
  const cz = rear - bl / 2;
  const by = o.barrelY === undefined ? top - 0.020 : o.barrelY;
  const furn = o.wood ? woodMat : steelMat;

  // Receiver, rail, barrel(s), handguard.
  box(steelMat, bw, bh, bl, 0, 0, cz);
  if (o.rail) box(steelMat, 0.018, 0.008, o.railL || bl, 0, top + 0.004, (rear - (o.railL || bl) / 2));
  const barLen = o.barrelL || 0.3;
  if (o.double) {
    tube(steelMat, 0.0125, barLen, 0.0135, by, g.front - barLen / 2 + 0.02, 12);
    tube(steelMat, 0.0125, barLen, -0.0135, by, g.front - barLen / 2 + 0.02, 12);
    box(steelMat, 0.008, 0.012, barLen, 0, by + 0.0125, g.front - barLen / 2 + 0.02); // rib
  } else {
    tube(steelMat, br, barLen, 0, by, g.front - barLen / 2 + 0.02, 10);
  }
  if (o.guardL) box(furn, bw * 1.1, bh * 0.72, o.guardL, 0, by - 0.006, g.front - o.guardL / 2 + 0.02);
  if (o.shroudR) tube(steelMat, o.shroudR, o.shroudL || 0.2, 0, by, g.front - (o.shroudL || 0.2) / 2 + 0.02, 10);
  if (o.tube) tube(steelMat, 0.0095, o.tube, 0, by - 0.030, g.front - o.tube / 2 + 0.02, 10); // under-barrel magazine tube
  if (o.muzzle === 'suppressor') tube(steelMat, 0.0165, 0.17, 0, by, g.mzBase - 0.07, 12);
  else if (o.muzzle !== 'none') tube(steelMat, br * 1.35, 0.05, 0, by, g.mzBase - 0.02, 10);

  // Sights, or a scope.
  if (o.scope) {
    tube(steelMat, 0.0185, 0.24, 0, g.y, rear - 0.12, 12);
    tube(steelMat, 0.026, 0.05, 0, g.y, rear - 0.245, 12);
    tube(steelMat, 0.022, 0.04, 0, g.y, rear + 0.015, 12);
    box(steelMat, 0.012, g.y - top, 0.02, 0, (g.y + top) / 2 - 0.01, rear - 0.07);
    box(steelMat, 0.012, g.y - top, 0.02, 0, (g.y + top) / 2 - 0.01, rear - 0.17);
  } else {
    box(steelMat, 0.005, 0.022, 0.012, 0.008, top + 0.011, g.z);
    box(steelMat, 0.005, 0.022, 0.012, -0.008, top + 0.011, g.z);
    const fz = g.mzBase + 0.05;
    box(steelMat, 0.012, 0.016, 0.02, 0, by + br + 0.006, fz);
    box(steelMat, 0.004, g.y - by, 0.006, 0, (g.y + by) / 2, fz);
  }

  // Grip, trigger guard, foregrip, bipod.
  if (o.grip !== false) box(furn, 0.032, 0.095, 0.042, 0, -bh / 2 - 0.04, o.gripZ === undefined ? rear - 0.055 : o.gripZ, -0.25);
  box(steelMat, 0.006, 0.010, 0.06, 0, -bh / 2 - 0.002, (o.gripZ === undefined ? rear - 0.055 : o.gripZ) - 0.05);
  if (o.foregrip) box(steelMat, 0.026, 0.07, 0.03, 0, -bh / 2 - 0.03, g.front - 0.07);
  if (o.bipod) {
    box(steelMat, 0.010, 0.010, 0.17, 0.016, by - 0.03, g.mzBase + 0.12);
    box(steelMat, 0.010, 0.010, 0.17, -0.016, by - 0.03, g.mzBase + 0.12);
  }

  // Stock.
  const st = o.stock || 'fixed';
  if (st === 'fixed') {
    box(furn, 0.036, 0.07, 0.30, 0, -0.012, rear + 0.17, 0.08);
    box(steelMat, 0.034, 0.09, 0.012, 0, -0.02, rear + 0.325, 0.08);
  } else if (st === 'collapse') {
    box(steelMat, 0.036, 0.05, 0.20, 0, -0.012, rear + 0.12);
    box(steelMat, 0.040, 0.075, 0.012, 0, -0.012, rear + 0.226);
  } else if (st === 'wire') {
    box(steelMat, 0.010, 0.010, 0.22, 0.014, 0.012, rear + 0.11);
    box(steelMat, 0.010, 0.010, 0.22, -0.014, 0.012, rear + 0.11);
    box(steelMat, 0.034, 0.07, 0.010, 0, 0, rear + 0.222);
  } else if (st === 'bull') {
    box(steelMat, 0.040, 0.075, 0.012, 0, -0.008, rear + 0.006);
  }

  // Magazine (a group, so the reload animation can move it).
  const mag = new THREE.Group();
  const mt = o.mag === undefined ? 'stick' : o.mag;
  const magZ = o.magZ === undefined ? rear - 0.14 : o.magZ;
  let magRestY = -bh / 2 + 0.01;
  let magSign = 1;
  if (mt === 'stick') {
    box(magMat, 0.028, 0.13, 0.042, 0, -0.065, 0, 0, mag);
  } else if (mt === 'curved') {
    for (let i = 0; i < 5; i++) box(magMat, 0.036, 0.07, 0.05, 0, -(0.035 + i * 0.063), -(i * i * 0.0045), i * 0.12, mag);
  } else if (mt === 'box') {
    box(magMat, 0.072, 0.11, 0.12, 0, -0.055, 0, 0, mag);
    box(steelMat, 0.074, 0.012, 0.122, 0, -0.112, 0, 0, mag);
  } else if (mt === 'drum') {
    box(magMat, 0.034, 0.05, 0.05, 0, -0.025, 0, 0, mag);
    const drum = new THREE.Mesh(new THREE.CylinderGeometry(0.065, 0.065, 0.07, 18), magMat);
    drum.rotation.z = Math.PI / 2;
    drum.position.set(0, -0.085, 0);
    mag.add(drum);
  } else if (mt === 'top') {
    magRestY = top + 0.012;
    magSign = -0.6;
    box(magMat, 0.05, 0.02, o.topL || 0.24, 0, 0, 0, 0, mag);
  }
  mag.position.set(0, magRestY, mt === 'top' ? cz : magZ);
  if (mt !== 'none') root.add(mag);

  // Charging handle / bolt / pump / lever.
  const action = o.action || 'auto';
  let handle = null;
  const handleZ0 = o.handleZ === undefined ? cz : o.handleZ;
  if (action === 'auto' || action === 'bolt') {
    handle = box(steelMat, action === 'bolt' ? 0.008 : 0.008, 0.012, action === 'bolt' ? 0.04 : 0.03, 0.026, top - 0.012, handleZ0);
  }
  let pump = null;
  if (action === 'pump') pump = box(woodMat, 0.046, 0.040, 0.16, 0, by - 0.012, g.front - 0.12);
  let lever = null;
  if (action === 'lever') {
    lever = new THREE.Group();
    lever.position.set(0, -bh / 2, rear - 0.07);
    box(steelMat, 0.008, 0.07, 0.008, 0, -0.035, 0.0, 0, lever);
    box(steelMat, 0.008, 0.008, 0.07, 0, -0.07, -0.03, 0, lever);
    root.add(lever);
  }

  const flash = createMuzzleFlash();
  flash.position.set(0, by, g.mz - 0.02);
  root.add(flash);

  let kickT = 0;
  let boltReload = 0;
  const model = {
    root, flash,
    applyReload(r) {
      if (mt !== 'none') {
        mag.position.y = magRestY + r.magY * magSign;
        mag.visible = r.magVisible;
      }
      if (action === 'auto' && handle) handle.position.z = handleZ0 + 0.045 * r.charge;
      boltReload = r.charge;
    },
  };
  if (action !== 'auto') {
    model.onShot = () => { kickT = action === 'bolt' ? 1.0 : action === 'lever' ? 0.5 : 0.45; };
    model.update = (dt) => {
      kickT = Math.max(0, kickT - dt);
      if (action === 'bolt') {
        const p = 1 - kickT / 1.0;
        const cyc = kickT > 0 ? Math.sin(Math.PI * Math.min(1, Math.max(0, (p - 0.25) / 0.5))) : 0;
        handle.position.z = handleZ0 + 0.06 * Math.max(cyc, boltReload);
      } else if (action === 'pump') {
        pump.position.z = g.front - 0.12 + (kickT > 0 ? 0.08 * Math.sin(Math.PI * (1 - kickT / 0.45)) : 0);
      } else if (action === 'lever') {
        lever.rotation.x = kickT > 0 ? 0.9 * Math.sin(Math.PI * (1 - kickT / 0.5)) : 0;
      }
    };
  }
  return model;
}

