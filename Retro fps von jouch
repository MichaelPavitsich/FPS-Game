// ===== js/weapon/ImpactEffects.js =====
const FLASH_POOL = 16;
const HOLE_POOL = 24;
const FLASH_LIFE = 0.09; // seconds
const FLASH_SIZE = 0.2; // metres

function radialTexture(stops) {
  const size = 32;
  const canvas = document.createElement('canvas');
  canvas.width = size;
  canvas.height = size;
  const ctx = canvas.getContext('2d');
  const gradient = ctx.createRadialGradient(16, 16, 0, 16, 16, 16);
  for (const [at, color] of stops) gradient.addColorStop(at, color);
  ctx.fillStyle = gradient;
  ctx.fillRect(0, 0, size, size);
  return new THREE.CanvasTexture(canvas);
}

/**
 * Bullet impacts: a short additive flash plus a small dark bullet hole.
 * Both come from fixed pools, so nothing is allocated while shooting.
 */
class ImpactEffects {
  constructor(scene) {
    const geometry = new THREE.PlaneGeometry(1, 1);

    const flashTexture = radialTexture([
      [0, 'rgba(255,250,225,1)'],
      [0.35, 'rgba(255,205,120,0.8)'],
      [1, 'rgba(255,140,40,0)'],
    ]);
    const holeTexture = radialTexture([
      [0, 'rgba(8,8,8,0.95)'],
      [0.55, 'rgba(14,14,14,0.8)'],
      [1, 'rgba(20,20,20,0)'],
    ]);

    this.flashes = [];
    for (let i = 0; i < FLASH_POOL; i++) {
      const material = new THREE.MeshBasicMaterial({
        map: flashTexture,
        transparent: true,
        blending: THREE.AdditiveBlending,
        depthWrite: false,
        fog: false,
      });
      const mesh = new THREE.Mesh(geometry, material);
      mesh.visible = false;
      scene.add(mesh);
      this.flashes.push({ mesh, life: 0 });
    }
    this._nextFlash = 0;

    const holeMaterial = new THREE.MeshBasicMaterial({
      map: holeTexture,
      transparent: true,
      depthWrite: false,
      polygonOffset: true,
      polygonOffsetFactor: -2,
      polygonOffsetUnits: -2,
    });
    this.holes = [];
    for (let i = 0; i < HOLE_POOL; i++) {
      const mesh = new THREE.Mesh(geometry, holeMaterial);
      mesh.scale.setScalar(0.07);
      mesh.visible = false;
      scene.add(mesh);
      this.holes.push(mesh);
    }
    this._nextHole = 0;

    // Larger scorch marks left by explosions.
    this.scorches = [];
    for (let i = 0; i < 6; i++) {
      const mesh = new THREE.Mesh(geometry, holeMaterial);
      mesh.scale.setScalar(1.1);
      mesh.visible = false;
      scene.add(mesh);
      this.scorches.push(mesh);
    }
    this._nextScorch = 0;
  }

  spawnScorch(x, y, z, nx, ny, nz) {
    const mark = this.scorches[this._nextScorch];
    this._nextScorch = (this._nextScorch + 1) % this.scorches.length;
    mark.position.set(x + nx * 0.004, y + ny * 0.004, z + nz * 0.004);
    mark.lookAt(x + nx, y + ny, z + nz);
    mark.rotateZ(Math.random() * Math.PI * 2);
    mark.visible = true;
  }

  /** Spawn at a hit point with the surface normal (unit length). */
  spawn(x, y, z, nx, ny, nz) {
    const flash = this.flashes[this._nextFlash];
    this._nextFlash = (this._nextFlash + 1) % FLASH_POOL;
    flash.life = FLASH_LIFE;
    flash.mesh.position.set(x + nx * 0.02, y + ny * 0.02, z + nz * 0.02);
    flash.mesh.lookAt(x + nx, y + ny, z + nz);
    flash.mesh.rotateZ(Math.random() * Math.PI * 2);
    flash.mesh.scale.setScalar(FLASH_SIZE);
    flash.mesh.material.opacity = 1;
    flash.mesh.visible = true;

    const hole = this.holes[this._nextHole];
    this._nextHole = (this._nextHole + 1) % HOLE_POOL;
    hole.position.set(x + nx * 0.006, y + ny * 0.006, z + nz * 0.006);
    hole.lookAt(x + nx, y + ny, z + nz);
    hole.rotateZ(Math.random() * Math.PI * 2);
    hole.visible = true;
  }

  update(dt) {
    for (let i = 0; i < this.flashes.length; i++) {
      const f = this.flashes[i];
      if (f.life <= 0) continue;
      f.life -= dt;
      if (f.life <= 0) {
        f.mesh.visible = false;
        continue;
      }
      const t = f.life / FLASH_LIFE; // 1 -> 0
      f.mesh.material.opacity = t;
      f.mesh.scale.setScalar(FLASH_SIZE * (0.45 + 0.55 * t));
    }
  }
}

