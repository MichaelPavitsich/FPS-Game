    const low = health.value > 0 && health.value <= 30 ? 0.18 + 0.1 * Math.sin(health.time * 5) : 0;
    const dmg = Math.round(Math.max(health.hurt * 0.9, low) * 20) / 20;
    if (dmg !== this._dmgOpacity) {
      this._dmgOpacity = dmg;
      this.damageEl.style.opacity = String(dmg);
