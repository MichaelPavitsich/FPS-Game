  // --- Building blocks -----------------------------------------------------

  /** A textured box from (x0,y0,z0) to (x1,y1,z1) that also blocks the player. */
  _solid(kind, x0, y0, z0, x1, y1, z1) {
    this._addBox(kind, x0, y0, z0, x1, y1, z1);
    const box = this.collision.addBox(x0, y0, z0, x1, y1, z1);
    this._room.boxes.push(box);
  }

  /** Decorative emissive box with no collision. */
  _lamp(x0, y0, z0, x1, y1, z1) {
    this._addBox('lamp', x0, y0, z0, x1, y1, z1);
  }

  _addBox(kind, x0, y0, z0, x1, y1, z1) {
    const w = x1 - x0;
    const h = y1 - y0;
    const d = z1 - z0;
    const mesh = new THREE.Mesh(this._boxGeometry(w, h, d, TILE[kind]), this.materials[kind]);
    mesh.position.set(x0 + w / 2, y0 + h / 2, z0 + d / 2);
    this._freeze(mesh);
    this._room.group.add(mesh);
  }

  _barrel(x, y, z) {
    if (!this._barrelGeometry) {
      this._barrelGeometry = new THREE.CylinderGeometry(0.4, 0.4, 1.1, 8, 1);
    }
    const mesh = new THREE.Mesh(this._barrelGeometry, this.materials.barrel);
    mesh.position.set(x, y + 0.55, z);
    this._freeze(mesh);
    this._room.group.add(mesh);
    const box = this.collision.addBox(x - 0.35, y, z - 0.35, x + 0.35, y + 1.1, z + 0.35);
    const barrel = { mesh, box, x, y, z, alive: true, fused: false, respawn: 0 };
    box.barrel = barrel;
    this._room.barrels.push(barrel);
  }

  _pointLight(color, intensity, distance, x, y, z) {
    const light = new THREE.PointLight(color, intensity, distance, 2);
    light.position.set(x, y, z);
    this._room.group.add(light);
  }

  /** Boxes of identical size and tiling share one geometry. */
  _boxGeometry(w, h, d, tile) {
    const key = w + '|' + h + '|' + d + '|' + tile;
    let geometry = this._geometries.get(key);
    if (!geometry) {
      geometry = createBoxGeometry(w, h, d, tile);
      this._geometries.set(key, geometry);
    }
    return geometry;
  }

  /** Static meshes never move: compute the matrix once and skip per-frame updates. */
  _freeze(mesh) {
    mesh.updateMatrix();
    mesh.matrixAutoUpdate = false;
  }
}

