/**
 * Synthesised weapon sounds (Web Audio): no audio files, nothing to download.
 * The AudioContext is created on the first click or key press, as browsers require.
 */
class WeaponAudio {
  constructor() {
    this.ctx = null;
    this.master = null;
    this.noise = null;
    this.volume = 1;
    const unlock = () => this.unlock();
    document.addEventListener('pointerdown', unlock, { passive: true });
    document.addEventListener('keydown', unlock, { passive: true });
  }

  setVolume(v) {
    this.volume = v;
    if (this.master) this.master.gain.value = 0.45 * v;
  }

  unlock() {
    if (!this.ctx) {
      const AC = window.AudioContext || window.webkitAudioContext;
      if (!AC) return;
      try {
        this.ctx = new AC();
      } catch (_) {
        return;
      }
      this.master = this.ctx.createGain();
      this.master.gain.value = 0.45 * this.volume;
      this.master.connect(this.ctx.destination);
      const length = this.ctx.sampleRate;
      this.noise = this.ctx.createBuffer(1, length, this.ctx.sampleRate);
      const data = this.noise.getChannelData(0);
      for (let i = 0; i < length; i++) data[i] = Math.random() * 2 - 1;
    }
    if (this.ctx.state === 'suspended') this.ctx.resume();
  }

  _ready() {
    return this.ctx && this.ctx.state === 'running';
  }

  /** A filtered noise burst with a sweeping cutoff and a decaying envelope. */
  _noise(t, dur, type, f0, f1, q, vol) {
    const ctx = this.ctx;
    const src = ctx.createBufferSource();
    src.buffer = this.noise;
    const filter = ctx.createBiquadFilter();
    filter.type = type;
    filter.Q.value = q;
    filter.frequency.setValueAtTime(f0, t);
    filter.frequency.exponentialRampToValueAtTime(f1, t + dur);
    const gain = ctx.createGain();
    gain.gain.setValueAtTime(0.0001, t);
    gain.gain.linearRampToValueAtTime(vol, t + 0.002);
    gain.gain.exponentialRampToValueAtTime(0.0001, t + dur);
    src.connect(filter);
    filter.connect(gain);
    gain.connect(this.master);
    src.start(t, Math.random() * 0.5, dur + 0.05);
  }

  _tone(t, dur, f0, f1, vol, type) {
    const ctx = this.ctx;
    const osc = ctx.createOscillator();
    osc.type = type || 'sine';
    osc.frequency.setValueAtTime(f0, t);
    osc.frequency.exponentialRampToValueAtTime(f1, t + dur);
    const gain = ctx.createGain();
    gain.gain.setValueAtTime(vol, t);
    gain.gain.exponentialRampToValueAtTime(0.0001, t + dur);
    osc.connect(gain);
    gain.connect(this.master);
    osc.start(t);
    osc.stop(t + dur + 0.02);
  }

  _click(t, freq, vol) {
    this._noise(t, 0.04, 'bandpass', freq, freq * 0.6, 4, vol);
    this._tone(t, 0.05, freq * 0.15, freq * 0.08, vol * 0.4, 'square');
  }

  /** `vol` (default 1) scales the whole sound, e.g. for other players' and enemies' shots. */
  shot(kind, vol) {
    if (!this._ready()) return;
    const t = this.ctx.currentTime;
    const k = SHOT_SOUNDS[kind] || SHOT_SOUNDS.ak;
    const v = vol === undefined ? 1 : vol;
    this._noise(t, k.dur, 'lowpass', k.f0, k.f1, 0.7, k.vol * v); // blast
    this._noise(t, 0.05, 'highpass', 2500, 2500, 0.5, k.crack * v); // crack
    this._tone(t, 0.14 + k.dur * 0.3, k.thump, k.tf, k.tv * v); // thump
    this._noise(t + 0.05, k.tail, 'lowpass', 800, 150, 0.5, 0.3 * v); // tail
  }

  /** Footstep; `vol` by stance. */
  step(vol) {
    if (!this._ready()) return;
    const t = this.ctx.currentTime;
    this._noise(t, 0.06, 'lowpass', 500 + Math.random() * 200, 150, 0.8, 0.3 * vol);
    this._tone(t, 0.05, 90, 55, 0.2 * vol);
  }

  /** Landing thud. */
  land(vol) {
    if (!this._ready()) return;
    const t = this.ctx.currentTime;
    this._noise(t, 0.12, 'lowpass', 400, 100, 0.8, 0.5 * vol);
    this._tone(t, 0.12, 70, 40, 0.45 * vol);
  }

  /** Medkit pickup: two rising blips. */
  pickup() {
    if (!this._ready()) return;
    const t = this.ctx.currentTime;
    this._tone(t, 0.1, 660, 700, 0.35);
    this._tone(t + 0.1, 0.16, 990, 1040, 0.35);
  }

  /** Hit confirmation tick; a lower double tick on a kill. */
  hitmarker(kill) {
    if (!this._ready()) return;
    const t = this.ctx.currentTime;
    this._click(t, 3200, 0.35);
    if (kill) this._click(t + 0.07, 1800, 0.45);
  }

  /** A grenade bouncing off something. */
  clink(vol) {
    if (!this._ready()) return;
    const t = this.ctx.currentTime;
    this._tone(t, 0.05, 1400 + Math.random() * 400, 900, 0.18 * vol);
    this._click(t, 3000, 0.2 * vol);
  }

  /** Wave start / game over. */
  horn() {
    if (!this._ready()) return;
    const t = this.ctx.currentTime;
    this._tone(t, 0.9, 196, 185, 0.35, 'sawtooth');
    this._tone(t, 0.9, 147, 140, 0.3, 'sawtooth');
  }

  /** A zombie moan; `vol` 0..1 by distance. */
  groan(vol) {
    if (!this._ready()) return;
    const t = this.ctx.currentTime;
    const f = 80 + Math.random() * 40;
    this._tone(t, 0.8, f, f * 0.7, 0.35 * vol, 'sawtooth');
    this._noise(t, 0.7, 'lowpass', 500, 200, 1, 0.25 * vol);
  }

  /** Something heavy hitting the base. */
  thud(vol) {
    if (!this._ready()) return;
    const t = this.ctx.currentTime;
    this._tone(t, 0.15, 120, 50, 0.6 * vol);
    this._noise(t, 0.08, 'bandpass', 900, 500, 2, 0.4 * vol);
  }

  /** Being hit: a short dull thump. */
  hurt() {
    if (!this._ready()) return;
    this._tone(this.ctx.currentTime, 0.12, 140, 70, 0.5);
  }

  /** One shell going into the shotgun. */
  shell() {
    if (!this._ready()) return;
    this._click(this.ctx.currentTime, 2600, 0.6);
  }

  /** Reload sounds timed to the reload animation (fractions of `duration`). */
  reload(duration, empty, kind) {
    if (!this._ready()) return;
    const t = this.ctx.currentTime;
    const d = duration;
    if (kind === 'revolver') {
      this._click(t + 0.14 * d, 1800, 0.8); // cylinder latch
      for (const f of [0.30, 0.33, 0.37]) this._click(t + f * d, 3000, 0.4); // shells drop
      for (const f of [0.55, 0.60, 0.65, 0.70]) this._click(t + f * d, 2400, 0.5); // rounds in
      this._click(t + 0.86 * d, 1500, 1.0); // cylinder closes
      this._tone(t + 0.86 * d, 0.08, 200, 80, 0.5);
      return;
    }
    this._click(t + 0.16 * d, 2200, 0.7); // magazine release
    this._noise(t + 0.34 * d, 0.12, 'lowpass', 900, 300, 1, 0.5); // mag slides out
    this._click(t + 0.70 * d, 1500, 0.9); // new mag seats
    this._tone(t + 0.70 * d, 0.08, 220, 90, 0.5);
    if (empty) {
      this._click(t + 0.80 * d, 1200, 0.9); // bolt back
      this._click(t + 0.88 * d, 1800, 1.0); // bolt forward
      this._tone(t + 0.88 * d, 0.1, 180, 60, 0.6);
    }
  }

  /** Grenade explosion. `vol` (0..1) is the distance attenuation. */
  explosion(vol) {
    if (!this._ready()) return;
    const t = this.ctx.currentTime;
    this._noise(t, 1.1, 'lowpass', 3000, 60, 0.7, 1.6 * vol);
    this._tone(t, 0.6, 80, 22, 1.4 * vol);
    this._noise(t, 0.08, 'highpass', 1200, 1200, 0.5, 1.0 * vol);
    this._noise(t + 0.15, 1.2, 'lowpass', 500, 80, 0.5, 0.5 * vol);
  }

  /** Pin pull and throw. */
  whoosh() {
    if (!this._ready()) return;
    const t = this.ctx.currentTime;
    this._click(t, 2500, 0.5);
    this._noise(t + 0.12, 0.28, 'bandpass', 300, 1400, 1.2, 0.25);
  }
}

// ===== js/weapon/WeaponSpecs.js =====
const specSmooth = (t) => t * t * (3 - 2 * t);
/** 0 before a, 1 after b, smooth in between. */
const specEase = (a, b, t) => specSmooth(Math.max(0, Math.min(1, (t - a) / (b - a))));

/** AK-47 reload: tilt, magazine out, new magazine in, bolt rack if empty. */
function ak47ReloadPose(t, empty, out) {
  const tiltEnd = empty ? 0.92 : 0.82;
  const tilt = specEase(0, 0.15, t) - specEase(tiltEnd, 1, t);
  out.x = -0.03 * tilt;
  out.y = -0.04 * tilt;
  out.z = 0;
  out.rx = 0.1 * tilt;
  out.ry = 0.25 * tilt;
  out.rz = 0.5 * tilt;

  const magOut = specEase(0.18, 0.34, t);
  const magIn = specEase(0.52, 0.72, t);
  out.magY = t < 0.5 ? -0.3 * magOut : -0.3 * (1 - magIn);
  out.magVisible = t < 0.34 || t >= 0.52;
  out.charge = empty ? specEase(0.78, 0.86, t) - specEase(0.86, 0.92, t) : 0;
}

/** Revolver reload: cylinder swings out, muzzle up to dump the shells, rounds in, close. */
function revolverReloadPose(t, empty, out) {
  const tilt = specEase(0, 0.14, t) - specEase(0.88, 1, t);
  const dump = specEase(0.2, 0.3, t) - specEase(0.42, 0.52, t);
  out.x = -0.02 * tilt;
  out.y = -0.03 * tilt;
  out.z = 0.02 * tilt;
  out.rx = 0.1 * tilt + 0.55 * dump;
  out.ry = 0.15 * tilt;
  out.rz = 0.35 * tilt;
  out.magY = specEase(0.12, 0.2, t) - specEase(0.8, 0.88, t); // swing-out amount
  out.magVisible = true;
  out.charge = specEase(0.58, 0.74, t); // cylinder spin while loading
}

/** Shotgun: shells go in one at a time; `phase` is the progress of the current shell. */
function shotgunReloadPose(phase, empty, out) {
  const dip = Math.sin(Math.PI * phase);
  out.x = 0; out.y = -0.03 * dip; out.z = 0;
  out.rx = 0.12; out.ry = 0.1; out.rz = 0.3 + 0.1 * dip;
  out.magY = 0; out.magVisible = true; out.charge = 0;
}

/** Hunting rifle: bolt up and back, rounds in, bolt closed. */
function rifleReloadPose(t, empty, out) {
  const tilt = specEase(0, 0.15, t) - specEase(0.88, 1, t);
  out.x = -0.02 * tilt; out.y = -0.03 * tilt; out.z = 0;
  out.rx = 0.12 * tilt; out.ry = 0.15 * tilt; out.rz = 0.3 * tilt;
  out.magY = 0; out.magVisible = true;
  out.charge = specEase(0.15, 0.25, t) - specEase(0.7, 0.8, t);
}

