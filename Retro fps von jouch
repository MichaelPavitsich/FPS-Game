/** Spec for a gun made by createGun(g): model, sight-aligned aim pose and sensible defaults; `s` overrides. */
function gunSpec(g, s) {
  const sight = gunGeom(g);
  const scoped = !!g.scope;
  return Object.assign({
    gun: g,
    createModel: () => createGun(g),
    auto: true,
    scope: scoped,
    hip: { x: 0.15, y: -0.18, z: -0.12, ry: 0.05 },
    aimPose: { x: 0, y: -sight.y, z: scoped ? -0.08 - sight.z : AIM_Z - sight.z, ry: 0 },
    sprintPose: SPRINT_STD,
    reloadPose: ak47ReloadPose,
    flashTime: 0.04,
    flashScale: 1,
    barrelChance: 0.08,
  }, s);
}

